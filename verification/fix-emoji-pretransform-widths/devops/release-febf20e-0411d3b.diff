+import {
+  describe, expect, it, vi,
+} from 'vitest';
+
+import { isEmojiElement } from '../common';
+import flattenNodeText from '../flattenNodeText';
+import getInitialValue from '../getInitialValue';
+
+import type { Element } from 'slate';
+
+import markdown from '~/utils/markdown';
+
+vi.mock('~/env.mjs', () => ({ env: {} }));
+
+const loaded = (text: string) => getInitialValue(text, markdown.interactive.parseEmoji, false);
+
+describe('editor initial value built from a stored message', () => {
+  it.each([
+    '\\🙂 **a**',
+    'a \\🙂',
+    '\\*a\\*',
+    'a :ok🙂 b',
+    'a \\🙂ok: b',
+  ])('loads %j with its text unchanged', (text) => {
+    expect(flattenNodeText(loaded(text))).toBe(text);
+  });
+
+  it.each([
+    ['a🙂 b c', ['a', '[:slight_smile:]', ' b c']],
+    ['\\*🙂 b', ['\\*', '[:slight_smile:]', ' b']],
+    ['a :ok🙂 🙂 b', ['a :ok🙂 ', '[:slight_smile:]', ' b']],
+    ['a \\🙂ok: 🙂 b', ['a \\🙂ok: ', '[:slight_smile:]', ' b']],
+  ] as const)('loads the text on each side of the emoji in %j into its own text node', (text, children) => {
+    const [first] = loaded(text) as Element[];
+    expect(first.children
+      .map((child) => (isEmojiElement(child) ? `[${child.ast.name as string}]` : (child as { text: string }).text)))
+      .toEqual(children);
+  });
+});
diff --git a/src/components/SlateEditor/utils/__tests__/withNormalizeNode.emoji-keeps-line-text.test.tsx b/src/components/SlateEditor/utils/__tests__/withNormalizeNode.emoji-keeps-line-text.test.tsx
