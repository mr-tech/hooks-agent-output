+export interface SurrogateSourceOffsets {
+  at: (offset: number) => number;
+  splitsName: (offset: number) => boolean;
+}
+
+export function surrogateSourceOffsets(surrogates: string): SurrogateSourceOffsets {
+  const names: Array<{ start: number, end: number, sourceEnd: number }> = [];
+  let growth = 0;
+  for (const match of surrogates.matchAll(replacer)) {
+    const start = match.index + growth;
+    const sourceEnd = match.index + match[0].length;
+    growth += convertSurrogateToName(match[0]).length - match[0].length;
+    names.push({ start, end: sourceEnd + growth, sourceEnd });
+  }
+
+  return {
+    at(offset) {
+      let shift = 0;
+      for (const { start, end, sourceEnd } of names) {
+        if (offset <= start) break;
+        if (offset < end) return sourceEnd;
+        shift = end - sourceEnd;
+      }
+      return offset - shift;
+    },
+    splitsName(offset) {
+      return names.some(({ start, end }) => start < offset && offset < end);
+    },
+  };
+}
