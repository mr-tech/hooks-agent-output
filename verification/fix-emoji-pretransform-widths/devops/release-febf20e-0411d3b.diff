index 0000000..97fe3a6
--- /dev/null
+++ b/src/components/SlateEditor/utils/__tests__/withNormalizeNode.emoji-keeps-line-text.test.tsx
@@ -0,0 +1,66 @@
+import { createEditor, Editor, Transforms } from 'slate';
+import { withHistory } from 'slate-history';
+import { withReact } from 'slate-react';
+import {
+  describe, expect, it, vi,
+} from 'vitest';
+
+import { isEmojiElement } from '../common';
+import { withEmojis, withNormalizeNode } from '..';
+
+import type { Descendant, Element } from 'slate';
+
+import markdown from '~/utils/markdown';
+
+vi.mock('~/env.mjs', () => ({ env: {} }));
+
+const line = (type: string, lang: string, startCodeBlock: boolean, text: string) => ({
+  type, lang, startCodeBlock, empty: !text, children: [{ type: 'span', text }],
+}) as unknown as Descendant;
+
+const typedInto = (lines: Descendant[], at: number, text: string) => {
+  const editor = withNormalizeNode(
+    withEmojis(withHistory(withReact(createEditor()))),
+    false,
+    markdown.interactive.parseEmoji,
+  );
+  editor.children = lines;
+  Transforms.select(editor, Editor.end(editor, [at]));
+  Transforms.insertText(editor, text);
+  return (editor.children[at] as Element).children
+    .map((child) => (isEmojiElement(child) ? `[${child.ast.name as string}]` : (child as { text: string }).text));
+};
+
+describe('editor normalizer turning an emoji in a typed or pasted line into an emoji element', () => {
+  it('keeps every character after the emoji in a plain line', () => {
+    expect(typedInto([line('div', '', false, '')], 0, 'x🙂 abcdefghijklmnopq'))
+      .toEqual(['x', '[:slight_smile:]', ' abcdefghijklmnopq']);
+  });
+
+  it('keeps an escaped asterisk before the emoji and every character after it', () => {
+    expect(typedInto([line('div', '', false, '')], 0, '\\*🙂abc'))
+      .toEqual(['\\*', '[:slight_smile:]', 'abc']);
+  });
+
+  it('keeps an escaped emoji as text and turns the emoji after it into an element', () => {
+    expect(typedInto([line('div', '', false, '')], 0, '\\🙂🙂 abc'))
+      .toEqual(['\\🙂', '[:slight_smile:]', ' abc']);
+  });
+
+  it.each([
+    ['a :ok🙂 🙂 b', ['a :ok🙂 ', '[:slight_smile:]', ' b']],
+    ['a \\🙂ok: 🙂 b', ['a \\🙂ok: ', '[:slight_smile:]', ' b']],
+  ] as const)('keeps %j as typed where a name would run into the emoji, and turns the next emoji into an element', (text, children) => {
+    expect(typedInto([line('div', '', false, '')], 0, text)).toEqual(children);
+  });
+
+  it('keeps every character after the emoji in a fenced code line', () => {
+    const lines = [
+      line('div', '', false, '```js'),
+      line('codeBlock', 'js', true, ''),
+      line('div', '', true, '```'),
+    ];
+    expect(typedInto(lines, 1, 'x = "🙂" + 1;'))
+      .toEqual(['x = "', '[:slight_smile:]', '" + 1;']);
+  });
+});
