+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import Providers from '../Providers';
+
+const request = vi.hoisted(() => ({ headers: {} as Record<string, string> }));
+
+vi.mock('next/headers', () => ({
+  headers: async () => new Headers(request.headers),
+}));
+vi.mock('~/env.mjs', async () => (await import('~/providers/MessageProvider/__tests__/helpers/messageProviderDeps')).ENV_MOCK);
+
+const fetchSpy = vi.fn<typeof fetch>();
+
+beforeEach(() => {
+  request.headers = {};
+  fetchSpy.mockReset();
+  fetchSpy.mockResolvedValue(new Response('{}', { status: 200 }));
+  vi.stubGlobal('fetch', fetchSpy);
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+function requestedUrls() {
+  return fetchSpy.mock.calls.map(([input]) => String(input));
+}
+
+describe('the message-page providers given a client-sent x-query-params header', () => {
+  it.each([
+    ['a truncated percent escape', '%E0%A4%A'],
+    ['a bare percent sign', '100%'],
+  ])('render for %s', async (_, value) => {
+    request.headers = { 'x-query-params': value };
+
+    await expect(Providers({ children: 'page' })).resolves.toBeTruthy();
+  });
+
+  it.each([
+    ['a plain code', 'code%3Dabc'],
+    ['a code holding a path', 'code%3D..%252Fauth%252Fsession'],
+  ])('make no request from %s', async (_, value) => {
+    request.headers = { 'x-query-params': value };
+
+    await Providers({ children: 'page' });
+
+    expect(requestedUrls()).toEqual([]);
+  });
+});
