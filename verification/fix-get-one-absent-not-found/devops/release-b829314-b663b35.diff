+function mountEditPageWithHeader(id: string) {
+  mocks.pathname = `/message/m/${id}/edit`;
+  return mountDom(
+    <TrpcProvider>
+      <MessageProvider>
+        <Header />
+        <EditPage />
+      </MessageProvider>
+    </TrpcProvider>,
+  );
+}
+
+function editorControlsIn(container: HTMLElement) {
+  return {
+    nameField: container.querySelector('input[aria-label="Message Name"]') !== null,
+    menus: Array.from(container.querySelectorAll('button'))
+      .map((button) => button.textContent)
+      .filter((text) => ['File', 'Edit', 'View', 'Help'].includes(text ?? '')),
+    send: Array.from(container.querySelectorAll('a')).some((a) => /\/send$/.test(a.getAttribute('href') ?? '')),
+  };
+}
+
+function siteNavigationIn(container: HTMLElement) {
+  return {
+    themeToggle: container.querySelector('[aria-label="toggle site theme"]') !== null,
+    userMenu: container.querySelector('[aria-label="user menu"]') !== null,
+  };
+}
+
+describe('the edit page\'s header', () => {
+  it('shows the message name field, the File, Edit, View and Help menus and Send for a message the user can load', async () => {
+    const container = mountEditPageWithHeader(OWN_ID);
+
+    await vi.waitFor(() => {
+      expect(container.querySelector('[data-editor]')).not.toBeNull();
+      expect(editorControlsIn(container).nameField).toBe(true);
+    });
+
+    expect(editorControlsIn(container)).toEqual({ nameField: true, menus: ['File', 'Edit', 'View', 'Help'], send: true });
+    expect(siteNavigationIn(container)).toEqual({ themeToggle: true, userMenu: true });
+  });
+
+  it('keeps only the site navigation beside the not-found notice for a message number the user cannot load', async () => {
+    const container = mountEditPageWithHeader(ABSENT_ID);
+
+    await vi.waitFor(() => { expect(container.textContent).toContain(NOT_FOUND_TEXT); });
+
+    expect(editorControlsIn(container)).toEqual({ nameField: false, menus: [], send: false });
+    expect(siteNavigationIn(container)).toEqual({ themeToggle: true, userMenu: true });
+  });
+});
