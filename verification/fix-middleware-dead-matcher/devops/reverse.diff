@@ -0,0 +1,49 @@
+import { readdirSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { unstable_doesMiddlewareMatch as doesMiddlewareMatch } from 'next/experimental/testing/server';
+import { describe, expect, it } from 'vitest';
+
+import { config } from '../proxy';
+
+function routeFiles(dir: string, isRoute: (segments: string[]) => boolean) {
+  return readdirSync(resolve(process.cwd(), dir), { recursive: true, encoding: 'utf8' })
+    .map((file) => file.split(/[\\/]/))
+    .filter((segments) => !segments.includes('__tests__') && isRoute(segments));
+}
+
+function urlOf(segments: string[]) {
+  const path = segments
+    .filter((segment) => !/^\(.*\)$/.test(segment) && !segment.startsWith('@'))
+    .map((segment) => segment.replace(/^\[{1,2}(\.\.\.)?\w+\]{1,2}$/, '1'));
+  return `/${path.join('/')}`;
+}
+
+const appPages = routeFiles('src/app', (segments) => (
+  /^(page|route)\.[jt]sx?$/.test(segments[segments.length - 1] ?? '')
+  && !segments.some((segment) => segment.startsWith('_'))
+)).map((segments) => urlOf(segments.slice(0, -1)));
+
+const pagesRoutes = routeFiles('src/pages', (segments) => (
+  /\.[jt]sx?$/.test(segments[segments.length - 1] ?? '')
+  && !segments[segments.length - 1]?.endsWith('.d.ts')
+  && !/^_(app|document|error)\./.test(segments[segments.length - 1] ?? '')
+)).map((segments) => {
+  const last = (segments[segments.length - 1] ?? '').replace(/\.[jt]sx?$/, '');
+  return urlOf(last === 'index' ? segments.slice(0, -1) : [...segments.slice(0, -1), last]);
+});
+
+const siteUrls = [...appPages, ...pagesRoutes].sort();
+
+describe('the site route inventory the proxy matcher is checked against', () => {
+  it('holds the message editor and an API route', () => {
+    expect(siteUrls).toEqual(expect.arrayContaining(['/message', '/message/m/1/edit', '/api/v1/guilds/1/messages']));
+  });
+});
+
+describe('every proxy matcher entry', () => {
+  it.each(config.matcher)('%s matches at least one of the site\'s routes', (entry) => {
+    const reached = siteUrls.filter((url) => doesMiddlewareMatch({ config: { matcher: [entry] }, url: `http://localhost${url}` }));
+
+    expect(reached).not.toEqual([]);
+  });
+});
