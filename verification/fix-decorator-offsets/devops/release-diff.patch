+import { createEditor, Text } from 'slate';
+import {
+  describe, expect, it, vi,
+} from 'vitest';
+
+import decorator from '../decorator';
+
+import type { Descendant, Range } from 'slate';
+
+import markdown from '~/utils/markdown';
+
+vi.mock('~/env.mjs', () => ({ env: {} }));
+
+const PARSERS = {
+  content: [markdown.interactive.parseContent, false],
+  title: [markdown.interactive.parseEmbedTitle, true],
+  field: [markdown.interactive.parseEmbedField, true],
+} as const;
+
+const PLAIN_LINE = { type: 'div', lang: '', startCodeBlock: false };
+
+const rangesOf = (text: string, parser: keyof typeof PARSERS = 'content', line = PLAIN_LINE) => {
+  const [parse, isEmbed] = PARSERS[parser];
+  const editor = createEditor();
+  const span = { type: 'span', text } as unknown as Text;
+  editor.children = [{ ...line, children: [span] } as unknown as Descendant];
+  return { span, ranges: decorator(editor, true, isEmbed, parse)([span, [0, 0]]) };
+};
+
+const labelled = (span: Text, ranges: Range[]) => Text.decorations(span, ranges)
+  .map(({ leaf }) => {
+    const { syntax: isSyntax, classNames } = leaf as Text & {
+      syntax?: boolean, classNames?: string[],
+    };
+    const label = [isSyntax ? 'S' : '', ...[...(classNames ?? [])].sort()].filter(Boolean).join('+');
+    return `${JSON.stringify(leaf.text)}:${label || '-'}`;
+  })
+  .join(' ');
+
+const rendered = (text: string, parser: keyof typeof PARSERS, line = PLAIN_LINE) => {
+  const { span, ranges } = rangesOf(text, parser, line);
+  return labelled(span, ranges);
+};
+
+const decorate = (text: string) => rangesOf(text).ranges
+  .map((range) => ({
+    from: range.anchor.offset,
+    to: range.focus.offset,
+    syntax: range.syntax,
+    classNames: [...range.classNames].sort(),
+  }));
+
+const syntax = (from: number, to: number, classNames: string[] = []) => ({
+  from, to, syntax: true, classNames,
+});
+const styled = (from: number, to: number, classNames: string[]) => ({
+  from, to, syntax: false, classNames,
+});
+
+describe('editor markdown decorator emphasis ranges', () => {
+  it('marks the delimiters of bold text as syntax and the inside as bold', () => {
+    expect(decorate('**ab**')).toEqual([
+      syntax(0, 2),
+      styled(2, 4, ['strongText']),
+      syntax(4, 6),
+    ]);
+  });
+
+  it('marks the delimiters of italic text as syntax and the inside as italic', () => {
+    expect(decorate('*ab*')).toEqual([
+      syntax(0, 1),
+      styled(1, 3, ['emText']),
+      syntax(3, 4),
+    ]);
+  });
+
+  it('colours bold and italic runs side by side independently', () => {
+    expect(decorate('**a** *b*')).toEqual([
+      syntax(0, 2),
+      styled(2, 3, ['strongText']),
+      syntax(3, 5),
+      syntax(6, 7),
+      styled(7, 8, ['emText']),
+      syntax(8, 9),
+    ]);
+  });
+
+  it('colours italic text nested inside bold text and leaves the text after it plain', () => {
+    expect(decorate('**a *b* c** d')).toEqual([
+      syntax(0, 2),
+      styled(2, 9, ['strongText']),
+      syntax(4, 5, ['strongText']),
+      styled(5, 6, ['emText', 'strongText']),
+      syntax(6, 7),
+      syntax(9, 11),
+    ]);
+  });
+
+  it('keeps the syntax ranges of bold italic text inside its three-asterisk delimiters', () => {
+    expect(decorate('***ab***')).toEqual([
+      syntax(0, 3),
+      styled(3, 5, ['emText', 'strongText']),
+      syntax(5, 8),
+    ]);
+  });
+
+  it('leaves the text after bold italic text uncoloured', () => {
+    expect(decorate('***ab*** cd')).toEqual([
+      syntax(0, 3),
+      styled(3, 5, ['emText', 'strongText']),
+      syntax(5, 8),
+    ]);
+  });
+
+  it.each([
+    ['bold opening an italic run', '***a** b*', [
+      syntax(0, 3),
+      styled(3, 8, ['emText']),
+      styled(3, 4, ['emText', 'strongText']),
+      syntax(4, 6),
+      syntax(8, 9),
+    ]],
+    ['italic opening a bold run', '***a* b**', [
+      syntax(0, 3),
+      styled(3, 7, ['strongText']),
+      styled(3, 4, ['emText', 'strongText']),
+      syntax(4, 5),
+      syntax(7, 9),
+    ]],
+    ['bold closing an italic run', '*a **b***', [
+      syntax(0, 1),
+      styled(1, 6, ['emText']),
+      syntax(3, 5, ['emText']),
+      styled(5, 6, ['emText', 'strongText']),
+      syntax(6, 9),
+    ]],
+    ['strikethrough inside bold italic', '***~~a~~***', [
+      syntax(0, 5),
+      styled(5, 6, ['emText', 'sText', 'strongText']),
+      syntax(6, 11),
+    ]],
+    ['italic inside underline', '__*a*__', [
+      syntax(0, 3),
+      styled(3, 4, ['emText', 'uText']),
+      syntax(4, 7),
+    ]],
+    ['bold inside a spoiler', '||**a**||', [
+      syntax(0, 4),
+      styled(4, 5, ['spoilerText', 'strongText']),
+      syntax(5, 9),
+    ]],
+  ])('keeps shared delimiters inside the text for %s', (_name, text, ranges) => {
+    expect(decorate(text)).toEqual(ranges);
+  });
+
+  it.each([
+    ['as the only content of bold text', '**[a](https://x.y)**', [
+      syntax(0, 3),
+      styled(3, 18, ['strongText']),
+      styled(3, 4, ['linkText', 'strongText']),
+      syntax(4, 6),
+      styled(6, 17, ['linkText']),
+      syntax(17, 20),
+    ]],
+    ['opening bold text', '**[a](https://x.y) b**', [
+      syntax(0, 3),
+      styled(3, 20, ['strongText']),
+      styled(3, 4, ['linkText', 'strongText']),
+      syntax(4, 6),
+      styled(6, 17, ['linkText']),
+      syntax(17, 18),
+      syntax(20, 22),
+    ]],
+    ['closing bold text', '**b [a](https://x.y)**', [
+      syntax(0, 2),
+      styled(2, 20, ['strongText']),
+      syntax(4, 5, ['strongText']),
+      styled(5, 6, ['linkText', 'strongText']),
+      syntax(6, 8),
+      styled(8, 19, ['linkText']),
+      syntax(19, 22),
+    ]],
+  ])('colours a masked link %s with its target between the brackets and the bold delimiters', (_name, text, ranges) => {
+    expect(decorate(text)).toEqual(ranges);
+  });
+});
