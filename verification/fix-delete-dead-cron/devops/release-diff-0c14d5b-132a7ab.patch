-import { parseExpression } from 'cron-parser';
-import { isApiError } from 'paracord';
-import { getPostgres, type DatabaseSchema } from 'project-utils';
-
-import type { UpdateObject } from 'kysely';
-import type { NextApiRequest, NextApiResponse } from 'next';
-
-import { getApi } from '~/utils/discord';
-
-const database = getPostgres();
-
-export default async function handler(req: NextApiRequest, res: NextApiResponse) {
-  const api = getApi();
-
-  if (req.query.key !== 'vercel') {
-    res.status(404).end();
-    return;
-  }
-
-  const scheduled = await database
-    .selectFrom('ScheduledMessages')
-    .leftJoin('Messages', 'ScheduledMessages.fk_messages_id', 'Messages.id')
-    .select(['ScheduledMessages.id', 'ScheduledMessages.cron', 'ScheduledMessages.webhookUrl', 'Messages.data'])
-    .where('ScheduledMessages.sendAt', '<=', new Date())
-    .where('ScheduledMessages.sent', '=', false)
-    .where('ScheduledMessages.error', 'is', null)
-    .execute();
-  // .scheduledMessage.findMany({
-  //   where: {
-  //     sendAt: { lte: new Date() },
-  //     sent: false,
-  //     error: null,
-  //   },
-  //   select: {
-  //     id: true,
-  //     cron: true,
-  //     webhookUrl: true,
-  //     message: { select: { data: true } },
-  //   },
-  // });
-
-  const promises = scheduled.map(async ({
-    id, cron, webhookUrl, data,
-  }) => {
-    try {
-      await api.request('post', webhookUrl, { data });
-
-      let update: UpdateObject<DatabaseSchema, 'ScheduledMessages'>;
-      if (cron) {
-        const newSendAt = parseExpression(cron).next().toDate();
-        update = { sent: false, error: null, sendAt: newSendAt };
-      } else {
-        update = { sent: true, error: null };
-      }
-      await database
-        .updateTable('ScheduledMessages')
-        .where('id', '=', id)
-        .set(update)
-        .execute();
-      // .scheduledMessage.update({
-      //   where,
-      //   data: update,
-      // });
-    } catch (err) {
-      const message = isApiError(err) || err instanceof Error ? err.message : 'An unknown error occurred.';
-      await database
-        .updateTable('ScheduledMessages')
-        .where('id', '=', id)
-        .set({ error: message, sent: true })
-        .execute();
-      // .scheduledMessage.update({
-      //   where,
-      //   data: { error: message, sent: true },
-      // });
-    }
-  });
-
-  await Promise.allSettled(promises);
-
-  res.status(200).json({ success: true });
-}
