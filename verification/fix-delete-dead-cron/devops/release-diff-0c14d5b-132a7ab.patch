-import {
-  beforeEach, describe, expect, it, vi,
-} from 'vitest';
-
-import createCapturingDatabase from '../utils/__tests__/helpers/capturingDatabase';
-
-import { makeRes } from './helpers/apiResponse';
-
-const holder = vi.hoisted(() => ({ db: undefined as unknown }));
-
-vi.mock('project-utils', () => ({ getPostgres: () => holder.db }));
-vi.mock('~/utils/discord', () => ({ getApi: () => ({ request: vi.fn() }) }));
-
-type Handler = (req: never, res: never) => Promise<unknown>;
-
-let captured: ReturnType<typeof createCapturingDatabase>;
-let handler: Handler;
-
-beforeEach(async () => {
-  vi.resetModules();
-  captured = createCapturingDatabase();
-  holder.db = captured.db;
-  ({ default: handler } = await import('~/pages/api/cron') as { default: Handler });
-});
-
-describe('the cron route\'s selection of due messages', () => {
-  it('selects only rows whose error is null, as an is-null test and not a comparison', async () => {
-    await handler({ query: { key: 'vercel' } } as never, makeRes() as never);
-
-    expect(captured.queries).toHaveLength(1);
-    const [{ sql, parameters }] = captured.queries;
-    expect(sql).toContain('"ScheduledMessages"."error" is null');
-    expect(sql).not.toMatch(/"error" = /);
-    expect(parameters).not.toContain(null);
-  });
-
-  it('still selects only unsent rows that are due', async () => {
-    await handler({ query: { key: 'vercel' } } as never, makeRes() as never);
-
-    const [{ sql, parameters }] = captured.queries;
