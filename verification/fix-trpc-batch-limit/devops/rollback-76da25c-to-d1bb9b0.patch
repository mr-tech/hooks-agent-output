@@ -0,0 +1,43 @@
+import { unstable_doesMiddlewareMatch as doesMiddlewareMatch } from 'next/experimental/testing/server';
+import { NextRequest } from 'next/server';
+import { describe, expect, it } from 'vitest';
+
+import middleware, { config } from '../middleware';
+
+const forwarded = 'x-middleware-request-';
+
+async function headersReachingPage(path: string, sent: Record<string, string>) {
+  const url = `http://localhost${path}`;
+  if (!doesMiddlewareMatch({ config, url })) return new Headers(sent);
+
+  const response = middleware(new NextRequest(url, { headers: sent }));
+  const overridden = response.headers.get('x-middleware-override-headers');
+  if (!overridden) return new Headers(sent);
+
+  const seen = new Headers();
+  overridden.split(',').map((name) => name.trim()).forEach((name) => {
+    seen.set(name, response.headers.get(`${forwarded}${name}`) ?? '');
+  });
+  return seen;
+}
+
+describe('a message page request carrying a client-sent x-pathname header', () => {
+  it.each([
+    ['/message', '/message'],
+    ['/message?guild_id=123', '/message'],
+    ['/message/m/1/edit', '/message/m/1/edit'],
+    ['/message/f/123', '/message/f/123'],
+  ])('reaches the page at %s with x-pathname set to %s', async (path, pathname) => {
+    const seen = await headersReachingPage(path, { 'x-pathname': '/message/m/0/edit' });
+
+    expect(seen.get('x-pathname')).toBe(pathname);
+  });
+});
+
+describe('a message page request with a query string', () => {
+  it('reaches the page with no x-query-params header', async () => {
+    const seen = await headersReachingPage('/message/m/1/edit?code=abc', {});
+
+    expect(seen.has('x-query-params')).toBe(false);
+  });
+});
