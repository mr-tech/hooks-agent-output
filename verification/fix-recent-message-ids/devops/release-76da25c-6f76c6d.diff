+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import redis from '../index';
+
+const fetchMock = vi.hoisted(() => vi.fn());
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test', DISCORD_URL: 'https://discord.test/api' } }));
+vi.mock('project-utils', () => ({ getPostgres: () => ({}) }));
+vi.mock('~/utils/discord', () => ({ getApi: () => ({ request: vi.fn() }) }));
+vi.mock('../client', () => ({
+  getClient: () => ({
+    get: async () => null,
+    set: async () => 'OK',
+    del: async () => 1,
+    publish: async () => 0,
+  }),
+  getSubscriber: () => ({ subscribe: async () => {}, on: () => {} }),
+}));
+
+const ADMINISTRATOR = '8';
+const ADMINISTRATOR_AND_MANAGE_MESSAGES = '8200';
+const MANAGE_GUILD_AND_MANAGE_MESSAGES = '8224';
+
+const wireGuild = (id: string, name: string, owner: boolean, permissions: string) => ({
+  id, name, icon: null, owner, permissions, features: ['COMMUNITY'],
+});
+
+beforeEach(() => {
+  fetchMock.mockReset();
+  vi.stubGlobal('fetch', fetchMock);
+});
+afterEach(() => { vi.unstubAllGlobals(); });
+
+describe('redis.fetchUserGuilds', () => {
+  it('keeps only the servers the user owns or holds Administrator in, by name, with the session\'s fields', async () => {
+    fetchMock.mockResolvedValue({
+      json: async () => [
+        wireGuild('300000000000000001', 'Delta', false, MANAGE_GUILD_AND_MANAGE_MESSAGES),
+        wireGuild('300000000000000002', 'Charlie', true, '0'),
+        wireGuild('300000000000000003', 'Bravo', false, ADMINISTRATOR),
+        wireGuild('300000000000000004', 'Echo', false, '0'),
+        wireGuild('300000000000000005', 'Alpha', false, ADMINISTRATOR_AND_MANAGE_MESSAGES),
+      ],
+    });
+
+    const guilds = await redis.fetchUserGuilds('100000000000000001', 'access-token');
+
+    expect(guilds).toEqual([
+      {
+        id: '300000000000000005', name: 'Alpha', icon: null, owner: false, permissions: ADMINISTRATOR_AND_MANAGE_MESSAGES,
+      },
+      {
+        id: '300000000000000003', name: 'Bravo', icon: null, owner: false, permissions: ADMINISTRATOR,
+      },
+      {
+        id: '300000000000000002', name: 'Charlie', icon: null, owner: true, permissions: '0',
+      },
+    ]);
+    expect(fetchMock).toHaveBeenCalledWith(
+      'https://discord.test/api/users/@me/guilds',
+      { headers: { Authorization: 'Bearer access-token' } },
+    );
+  });
+
+  it('keeps no server for a user who owns none and holds Administrator in none', async () => {
+    fetchMock.mockResolvedValue({
+      json: async () => [
+        wireGuild('300000000000000011', 'Delta', false, MANAGE_GUILD_AND_MANAGE_MESSAGES),
+        wireGuild('300000000000000012', 'Echo', false, '0'),
+      ],
+    });
+
+    await expect(redis.fetchUserGuilds('100000000000000002', 'access-token')).resolves.toEqual([]);
+  });
+});
