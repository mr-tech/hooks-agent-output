## 4 fetchChannels @5ec0621 src/utils/redis/index.ts
async function fetchChannels(guildId: string) {
  return getFromCache(
    ['guild', guildId, 'channels'],
    { expireSeconds: 10 },
    async () => {
      const [{ data: channels }, { data: { threads } }] = await Promise.all([
        getApi().request<Channel[]>('GET', `/guilds/${guildId}/channels`),
        getApi().request<{ threads: Array<Channel & { parent_id: string }> }>('GET', `/guilds/${guildId}/threads/active`),
      ]);

      const threadMap = new UpsertArrayMap<string, DiscordThread>();
      for (const t of threads) {
        if (t.name) {
          threadMap.upsert(t.parent_id, { id: t.id, name: t.name });
        }
      }

      const trimmedChannels: DiscordChannel[] = [];
      for (const channel of channels) {
        if (
          channel.name
          && (
            TEXT_CHANNEL_TYPES.includes(channel.type)
            || VOICE_CHANNEL_TYPES.includes(channel.type)
          )
        ) {
          trimmedChannels.push({
            id: channel.id,
            name: channel.name,
            type: channel.type,
            threads: threadMap.get(channel.id) ?? [],
          });
        }
      }

      return trimmedChannels;
