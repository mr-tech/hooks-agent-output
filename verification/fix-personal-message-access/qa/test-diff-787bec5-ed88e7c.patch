+    ['updateRecentMessageData', (id: string) => callerAs(OWNER).updateRecentMessageData(recentData(id))],
+    ['delete', (id: string) => callerAs(OWNER).delete({ id })],
+  ] as const;
+
+  it.each(calls)('%s refuses a number past the largest a message can hold, before any query', async (_, call) => {
