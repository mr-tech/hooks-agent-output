@@ -0,0 +1,34 @@
+import {
+  describe, expect, it, vi,
+} from 'vitest';
+
+import { messageIdShape } from '~/server/api/utils/shapes';
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+
+describe('messageIdShape', () => {
+  it.each([
+    ['an exponent', '1e3'],
+    ['letters', 'abc'],
+    ['a hexadecimal prefix', '0x10'],
+    ['a decimal point', '1.5'],
+    ['a minus sign', '-1'],
+    ['a plus sign', '+1'],
+    ['a leading space', ' 1'],
+    ['the empty string', ''],
+    ['20 digits, even when their value fits', '00000000000000000042'],
+    ['one past the largest number a message can hold', '9223372036854775808'],
+  ])('refuses %s as a failed parse, without throwing', (_, id) => {
+    let outcome: { success: boolean } | undefined;
+    expect(() => { outcome = messageIdShape.safeParse(id); }).not.toThrow();
+    expect(outcome?.success).toBe(false);
+  });
+
+  it.each([
+    ['the largest number a message can hold', '9223372036854775807', '9223372036854775807'],
+    ['a number with leading zeros', '0042', '42'],
+    ['zero', '0', '0'],
+  ])('accepts %s as its canonical digits', (_, id, canonical) => {
+    expect(messageIdShape.safeParse(id)).toEqual({ success: true, data: canonical });
+  });
+});
