--- /dev/null
+++ b/src/providers/MessageProvider/__tests__/MessageProvider.save-new-number.test.tsx
@@ -0,0 +1,100 @@
+import { act } from 'react';
+import {
+  afterEach, describe, expect, it, vi,
+} from 'vitest';
+
+import { mountInMessageProvider } from './helpers/mountMessageProvider';
+
+import { unmountDom } from '~/components/__tests__/helpers/dom';
+import { useMessage } from '~/providers/MessageProvider';
+import { readDrafts, writeDraft } from '~/utils/messageDrafts';
+
+const HELD = '900000000000101';
+const FRESH = '900000000000777';
+
+const hoisted = vi.hoisted(() => ({
+  replace: vi.fn(),
+  push: vi.fn(),
+  answerWith: '',
+  stored: {
+    id: '900000000000101',
+    name: 'Stored',
+    updatedAt: 1,
+    data: {
+      content: 'hi', embeds: [], components: [],
+    } as Record<string, unknown>,
+  },
+}));
+
+vi.mock('~/env.mjs', async () => (await import('./helpers/messageProviderDeps')).ENV_MOCK);
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({
+    push: hoisted.push, replace: hoisted.replace, refresh: vi.fn(), back: vi.fn(),
+  }),
+  usePathname: () => `/message/m/${hoisted.stored.id}/edit`,
+  useSearchParams: () => new URLSearchParams(''),
+}));
+vi.mock('next-auth/react', async () => (await import('./helpers/messageProviderDeps')).AUTH_MOCK);
+vi.mock('~/providers/GuildProvider', async () => (await import('./helpers/messageProviderDeps')).GUILD_PROVIDER_MOCK);
+vi.mock('~/providers/WebhookProvider', async () => (await import('./helpers/messageProviderDeps')).WEBHOOK_PROVIDER_MOCK);
+vi.mock('~/providers/ConfirmationProvider', async () => (await import('./helpers/messageProviderDeps')).CONFIRMATION_PROVIDER_MOCK);
+vi.mock('~/utils/api', async () => {
+  const { buildApiMock } = await import('./helpers/messageProviderDeps');
+  return buildApiMock({
+    queryData: { 'message.getOne': () => hoisted.stored },
+    onMutation: {
+      'message.upsert': (opts, input) => {
+        const sent = (input as { message: { name: string, data: unknown } }).message;
+        const onSuccess = opts.onSuccess as (saved: unknown, variables: unknown) => void;
+        onSuccess({ ...hoisted.stored, ...sent, id: hoisted.answerWith }, input);
+      },
+    },
+  });
+});
+
+afterEach(() => {
+  unmountDom();
+  hoisted.replace.mockReset();
+  hoisted.push.mockReset();
+  window.localStorage.clear();
+});
+
+let ctx: ReturnType<typeof useMessage> | null = null;
+const Probe: FC = () => {
+  ctx = useMessage();
+  return null;
+};
+
+function current() {
+  expect(ctx).toBeTruthy();
+  return ctx as ReturnType<typeof useMessage>;
+}
+
+function saveAnsweredWith(id: string) {
+  hoisted.answerWith = id;
+  writeDraft(HELD, { name: hoisted.stored.name, data: hoisted.stored.data as never, editedAt: 2 });
+  act(() => { mountInMessageProvider(<Probe />); });
+  expect(current().message?.id).toBe(HELD);
+  act(() => { current().saveMessage(); });
+}
+
+describe('MessageProvider — the number a save comes back with', () => {
+  it('moves the editor to the new number when the save of a held number lands at another', () => {
+    saveAnsweredWith(FRESH);
+
+    expect(hoisted.replace).toHaveBeenCalledTimes(1);
+    expect(hoisted.replace).toHaveBeenCalledWith(`/message/m/${FRESH}/edit`);
+  });
+
+  it('drops the draft held under the old number once its content is saved at the new one', () => {
+    saveAnsweredWith(FRESH);
+
+    expect(Object.keys(readDrafts())).not.toContain(HELD);
+  });
+
+  it('keeps the editor where it is when the save comes back with the held number', () => {
+    saveAnsweredWith(HELD);
+
+    expect(hoisted.replace).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/server/__tests__/auth.hydrated-recent-messages.test.ts b/src/server/__tests__/auth.hydrated-recent-messages.test.ts
new file mode 100644
index 0000000..7d8fde1
