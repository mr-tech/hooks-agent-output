@@ -0,0 +1,84 @@
+import {
+  beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import type { CompiledQuery } from 'kysely';
+
+import { hydratedAuthOptions } from '~/server/auth';
+
+const mocks = vi.hoisted(() => ({
+  respond: (() => []) as (query: CompiledQuery) => unknown[],
+  queries: [] as CompiledQuery[],
+  fetchUserAccount: vi.fn(),
+  fetchUserGuilds: vi.fn(),
+  fetchGuild: vi.fn(async () => {}),
+}));
+
+vi.mock('~/env.mjs', () => ({
+  env: new Proxy({}, { get: (_, key) => `test-${String(key)}` }),
+}));
+vi.mock('project-utils', async () => {
+  const { default: create } = await import('../api/utils/__tests__/helpers/capturingDatabase');
+  const { db, queries } = create((query) => mocks.respond(query));
+  mocks.queries = queries;
+  return { getPostgres: () => db };
+});
+vi.mock('~/utils/redis', () => ({ default: mocks }));
+vi.mock('~/utils/redis/client', () => ({ getClient: () => ({}) }));
+
+const OWNER_DB_ID = '900000000000001';
+const VIEWER_DB_ID = '900000000000002';
+const OWNED_MESSAGE_ID = '900000000000101';
+const VIEWER_MESSAGE_ID = '900000000000102';
+
+const rows = [
+  { id: OWNED_MESSAGE_ID, owner: OWNER_DB_ID, name: 'owner-private-name' },
+  { id: VIEWER_MESSAGE_ID, owner: VIEWER_DB_ID, name: 'viewer-name' },
+];
+
+function boundTo(query: CompiledQuery, column: string): unknown {
+  const match = query.sql.match(new RegExp(`"${column}" = \\$(\\d+)`));
+  return match ? query.parameters[Number(match[1]) - 1] : undefined;
+}
+
+beforeEach(() => {
+  mocks.queries.length = 0;
+  mocks.respond = (query) => {
+    if (!query.sql.includes('from "Messages"')) return [];
+    const owner = boundTo(query, 'fk_users_id');
+    return rows
+      .filter(({ id }) => query.parameters.includes(id))
+      .filter((row) => owner === undefined || row.owner === owner)
+      .map(({ id, name }) => ({
+        id, name, createdAt: new Date(0), updatedAt: new Date(0), previewImageNonce: 'v1', guildId: null,
+      }));
+  };
+  mocks.fetchUserAccount.mockResolvedValue({ access_token: 'token', providerAccountId: '100000000000000002' });
+  mocks.fetchUserGuilds.mockResolvedValue([]);
+});
+
+async function hydrateAs(dbUserId: string, recentMessageIds: string[]) {
+  const session = await hydratedAuthOptions.callbacks?.session?.({
+    session: { user: {}, expires: '' },
+    user: { id: dbUserId, preferences: { recentMessageIds } },
+    token: {},
+  } as never) as unknown as { hydration: { messages: { id: string, name: string }[] } };
+  return session.hydration.messages;
+}
+
+describe('the hydrated session\'s recent messages', () => {
+  it('lists a recent personal message the signed-in user owns', async () => {
+    const messages = await hydrateAs(VIEWER_DB_ID, [VIEWER_MESSAGE_ID]);
+
+    expect(messages.map(({ id }) => id)).toEqual([VIEWER_MESSAGE_ID]);
+  });
+
+  it('leaves out another user\'s personal message stored in the preferences', async () => {
+    const messages = await hydrateAs(VIEWER_DB_ID, [OWNED_MESSAGE_ID, VIEWER_MESSAGE_ID]);
+
+    expect(messages.map(({ id }) => id)).toEqual([VIEWER_MESSAGE_ID]);
+    expect(JSON.stringify(messages)).not.toContain('owner-private-name');
+    const select = mocks.queries.find(({ sql }) => sql.includes('from "Messages"'));
+    expect(select && boundTo(select, 'fk_users_id')).toBe(VIEWER_DB_ID);
+  });
+});
diff --git a/src/server/api/routers/__tests__/message.personal-ownership.test.ts b/src/server/api/routers/__tests__/message.personal-ownership.test.ts
new file mode 100644
index 0000000..435642d
--- /dev/null
+++ b/src/server/api/routers/__tests__/message.personal-ownership.test.ts
@@ -0,0 +1,405 @@
+import {
+  beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import createCapturingDatabase from '../../utils/__tests__/helpers/capturingDatabase';
+import messageRouter from '../message';
+
+import type { CompiledQuery } from 'kysely';
+
+const mocks = vi.hoisted(() => ({
+  db: undefined as unknown,
+  authorizeGuildAdmin: vi.fn(),
+  s3Inputs: [] as unknown[],
+  channels: [] as string[],
+}));
+
+vi.mock('~/env.mjs', () => ({
+  env: new Proxy({}, { get: (_, key) => `test-${String(key)}` }),
+}));
+vi.mock('~/server/auth', () => ({
+  getServerAuthSession: vi.fn(),
+  getHydratedServerAuthSession: vi.fn(),
+}));
+vi.mock('project-utils', () => ({ getPostgres: () => mocks.db }));
+vi.mock('pusher', () => ({
+  default: class {
+    trigger = vi.fn(async (channel: string) => { mocks.channels.push(channel); });
+  },
+}));
+vi.mock('@vercel/functions', () => ({ waitUntil: () => undefined }));
+vi.mock('../../utils/previewImage', () => ({
+  mintNonce: () => 'v0000000000000000aaaaaaaaaaaaaaaa',
+  runPreviewContinuation: async () => {},
+}));
+vi.mock('../../utils/previewBucket', async (importOriginal) => ({
+  ...(await importOriginal<object>()),
+  getS3: () => ({
+    send: async ({ input }: { input: unknown }) => {
+      mocks.s3Inputs.push(input);
+      return {};
+    },
+  }),
+}));
+vi.mock('../../utils/authorizeGuildAdmin', () => ({ default: mocks.authorizeGuildAdmin }));
+vi.mock('~/utils/redis', () => ({ default: {} }));
+vi.mock('~/utils/redis/messageStore', () => ({ default: {} }));
+
+const OWNER = { discordId: '100000000000000001', dbUserId: '900000000000001' };
+const OTHER = { discordId: '100000000000000002', dbUserId: '900000000000002' };
+const GUILD = { discordId: '300000000000000001', rowId: '700000000000001' };
+
+const OWNED_ID = '900000000000101';
+const GUILD_MESSAGE_ID = '900000000000201';
+const UNUSED_ID = '900000000000500';
+const SERVER_ASSIGNED_ID = '900000000000777';
+
+const SECRET = 'owner-only-content';
+
+interface Row {
+  fk_users_id: string | null;
+  fk_guilds_id: string | null;
+  guildId: string | null;
+}
+
+const rows: Record<string, Row> = {
+  [OWNED_ID]: { fk_users_id: OWNER.dbUserId, fk_guilds_id: null, guildId: null },
+  [GUILD_MESSAGE_ID]: { fk_users_id: null, fk_guilds_id: GUILD.rowId, guildId: GUILD.discordId },
+};
+
+const world = { ownerCount: 0, deleteMisses: false };
+
+function boundTo(query: CompiledQuery, column: string): unknown {
+  const match = query.sql.match(new RegExp(`"${column}" = \\$(\\d+)`));
+  return match ? query.parameters[Number(match[1]) - 1] : undefined;
+}
+
+function asBigint(value: unknown): string | undefined {
+  try {
+    return BigInt(String(value).trim()).toString();
+  } catch {
+    return undefined;
+  }
+}
+
+function rowOf(value: unknown): [string, Row] | [] {
+  const id = asBigint(value);
+  return id !== undefined && id in rows ? [id, rows[id]] : [];
+}
+
+function fullRow(id: string, row: Row) {
+  return {
+    id,
+    createdAt: new Date(0),
+    updatedAt: new Date(0),
+    name: 'owner-name',
+    data: { content: SECRET },
+    previewImageNonce: null,
+    recentWebhookId: null,
+    recentThreadId: null,
+    recentMessageId: null,
+    guildId: row.guildId,
+    scheduledMessageId: null,
+    scheduledMessageCron: null,
+    scheduledMessageError: null,
+    scheduledMessageSendAt: null,
+    scheduledMessageSent: null,
+  };
+}
+
+function insertedId({ sql, parameters }: CompiledQuery) {
+  const columns = (sql.match(/^insert into "Messages" \(([^)]*)\)/)?.[1] ?? '').split(', ');
+  const index = columns.indexOf('"id"');
+  return index === -1 ? SERVER_ASSIGNED_ID : String(parameters[index]);
+}
+
+function respond(query: CompiledQuery): unknown[] {
+  const { sql, parameters } = query;
+  if (sql.startsWith('select "userId" from "Accounts"')) {
+    const account = [OWNER, OTHER].find(({ discordId }) => parameters.includes(discordId));
+    return account ? [{ userId: account.dbUserId }] : [];
+  }
+  if (sql.startsWith('select "fk_users_id" from "Messages"')) {
+    return parameters.flatMap((value) => {
+      const [, row] = rowOf(value);
+      return row ? [{ fk_users_id: row.fk_users_id }] : [];
+    });
+  }
+  if (sql.includes('left join "ScheduledMessages"')) {
+    const [id, row] = rowOf(parameters[0]);
+    if (id && row) return [fullRow(id, row)];
+    const fresh = String(parameters[0]);
+    return [fullRow(fresh, { fk_users_id: null, fk_guilds_id: null, guildId: null })];
+  }
+  if (sql.startsWith('select "Guilds"."guildId" from "Messages"')) {
+    return parameters.flatMap((value) => {
+      const [, row] = rowOf(value);
+      return row ? [{ guildId: row.guildId }] : [];
+    });
+  }
+  if (sql.startsWith('select count(*)')) return [{ count: String(world.ownerCount) }];
+  if (sql.startsWith('insert into "Guilds"')) return [{ id: GUILD.rowId }];
+  if (sql.startsWith('insert into "Messages"')) return [{ id: insertedId(query), savedAtMicros: '1763509200000000' }];
+  if (sql.startsWith('update "Messages"')) {
+    const [id, row] = rowOf(boundTo(query, 'id'));
+    if (!id || !row) return [];
+    const owner = boundTo(query, 'fk_users_id');
+    if (owner !== undefined && owner !== row.fk_users_id) return [];
+    const guildRow = boundTo(query, 'fk_guilds_id');
+    if (guildRow !== undefined && guildRow !== row.fk_guilds_id) return [];
+    return [{ id, savedAtMicros: '1763509200000000' }];
+  }
+  if (sql.startsWith('delete from "Messages"')) {
+    const [id, row] = rowOf(boundTo(query, 'id'));
+    if (!id || !row || world.deleteMisses) return [];
+    const owner = boundTo(query, 'fk_users_id');
+    if (owner !== undefined && owner !== row.fk_users_id) return [];
+    const guildId = boundTo(query, 'guildId');
+    if (guildId !== undefined && guildId !== row.guildId) return [];
+    return [{ id }];
+  }
+  return [];
+}
+
+let captured: ReturnType<typeof createCapturingDatabase>;
+
+function callerAs(user: { discordId: string }) {
+  return messageRouter.createCaller({
+    session: { user: { id: user.discordId, guilds: [] }, expires: 'never' },
+    req: {},
+    database: captured.db,
+  } as never);
+}
+
+const writesOf = (table: string) => captured.queries.filter(({ sql }) => (
+  sql.startsWith(`insert into "${table}"`) || sql.startsWith(`update "${table}"`) || sql.startsWith(`delete from "${table}"`)
+));
+
+const draft = (id?: string, guildId?: string) => ({
+  ...(id ? { id } : {}),
+  ...(guildId ? { guildId } : {}),
+  name: 'n',
+  data: {
+    content: 'Hi', username: 'U', embeds: [], components: [],
+  },
+}) as never;
+
+beforeEach(() => {
+  world.ownerCount = 0;
+  world.deleteMisses = false;
+  mocks.s3Inputs.length = 0;
+  mocks.channels.length = 0;
+  mocks.authorizeGuildAdmin.mockReset().mockResolvedValue({
+    account: { providerAccountId: OWNER.discordId },
+    guild: { id: GUILD.discordId },
+  });
+  vi.stubGlobal('fetch', vi.fn(() => new Promise<never>(() => { void 0; })));
+  captured = createCapturingDatabase(respond);
+  mocks.db = captured.db;
+});
+
+describe('message.getOne on a personal message', () => {
+  it('returns the message to the user who owns it', async () => {
+    const message = await callerAs(OWNER).getOne(OWNED_ID);
+
+    expect(message?.data).toEqual({ content: SECRET });
+  });
+
+  it('refuses another signed-in user, with none of the message in the outcome', async () => {
+    const outcome = await callerAs(OTHER).getOne(OWNED_ID).then(
+      (value) => ({ value }),
+      (error: unknown) => ({ error }),
+    );
+
+    expect(outcome).toMatchObject({ error: { code: 'NOT_FOUND' } });
+    expect(JSON.stringify(outcome)).not.toContain(SECRET);
+  });
+});
+
+describe('message.upsert with a message number no row holds', () => {
+  it('never writes a row at the number the browser sent', async () => {
+    const saved = await callerAs(OTHER).upsert({ message: draft(UNUSED_ID) });
+
+    const inserts = writesOf('Messages').filter(({ sql }) => sql.startsWith('insert'));
+    expect(inserts).toHaveLength(1);
+    expect(inserts[0].parameters).not.toContain(UNUSED_ID);
+    expect(saved?.id).toBe(SERVER_ASSIGNED_ID);
+  });
+
+  it('announces no update on the number the browser sent', async () => {
+    await callerAs(OTHER).upsert({ message: draft(UNUSED_ID) });
+
+    expect(mocks.channels).toEqual([]);
+  });
+
+  it('refuses at the per-user cap, and creates no row', async () => {
+    world.ownerCount = 1000;
+
+    await expect(callerAs(OTHER).upsert({ message: draft(UNUSED_ID) }))
+      .rejects.toThrow('You have reached the limit of 1000 messages per user.');
+
+    expect(writesOf('Messages').filter(({ sql }) => sql.startsWith('insert'))).toHaveLength(0);
+  });
+});
+
+describe('message.upsert, the number the browser sends', () => {
+  it('updates and announces the canonical number when the browser sends leading zeros', async () => {
+    await callerAs(OWNER).upsert({ message: draft(`00${OWNED_ID}`) });
+
+    expect(captured.queries.length).toBeGreaterThan(0);
+    for (const { parameters } of captured.queries) {
+      expect(parameters).not.toContain(`00${OWNED_ID}`);
+    }
+    expect(boundTo(writesOf('Messages')[0], 'id')).toBe(OWNED_ID);
+    expect(mocks.channels).toEqual([`message-update-${OWNED_ID}`]);
+  });
+
+  it('refuses a number that is not digits before any query', async () => {
+    await expect(callerAs(OWNER).upsert({ message: draft(` ${OWNED_ID}`) })).rejects.toMatchObject({ code: 'BAD_REQUEST' });
+
+    expect(captured.queries).toHaveLength(0);
+  });
+});
+
+describe('message.upsert of an existing message', () => {
+  it('writes a personal message only where the caller still owns the row', async () => {
+    await callerAs(OWNER).upsert({ message: draft(OWNED_ID) });
+
+    const writes = writesOf('Messages');
+    expect(writes).toHaveLength(1);
+    expect(boundTo(writes[0], 'id')).toBe(OWNED_ID);
+    expect(boundTo(writes[0], 'fk_users_id')).toBe(OWNER.dbUserId);
+    expect(mocks.channels).toEqual([`message-update-${OWNED_ID}`]);
+  });
+
+  it('writes a server message only where the row still belongs to that server, for any of its admins', async () => {
+    await callerAs(OTHER).upsert({ message: draft(GUILD_MESSAGE_ID, GUILD.discordId) });
+
+    const writes = writesOf('Messages');
+    expect(writes).toHaveLength(1);
+    expect(boundTo(writes[0], 'id')).toBe(GUILD_MESSAGE_ID);
+    expect(boundTo(writes[0], 'fk_guilds_id')).toBe(GUILD.rowId);
+    expect(boundTo(writes[0], 'fk_users_id')).toBeUndefined();
+  });
+});
+
+const recentData = (id: string) => ({
+  id,
+  recentWebhookId: '400000000000000001',
+  recentThreadId: null,
+  recentMessageId: '400000000000000002',
+});
+
+describe('message.updateRecentMessageData', () => {
+  it('writes a personal message only where the caller still owns the row', async () => {
+    await callerAs(OWNER).updateRecentMessageData(recentData(OWNED_ID));
+
+    const writes = writesOf('Messages');
+    expect(writes).toHaveLength(1);
+    expect(boundTo(writes[0], 'id')).toBe(OWNED_ID);
+    expect(boundTo(writes[0], 'fk_users_id')).toBe(OWNER.dbUserId);
+  });
+
+  it('writes a server message only where the row still belongs to that server', async () => {
+    await callerAs(OTHER).updateRecentMessageData(recentData(GUILD_MESSAGE_ID));
+
+    const writes = writesOf('Messages');
+    expect(writes).toHaveLength(1);
+    expect(boundTo(writes[0], 'id')).toBe(GUILD_MESSAGE_ID);
+    expect(boundTo(writes[0], 'guildId')).toBe(GUILD.discordId);
+    expect(boundTo(writes[0], 'fk_users_id')).toBeUndefined();
+  });
+
+  it('reads, checks and writes the canonical number when the browser sends leading zeros', async () => {
+    await callerAs(OWNER).updateRecentMessageData(recentData(`00${OWNED_ID}`));
+
+    expect(captured.queries.length).toBeGreaterThan(0);
+    for (const { parameters } of captured.queries) {
+      expect(parameters).not.toContain(`00${OWNED_ID}`);
+    }
+    expect(boundTo(writesOf('Messages')[0], 'id')).toBe(OWNED_ID);
+  });
+});
+
+describe('message.delete', () => {
+  it('checks, deletes and clears the previews of the canonical number when the browser sends leading zeros', async () => {
+    await callerAs(OWNER).delete({ id: `00${OWNED_ID}` });
+
+    for (const { parameters } of captured.queries) {
+      expect(parameters).not.toContain(`00${OWNED_ID}`);
+    }
+    expect(boundTo(writesOf('Messages')[0], 'id')).toBe(OWNED_ID);
+    expect(mocks.s3Inputs[0]).toMatchObject({ Prefix: `previews/${OWNED_ID}/` });
+  });
+
+  it('refuses a number that is not digits before any query', async () => {
+    await expect(callerAs(OWNER).delete({ id: ` ${OWNED_ID}` })).rejects.toMatchObject({ code: 'BAD_REQUEST' });
+
+    expect(captured.queries).toHaveLength(0);
+  });
+
+  it('deletes a personal message only where the caller still owns the row', async () => {
+    await callerAs(OWNER).delete({ id: OWNED_ID });
+
+    const writes = writesOf('Messages');
+    expect(writes).toHaveLength(1);
+    expect(boundTo(writes[0], 'id')).toBe(OWNED_ID);
+    expect(boundTo(writes[0], 'fk_users_id')).toBe(OWNER.dbUserId);
+  });
+
+  it('deletes a server message only where the row still belongs to that server', async () => {
+    await callerAs(OTHER).delete({ id: GUILD_MESSAGE_ID });
+
+    const writes = writesOf('Messages');
+    expect(writes).toHaveLength(1);
+    expect(boundTo(writes[0], 'id')).toBe(GUILD_MESSAGE_ID);
+    expect(boundTo(writes[0], 'guildId')).toBe(GUILD.discordId);
+    expect(boundTo(writes[0], 'fk_users_id')).toBeUndefined();
+  });
+
+  it('leaves the previews alone when the delete removed no row', async () => {
+    world.deleteMisses = true;
+
