@@ -0,0 +1,17 @@
+function isSameLocalDay(a: Date, b: Date) {
+  return a.getFullYear() === b.getFullYear()
+    && a.getMonth() === b.getMonth()
+    && a.getDate() === b.getDate();
+}
+
+export default function formatMessageDate(timestamp: string | number, todayPrefix = '') {
+  const messageDate = new Date(timestamp);
+  if (isSameLocalDay(messageDate, new Date())) {
+    return `${todayPrefix}${messageDate.toLocaleTimeString(undefined, {
+      hour: 'numeric', minute: 'numeric', second: undefined,
+    })}`;
+  }
+  return messageDate.toLocaleDateString(undefined, {
+    weekday: undefined, year: 'numeric', day: 'numeric', month: 'numeric',
+  });
+}
