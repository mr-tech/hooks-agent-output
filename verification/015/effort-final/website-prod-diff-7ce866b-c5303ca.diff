@@ -0,0 +1,7 @@
+import { DISCORD_MESSAGE_LINK_REGEX } from '~/constants';
+
+export default function parseMessageId(input: string) {
+  const text = input.trim();
+  if (/^\d+$/.test(text)) return text;
+  return DISCORD_MESSAGE_LINK_REGEX.exec(text)?.groups?.messageId ?? null;
+}
