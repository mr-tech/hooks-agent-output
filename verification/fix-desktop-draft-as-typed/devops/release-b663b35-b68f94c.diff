+import { act, useEffect, useState } from 'react';
+import {
+  afterEach, describe, expect, it, vi,
+} from 'vitest';
+
+import DiscordContentEditor from '..';
+
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+
+interface SlateStubProps {
+  initialValue: string;
+  onChange: (value: string) => void;
+}
+
+const slate = vi.hoisted(() => ({ current: null as null | { onChange: (value: string) => void } }));
+
+vi.mock('~/components/dynamics/SlateEditor', () => {
+  const SlateEditorStub = ({ initialValue, onChange }: SlateStubProps) => {
+    useEffect(() => { slate.current = { onChange }; });
+    useEffect(() => { onChange(initialValue); }, []);
+    return <textarea aria-label='message content' data-slate-stub readOnly />;
+  };
+  return { default: SlateEditorStub };
+});
+vi.mock('~/components/EmojiPicker', () => ({
+  default: ({ children }: { children: React.ReactNode }) => children,
+}));
+vi.mock('~/components/dynamics/Markdown', () => ({
+  default: ({ value }: { value: string }) => <span>{value}</span>,
+}));
+vi.mock('~/providers/MarkdownProvider', () => ({
+  useMarkdown: () => ({ interactive: { parseEmoji: () => [] }, static: {} }),
+}));
+vi.mock('~/components/DiscordContentEditor/useCustomEmojis', () => ({ default: () => [] }));
+vi.mock('~/providers/IsMobileProvider', () => ({ useIsMobile: () => false }));
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+
+afterEach(() => {
+  unmountDom();
+  slate.current = null;
+});
+
+const held: { value: undefined | string; changes: string[] } = { value: undefined, changes: [] };
+
+const Harness = ({ initial }: { initial: undefined | string }) => {
+  const [value, setValue] = useState(initial);
+  useEffect(() => { held.value = value; });
+  const onChange = (next: string) => {
+    held.changes.push(next);
+    setValue(next);
+  };
+  return (
+    <DiscordContentEditor
+      className=''
+      showEdit
+      value={value}
+      onChange={onChange}
+      limit={2000}
+      staticParser={() => []}
+      interactiveParser={() => []}
+    />
+  );
+}
+
+function open(host: HTMLElement) {
+  const button = host.querySelector('button');
+  if (!button) throw new Error('closed editor button not rendered');
+  act(() => { button.focus(); });
+  if (!slate.current) throw new Error('content editor did not open');
+  return slate.current;
+}
+
+function type(editor: { onChange: (value: string) => void }, text: string) {
+  act(() => { editor.onChange(text); });
+}
+
+describe('DiscordContentEditor on desktop, text as typed', () => {
+  it('puts text typed into the open editor on the message before the editor closes', () => {
+    held.changes = [];
+    const editor = open(mountDom(<Harness initial='Old' />));
+    type(editor, 'Hello');
+    expect(held.value).toBe('Hello');
+  });
+
+  it('puts each successive edit on the message as it is typed', () => {
+    held.changes = [];
+    const editor = open(mountDom(<Harness initial={undefined} />));
+    type(editor, 'H');
+    type(editor, 'Hi');
+    type(editor, 'Hi ');
+    expect(held.changes.slice(-3)).toEqual(['H', 'Hi', 'Hi ']);
+    expect(held.value).toBe('Hi ');
+  });
+});
