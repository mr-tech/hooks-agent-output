+import { act, useEffect, useState } from 'react';
+import {
+  afterEach, describe, expect, it, vi,
+} from 'vitest';
+
+import EmbedFooter from '../EmbedFooter';
+
+import type { EmbedFooter as EmbedFooterType } from '../../../types';
+
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+vi.mock('~/assets/svg/TextIcon', () => ({ default: {} }));
+vi.mock('~/assets/svg/VoiceIcon', () => ({ default: {} }));
+
+afterEach(() => { unmountDom(); });
+
+const held: { footer: undefined | EmbedFooterType } = { footer: undefined };
+
+const Harness = ({ initial }: { initial: undefined | EmbedFooterType }) => {
+  const [footer, setFooterState] = useState(initial);
+  useEffect(() => { held.footer = footer; });
+  const setFooter = (cb: (prev: EmbedFooterType) => EmbedFooterType) => {
+    setFooterState((prev) => cb(prev as EmbedFooterType));
+  };
+  return <EmbedFooter showEdit footer={footer} setFooter={setFooter} setTimestamp={() => {}} />;
+}
+
+function textField(host: HTMLElement) {
+  const field = host.querySelector<HTMLElement>('[aria-label="footer text"]');
+  if (!field) throw new Error('footer text field not rendered');
+  return field;
+}
+
+function focus(field: HTMLElement) {
+  field.tabIndex = 0;
+  act(() => { field.focus(); });
+}
+
+function type(field: HTMLElement, text: string) {
+  act(() => {
+    field.textContent = text;
+    field.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+}
+
+function leave(field: HTMLElement) {
+  act(() => { field.blur(); });
+}
+
+describe('EmbedFooter text as typed', () => {
+  it('puts typed footer text on the embed footer while the field still has focus', () => {
+    const field = textField(mountDom(<Harness initial={{ text: 'Old' }} />));
+    focus(field);
+    type(field, 'Hello');
+    expect(held.footer?.text).toBe('Hello');
+  });
+
+  it('puts typed footer text on an embed that had no footer while the field still has focus', () => {
+    const field = textField(mountDom(<Harness initial={undefined} />));
+    focus(field);
+    type(field, 'Hello');
+    expect(held.footer?.text).toBe('Hello');
+  });
+
+  it('keeps a trailing space the user is still typing on the embed footer text', () => {
+    const field = textField(mountDom(<Harness initial={{ text: '' }} />));
+    focus(field);
+    type(field, 'a ');
+    expect(held.footer?.text).toBe('a ');
+    type(field, 'a b');
+    expect(held.footer?.text).toBe('a b');
+  });
+
+  it('commits the typed footer text trimmed when the field loses focus', () => {
+    const field = textField(mountDom(<Harness initial={{ text: '' }} />));
+    focus(field);
+    type(field, '  Hello  ');
+    leave(field);
+    expect(held.footer?.text).toBe('Hello');
+  });
+});
