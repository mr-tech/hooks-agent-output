@@ -0,0 +1,91 @@
+import { act, useEffect, useState } from 'react';
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import EmbedAuthor from '../EmbedAuthor';
+
+import type { EmbedAuthor as EmbedAuthorType } from '../../../types';
+
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+vi.mock('~/assets/svg/TextIcon', () => ({ default: {} }));
+vi.mock('~/assets/svg/VoiceIcon', () => ({ default: {} }));
+
+const ResizeObserverStub = function ResizeObserverStub() {
+  return { observe() {}, unobserve() {}, disconnect() {} };
+};
+
+beforeEach(() => { vi.stubGlobal('ResizeObserver', ResizeObserverStub); });
+
+afterEach(() => {
+  unmountDom();
+  vi.unstubAllGlobals();
+});
+
+const held: { author: undefined | EmbedAuthorType } = { author: undefined };
+
+const Harness = ({ initial }: { initial: undefined | EmbedAuthorType }) => {
+  const [author, setAuthorState] = useState(initial);
+  useEffect(() => { held.author = author; });
+  const setAuthor = (cb: (prev: EmbedAuthorType) => EmbedAuthorType) => {
+    setAuthorState((prev) => cb(prev as EmbedAuthorType));
+  };
+  return <EmbedAuthor showEdit author={author} setAuthor={setAuthor} />;
+}
+
+function nameField(host: HTMLElement) {
+  const field = host.querySelector<HTMLElement>('[aria-label="author name"]');
+  if (!field) throw new Error('author name field not rendered');
+  return field;
+}
+
+function focus(field: HTMLElement) {
+  field.tabIndex = 0;
+  act(() => { field.focus(); });
+}
+
+function type(field: HTMLElement, text: string) {
+  act(() => {
+    field.textContent = text;
+    field.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+}
+
+function leave(field: HTMLElement) {
+  act(() => { field.blur(); });
+}
+
+describe('EmbedAuthor name as typed', () => {
+  it('puts a typed name on the embed author while the field still has focus', () => {
+    const field = nameField(mountDom(<Harness initial={{ name: 'Old' }} />));
+    focus(field);
+    type(field, 'Ann');
+    expect(held.author?.name).toBe('Ann');
+  });
+
+  it('puts a typed name on an embed that had no author while the field still has focus', () => {
+    const field = nameField(mountDom(<Harness initial={undefined} />));
+    focus(field);
+    type(field, 'Ann');
+    expect(held.author?.name).toBe('Ann');
+  });
+
+  it('keeps a trailing space the user is still typing on the embed author name', () => {
+    const field = nameField(mountDom(<Harness initial={{ name: '' }} />));
+    focus(field);
+    type(field, 'a ');
+    expect(held.author?.name).toBe('a ');
+    type(field, 'a b');
+    expect(held.author?.name).toBe('a b');
+  });
+
+  it('commits the typed name trimmed when the field loses focus', () => {
+    const field = nameField(mountDom(<Harness initial={{ name: '' }} />));
+    focus(field);
+    type(field, '  Ann  ');
+    leave(field);
+    expect(held.author?.name).toBe('Ann');
+  });
+});
