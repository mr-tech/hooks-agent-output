@@ -0,0 +1,20 @@
+export interface FenceState {
+  inCodeBlock: boolean;
+  lang: string;
+}
+
+export const NO_FENCE: FenceState = { inCodeBlock: false, lang: '' };
+
+export function isCodeLine(fence: FenceState, line: string): boolean {
+  return fence.inCodeBlock && !line.includes('```');
+}
+
+export function lineLang(fence: FenceState, line: string): string {
+  return isCodeLine(fence, line) ? fence.lang : '';
+}
+
+export function afterLine(fence: FenceState, line: string): FenceState {
+  const opening = fence.inCodeBlock ? null : /```([A-Za-z0-9-]*)$/.exec(line);
+  const inCodeBlock = line.split('```').length % 2 === 0 ? !fence.inCodeBlock : fence.inCodeBlock;
+  return { inCodeBlock, lang: inCodeBlock ? opening?.[1] ?? fence.lang : '' };
+}
