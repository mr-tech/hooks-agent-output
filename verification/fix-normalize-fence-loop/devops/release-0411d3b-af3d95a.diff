+++ b/src/components/SlateEditor/utils/__tests__/withNormalizeNode.quote-and-fence-lines-settle.test.tsx
@@ -0,0 +1,159 @@
+import { createEditor, Editor, Transforms } from 'slate';
+import { withHistory } from 'slate-history';
+import { withReact } from 'slate-react';
+import {
+  describe, expect, it, vi,
+} from 'vitest';
+
+import {
+  flattenNodeText, getInitialValue, onKeyDown, withEmojis, withNormalizeNode,
+} from '..';
+
+import type { KeyboardEvent } from 'react';
+import type { Element } from 'slate';
+
+import markdown from '~/utils/markdown';
+
+vi.mock('~/env.mjs', () => ({ env: {} }));
+
+const loadedEditor = (text: string) => {
+  const editor = withNormalizeNode(
+    withEmojis(withHistory(withReact(createEditor()))),
+    false,
+    markdown.interactive.parseEmoji,
+  );
+  editor.children = getInitialValue(text, markdown.interactive.parseEmoji, false);
+  return editor;
+};
+
+const textOf = (editor: Editor) => flattenNodeText(editor.children);
+const typesOf = (editor: Editor) => (editor.children as Element[]).map((child) => child.type);
+const langsOf = (editor: Editor) => (editor.children as Element[]).map((child) => child.lang);
+
+const pressBackspace = (editor: Editor) => {
+  const event = { key: 'Backspace', defaultPrevented: false, preventDefault() { this.defaultPrevented = true; } };
+  onKeyDown(editor, false, undefined)(event as unknown as KeyboardEvent<HTMLDivElement>);
+};
+
+const QUOTE_AND_BARE_FENCE = '> a\n```\nfoo\n```';
+
+describe('full-markdown editor holding quote lines and code fences', () => {
+  it.each([
+    QUOTE_AND_BARE_FENCE,
+    '> a\nb\n```\nfoo\n```',
+    '>>> a\n```\nfoo\n```',
+    '>>> a\nb',
+    '>>> a',
+    '>>> a\n\nb',
+    '>>> a\n> b',
+    '> a\n```js\nfoo\n```',
+  ])('settles on a forced normalise of %j with its text unchanged', (text) => {
+    const editor = loadedEditor(text);
+    Editor.normalize(editor, { force: true });
+    expect(textOf(editor)).toBe(text);
+  });
+
+  it.each([
+    [0, 'start', '> xa\n```\nfoo\n```'],
+    [0, 'end', '> ax\n```\nfoo\n```'],
+    [1, 'start', '> a\nx```\nfoo\n```'],
+    [1, 'end', '> a\n```x\nfoo\n```'],
+    [2, 'start', '> a\n```\nxfoo\n```'],
+    [2, 'end', '> a\n```\nfoox\n```'],
+    [3, 'start', '> a\n```\nfoo\nx```'],
+    [3, 'end', '> a\n```\nfoo\n```x'],
+  ] as const)('accepts a character typed into a quote plus a bare fence on line %i at its %s', (line, edge, expected) => {
+    const editor = loadedEditor(QUOTE_AND_BARE_FENCE);
+    Transforms.select(editor, edge === 'start' ? Editor.start(editor, [line]) : Editor.end(editor, [line]));
+    Transforms.insertText(editor, 'x');
+    expect(textOf(editor)).toBe(expected);
+  });
+
+  it('accepts a character typed after a multi-line quote marker followed by a bare fence', () => {
+    const editor = loadedEditor('>>> a\n```\nfoo\n```');
+    Transforms.select(editor, Editor.end(editor, [2]));
+    Transforms.insertText(editor, 'x');
+    expect(textOf(editor)).toBe('>>> a\n```\nfoox\n```');
+  });
+
+  it.each([
+    ['> a\n```c++\nfoo\n```', ['', '', '', '']],
+    ['> a\n``` js\nfoo\n```', ['', '', '', '']],
+    ['```js\n```a```\nfoo\n```', ['', '', 'js', '']],
+    ['```js\nfoo\n```\n```c++\nbar\n```', ['', 'js', '', '', '', '']],
+  ] as const)('gives each line of %j the language it loads with after a forced normalise', (text, langs) => {
+    const editor = loadedEditor(text);
+    const loaded = langsOf(editor);
+    Editor.normalize(editor, { force: true });
+    expect([textOf(editor), loaded, langsOf(editor)]).toEqual([text, langs, langs]);
+  });
+
+  it('keeps every line after a multi-line quote marker as a quote line', () => {
+    const editor = loadedEditor('>>> a\nb\nc');
+    Editor.normalize(editor, { force: true });
+    expect(typesOf(editor)).toEqual(['blockQuote', 'blockQuote', 'blockQuote']);
+  });
+
+  it.each([
+    ['>>> x', '>>> x'],
+    ['> x', '> x'],
+  ] as const)('turns %j typed into a plain line into a quote line that keeps its marker', (typed, expected) => {
+    const editor = loadedEditor('');
+    Transforms.select(editor, Editor.end(editor, [0]));
+    Transforms.insertText(editor, typed);
+    expect([textOf(editor), typesOf(editor), Editor.string(editor, [0])]).toEqual([expected, ['blockQuote'], 'x']);
+  });
+
+  it('gives the code lines the language typed onto their opening fence', () => {
+    const editor = loadedEditor('```\nfoo\n```');
+    Transforms.select(editor, Editor.end(editor, [0]));
+    Transforms.insertText(editor, 'js');
+    expect([textOf(editor), langsOf(editor)]).toEqual(['```js\nfoo\n```', ['', 'js', '']]);
+  });
+
+  it('marks which fence lines start inside a code block once a fence typed above them opens one', () => {
+    const editor = loadedEditor('a\n```\n```');
+    const before = (editor.children as Element[]).map((child) => child.startCodeBlock);
+    Transforms.select(editor, Editor.end(editor, [0]));
+    Transforms.insertText(editor, '```');
+    const after = (editor.children as Element[]).map((child) => child.startCodeBlock);
+    expect([textOf(editor), typesOf(editor), before, after])
+      .toEqual(['a```\n```\n```', ['div', 'div', 'div'], [false, false, true], [false, true, false]]);
+  });
+
+  it('writes no text to the lines a typed multi-line quote marker takes in', () => {
+    const editor = loadedEditor('a\n> b\nc');
+    Transforms.select(editor, Editor.start(editor, [0]));
+    Transforms.insertText(editor, '>>> ');
+    const textWrites = editor.operations.filter((op) => op.type !== 'set_node' && op.type !== 'set_selection');
+    expect([textOf(editor), new Set(textWrites.map((op) => (op as { path: number[] }).path[0]))])
+      .toEqual(['>>> a\n> b\nc', new Set([0])]);
+  });
+
+  it('starts a quoted line with no marker when a line of a multi-line quote is split', () => {
+    const editor = loadedEditor('>>> ab');
+    Transforms.select(editor, { path: [0, 0], offset: 1 });
+    editor.insertBreak();
+    expect([textOf(editor), typesOf(editor)]).toEqual(['>>> a\nb', ['blockQuote', 'blockQuote']]);
+  });
+
+  it('keeps the lines after a code block holding a multi-line quote marker as plain lines', () => {
+    const editor = loadedEditor('```\n>>> a\n```\nb');
+    Editor.normalize(editor, { force: true });
+    expect(typesOf(editor)).toEqual(['div', 'codeBlock', 'div', 'div']);
+  });
+
+  it('keeps a later multi-line quote marker when a multi-line quote is opened above it', () => {
+    const editor = loadedEditor('a\n>>> c');
+    Transforms.select(editor, Editor.start(editor, [0]));
+    Transforms.insertText(editor, '>>> ');
+    expect(textOf(editor)).toBe('>>> a\n>>> c');
+  });
+
+  it('makes the lines after a removed multi-line quote marker plain lines', () => {
+    const editor = loadedEditor('>>> a\nb');
+    Transforms.select(editor, Editor.start(editor, [0]));
+    pressBackspace(editor);
+    expect([textOf(editor), typesOf(editor)]).toEqual(['a\nb', ['div', 'div']]);
+  });
+});
