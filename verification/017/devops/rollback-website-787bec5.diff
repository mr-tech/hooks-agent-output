+function dialogOf(title: string) {
+  const found = Array.from(document.body.querySelectorAll<HTMLElement>('[role="dialog"]'))
+    .find((d) => d.textContent?.includes(title));
+  expect(found, `no dialog titled "${title}"`).toBeTruthy();
+  return found as HTMLElement;
+}
+
+function buttonOf(title: string, text: string) {
+  const found = Array.from(dialogOf(title).querySelectorAll('button'))
+    .find((b) => b.textContent?.includes(text) || b.getAttribute('aria-label')?.includes(text));
+  expect(found, `no "${text}" button in "${title}"`).toBeTruthy();
+  return found as HTMLElement;
+}
+
+function textOf(title: string) {
+  const found = Array.from(dialogOf(title).querySelectorAll<HTMLElement>('p'))[0];
+  found.tabIndex = -1;
+  return found;
+}
+
+function bodyWrapperOf(title: string) {
+  const footer = buttonOf(title, 'Cancel').parentElement as HTMLElement;
+  return footer.parentElement as HTMLElement;
+}
+
+function focusAndCheck(el: HTMLElement) {
+  act(() => { el.focus(); });
+  expect(document.activeElement).toBe(el);
+}
+
+async function mountWarning({ withUpdate }: { withUpdate: boolean }) {
+  mountDom(
+    <ConfirmationProvider>
+      <Capture />
+      <WarningDialog
+        title={WARNING}
+        message="This will delete the field."
+        open
+        confirmText="Delete"
+        onClose={calls.warnClose}
+        onConfirm={calls.warnConfirm}
+      />
+      {withUpdate ? <ConfirmationDialog /> : null}
+    </ConfirmationProvider>,
+  );
+  await act(async () => {});
+  if (withUpdate) {
+    act(() => { raise(); });
+    await act(async () => {});
+  }
+}
+
+let setOpen: (open: boolean) => void = () => undefined;
+
+const ClosableWarning = () => {
+  const [open, set] = useState(true);
+  setOpen = set;
+  return (
+    <WarningDialog
+      title={WARNING}
+      message="This will delete the field."
+      open={open}
+      confirmText="Delete"
+      onClose={calls.warnClose}
+      onConfirm={calls.warnConfirm}
+    />
+  );
+};
+
+const counts = () => ({
+  warnConfirm: calls.warnConfirm.mock.calls.length,
+  warnClose: calls.warnClose.mock.calls.length,
+  updateConfirm: calls.updateConfirm.mock.calls.length,
+});
+
+beforeEach(() => {
+  Object.values(calls).forEach((c) => c.mockClear());
+});
+afterEach(() => {
+  unmountDom();
+});
+
+describe('WarningDialog, the Enter key', () => {
+  describe('alone', () => {
+    it.each([
+      ['its dialog element', () => dialogOf(WARNING), { warnConfirm: 1, warnClose: 0 }],
+      ['its message text', () => textOf(WARNING), { warnConfirm: 1, warnClose: 0 }],
+      ['its close button', () => buttonOf(WARNING, 'close modal'), { warnConfirm: 0, warnClose: 1 }],
+      ['Cancel', () => buttonOf(WARNING, 'Cancel'), { warnConfirm: 0, warnClose: 1 }],
+      ['the confirm button', () => buttonOf(WARNING, 'Delete'), { warnConfirm: 1, warnClose: 1 }],
+    ])('with focus on %s runs only what that control does', async (_name, target, expected) => {
+      await mountWarning({ withUpdate: false });
+      focusAndCheck(target());
+
+      enter();
+
+      expect(counts()).toEqual({ ...expected, updateConfirm: 0 });
+    });
+
+    it('answers nothing while its panel is still leaving after it is closed', async () => {
+      mountDom(<ClosableWarning />);
+      await act(async () => {});
+      focusAndCheck(dialogOf(WARNING));
+      act(() => { setOpen(false); });
+      expect(dialogOf(WARNING).contains(document.activeElement)).toBe(true);
+
+      enter();
+
+      expect(counts()).toEqual({ warnConfirm: 0, warnClose: 0, updateConfirm: 0 });
+    });
+
+    it('answers nothing once closed', async () => {
+      mountDom(
+        <WarningDialog
+          title={WARNING}
+          message="This will delete the field."
+          open={false}
+          confirmText="Delete"
+          onClose={calls.warnClose}
+          onConfirm={calls.warnConfirm}
+        />,
+      );
+      await act(async () => {});
+
+      enter();
+
+      expect(counts()).toEqual({ warnConfirm: 0, warnClose: 0, updateConfirm: 0 });
+    });
+  });
+
+  describe('beside the editor\'s update prompt', () => {
+    it.each([
+      ['its dialog element', () => dialogOf(UPDATE)],
+      ['its message text', () => textOf(UPDATE)],
+    ])('answers only the update prompt with focus on %s', async (_name, target) => {
+      await mountWarning({ withUpdate: true });
+      focusAndCheck(target());
+
+      enter();
+
+      expect(counts()).toEqual({ warnConfirm: 0, warnClose: 0, updateConfirm: 1 });
+      expect(document.body.textContent).toContain(WARNING);
+    });
+
+    it.each([
+      ['its dialog element', () => dialogOf(WARNING)],
+      ['its message text', () => textOf(WARNING)],
+    ])('answers only the warning with focus on %s', async (_name, target) => {
+      await mountWarning({ withUpdate: true });
+      focusAndCheck(target());
+
+      enter();
+
+      expect(counts()).toEqual({ warnConfirm: 1, warnClose: 0, updateConfirm: 0 });
+      expect(document.body.textContent).toContain(UPDATE);
+    });
+
+    it('answers only the update prompt\'s Reload with focus on it', async () => {
+      await mountWarning({ withUpdate: true });
+      focusAndCheck(buttonOf(UPDATE, 'Reload'));
+
+      enter();
+
+      expect(counts()).toEqual({ warnConfirm: 0, warnClose: 0, updateConfirm: 1 });
+    });
+
+    it('leaves the warning answerable on its own after the update prompt is answered', async () => {
+      await mountWarning({ withUpdate: true });
+      focusAndCheck(dialogOf(UPDATE));
+      enter();
+      await vi.waitFor(async () => {
+        await act(async () => {});
+        expect(document.body.textContent).not.toContain(UPDATE);
+      });
+
+      focusAndCheck(dialogOf(WARNING));
+      enter();
+
+      expect(counts()).toEqual({ warnConfirm: 1, warnClose: 0, updateConfirm: 1 });
+    });
+  });
+});
+
+describe('WarningDialog and ConfirmationDialog, the body inside the panel', () => {
+  it.each([
+    ['WarningDialog', WARNING],
+    ['ConfirmationDialog', UPDATE],
+  ])('%s keeps its message and its footer in one wrapper that takes no box of its own, so the panel\'s layout spaces them', async (_name, title) => {
+    await mountWarning({ withUpdate: true });
+
+    const wrapper = bodyWrapperOf(title);
+
+    expect(wrapper.classList.contains('contents')).toBe(true);
+    expect(wrapper.contains(dialogOf(title).querySelector('p'))).toBe(true);
+  });
+});
