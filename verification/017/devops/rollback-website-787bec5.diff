@@ -0,0 +1,476 @@
+import { act, useEffect, useState } from 'react';
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import NavigationGuardProvider, { useNavigationGuard } from '../NavigationGuardProvider';
+
+import type { NavigationGuard } from '../NavigationGuardProvider';
+
+import ConfirmationDialog from '~/components/ConfirmationDialog';
+import StyledLink from '~/components/StyledLink';
+import click from '~/components/__tests__/helpers/click';
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+import press from '~/components/__tests__/helpers/press';
+import { createLinkRouter, WithLinkRouter } from '~/components/__tests__/helpers/linkNavigation';
+import ConfirmationProvider, { useConfirmation } from '~/providers/ConfirmationProvider';
+import { isLeavingWithoutAlert } from '~/utils/leaveWithoutAlert';
+
+const hoisted = vi.hoisted(() => ({ push: vi.fn(), replace: vi.fn() }));
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({ push: hoisted.push, replace: hoisted.replace }),
+}));
+
+const TITLE = 'You have unsaved changes!';
+const ORIGIN = { protocol: 'http:', hostname: 'localhost', port: '3000' };
+const assigned = vi.fn();
+const replaced = vi.fn();
+const leavingAtAssign = vi.fn();
+const leavingAtReplace = vi.fn();
+let linkRouter: ReturnType<typeof createLinkRouter>;
+const OLDER_LETS_THROUGH: NavigationGuard = () => false;
+const NEWER_HOLDS: NavigationGuard = () => true;
+
+const Registers: FC<{ guard: NavigationGuard }> = ({ guard }) => {
+  const { register } = useNavigationGuard();
+  useEffect(() => register(guard), [register, guard]);
+  return null;
+};
+
+function link(text: string) {
+  return Array.from(document.body.querySelectorAll('a')).find((a) => a.textContent === text) as HTMLAnchorElement;
+}
+
+function dialogButton(text: string, title?: string) {
+  const scope = title === undefined
+    ? document.body
+    : Array.from(document.body.querySelectorAll('[role="dialog"]')).find((d) => d.textContent?.includes(title)) as HTMLElement;
+  const button = Array.from(scope?.querySelectorAll('button') ?? []).find((b) => b.textContent?.includes(text));
+  expect(button, `no "${text}" button in the dialog${title === undefined ? '' : ` titled "${title}"`}`).toBeTruthy();
+  return button as HTMLElement;
+}
+
+type LinkSpec = [string, Record<string, unknown>?];
+
+function mountGuarded(guard: NavigationGuard | null, ...links: LinkSpec[]) {
+  mountDom(
+    <WithLinkRouter router={linkRouter}>
+      <NavigationGuardProvider>
+        {guard && <Registers guard={guard} />}
+        {links.map(([href, props]) => (
+          <StyledLink key={href} href={href} {...props}>{`go ${href}`}</StyledLink>
+        ))}
+      </NavigationGuardProvider>
+    </WithLinkRouter>,
+  );
+}
+
+beforeEach(() => {
+  assigned.mockReset();
+  replaced.mockReset();
+  leavingAtAssign.mockReset();
+  leavingAtReplace.mockReset();
+  vi.stubGlobal('location', {
+    ...ORIGIN,
+    origin: 'http://localhost:3000',
+    href: 'http://localhost:3000/message/m/1/edit',
+    assign: (href: string) => { leavingAtAssign(isLeavingWithoutAlert()); assigned(href); },
+    replace: (href: string) => { leavingAtReplace(isLeavingWithoutAlert()); replaced(href); },
+  });
+  hoisted.push.mockClear();
+  hoisted.replace.mockClear();
+  linkRouter = createLinkRouter();
+});
+afterEach(() => {
+  vi.unstubAllGlobals();
+  unmountDom();
+});
+
+describe('StyledLink under the navigation guard', () => {
+  it('navigates with no prompt when no guard is registered', () => {
+    mountGuarded(null, ['/message/f/0']);
+
+    click(link('go /message/f/0'));
+
+    expect(linkRouter.push).toHaveBeenCalledTimes(1);
+    expect(document.body.textContent).not.toContain(TITLE);
+  });
+
+  it('navigates with no prompt when the registered guard lets the destination through', () => {
+    mountGuarded(() => false, ['/message/f/0']);
+
+    click(link('go /message/f/0'));
+
+    expect(linkRouter.push).toHaveBeenCalledTimes(1);
+    expect(document.body.textContent).not.toContain(TITLE);
+  });
+
+  it('asks first, and does not navigate, when the guard holds the destination', () => {
+    mountGuarded(() => true, ['/message/f/0']);
+
+    click(link('go /message/f/0'));
+
+    expect(document.body.textContent).toContain(TITLE);
+    expect(linkRouter.push).not.toHaveBeenCalled();
+    expect(hoisted.push).not.toHaveBeenCalled();
+  });
+
+  it('hands the guard the destination of the clicked link', () => {
+    const guard = vi.fn(() => true);
+    mountGuarded(guard, ['/message/f/0'], ['/message/m/12/edit']);
+
+    click(link('go /message/m/12/edit'));
+
+    expect(guard).toHaveBeenCalledExactlyOnceWith('/message/m/12/edit');
+  });
+
+  it('asks for a link activated from the keyboard, a click with no pointer detail', () => {
+    mountGuarded(() => true, ['/message/f/0']);
+
+    click(link('go /message/f/0'), { detail: 0 });
+
+    expect(document.body.textContent).toContain(TITLE);
+    expect(linkRouter.push).not.toHaveBeenCalled();
+  });
+
+  it('keeps the user on the page when the prompt is cancelled', async () => {
+    mountGuarded(() => true, ['/message/f/0']);
+    click(link('go /message/f/0'));
