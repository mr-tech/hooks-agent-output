+import { RouterContext } from 'next/dist/shared/lib/router-context.shared-runtime';
+import { vi } from 'vitest';
+
+import type { NextRouter } from 'next/router';
+import type { ReactNode } from 'react';
+
+export function createLinkRouter() {
+  return { push: vi.fn(), replace: vi.fn(), prefetch: vi.fn(() => Promise.resolve()) };
+}
+
+export const WithLinkRouter = ({ router, children }: {
+  router: ReturnType<typeof createLinkRouter>;
+  children: ReactNode;
+}) => <RouterContext.Provider value={router as unknown as NextRouter}>{children}</RouterContext.Provider>;
