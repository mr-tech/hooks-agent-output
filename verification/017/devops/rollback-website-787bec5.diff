+import { act, useState } from 'react';
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import ConfirmationDialog from '../ConfirmationDialog';
+import ImageUploader from '../ImageUploader';
+
+import enter from './helpers/enter';
+import { mountDom, unmountDom } from './helpers/dom';
+
+import ConfirmationProvider, { useConfirmation } from '~/providers/ConfirmationProvider';
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+
+const IMAGE_TITLE = 'Enter Image URL';
+const UPDATE = 'Message Update Detected';
+const URL_A = 'https://example.com/a.png';
+
+class FakeImage {
+  width = 1;
+
+  onload: (() => void) | null = null;
+
+  onerror: (() => void) | null = null;
+
+  set src(_url: string) {
+    queueMicrotask(() => this.onload?.());
+  }
+}
+
+const calls = {
+  close: vi.fn(),
+  setImage: vi.fn(),
+  otherClose: vi.fn(),
+  otherSetImage: vi.fn(),
+  updateConfirm: vi.fn(),
+};
+let raise: () => void = () => undefined;
+
+const Capture = () => {
+  const { showConfirmation } = useConfirmation();
+  raise = () => showConfirmation({
+    enabled: true,
+    title: UPDATE,
+    message: 'This message was saved in another tab.',
+    confirmText: 'Reload',
+    onConfirm: calls.updateConfirm,
+  });
+  return null;
+};
+
+function dialogs(title: string) {
+  return Array.from(document.body.querySelectorAll<HTMLElement>('[role="dialog"]'))
+    .filter((d) => d.textContent?.includes(title));
+}
+
+function dialogOf(title: string, index = 0) {
+  const found = dialogs(title)[index];
+  expect(found, `no dialog titled "${title}" at ${index}`).toBeTruthy();
+  return found;
+}
+
+function controlOf(root: HTMLElement, text: string) {
+  const found = Array.from(root.querySelectorAll<HTMLElement>('button'))
+    .find((b) => b.textContent?.includes(text) || b.getAttribute('aria-label')?.includes(text));
+  expect(found, `no "${text}" button`).toBeTruthy();
+  return found as HTMLElement;
+}
+
+function messageTextOf(title: string) {
+  const found = Array.from(dialogOf(title).querySelectorAll<HTMLElement>('p'))[0];
+  found.tabIndex = -1;
+  return found;
+}
+
+function bodyWrapperOf(title: string) {
+  const footer = controlOf(dialogOf(title), 'Cancel').parentElement as HTMLElement;
+  return footer.parentElement as HTMLElement;
+}
+
+function typeInto(input: HTMLInputElement, value: string) {
+  act(() => {
+    Reflect.set(HTMLInputElement.prototype, 'value', value, input);
+    input.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+}
+
+function focusAndCheck(el: HTMLElement) {
+  act(() => { el.focus(); });
+  expect(document.activeElement).toBe(el);
+}
+
+const counts = () => ({
+  close: calls.close.mock.calls.length,
+  setImage: calls.setImage.mock.calls.length,
+  otherClose: calls.otherClose.mock.calls.length,
+  otherSetImage: calls.otherSetImage.mock.calls.length,
+  updateConfirm: calls.updateConfirm.mock.calls.length,
+});
+const NOTHING = {
+  close: 0, setImage: 0, otherClose: 0, otherSetImage: 0, updateConfirm: 0,
+};
+
+let setOpen: (open: boolean) => void = () => undefined;
+
+const ClosableUploader = () => {
+  const [open, set] = useState(true);
+  setOpen = set;
+  return (
+    <ImageUploader isOpen={open} image={URL_A} onClose={calls.close} setImage={calls.setImage} />
+  );
+};
+
+async function mountUploader({ image, withUpdate }: { image?: string, withUpdate: boolean }) {
+  mountDom(
+    <ConfirmationProvider>
+      <Capture />
+      <ImageUploader isOpen image={image} onClose={calls.close} setImage={calls.setImage} />
+      {withUpdate ? <ConfirmationDialog /> : null}
+    </ConfirmationProvider>,
+  );
+  await act(async () => {});
+  if (withUpdate) {
+    act(() => { raise(); });
+    await act(async () => {});
+  }
+}
+
+beforeEach(() => {
+  vi.stubGlobal('Image', FakeImage);
+  Object.values(calls).forEach((c) => c.mockClear());
+});
+afterEach(() => {
+  unmountDom();
+  vi.unstubAllGlobals();
+});
+
+describe('ImageUploader, the Enter key', () => {
+  describe('alone, with an image loaded', () => {
+    it.each([
+      ['its dialog element', () => dialogOf(IMAGE_TITLE), { close: 1, setImage: 1 }],
+      ['its URL field', () => dialogOf(IMAGE_TITLE).querySelector('input') as HTMLElement, {}],
+      ['its close button', () => controlOf(dialogOf(IMAGE_TITLE), 'close modal'), { close: 1 }],
+      ['Cancel', () => controlOf(dialogOf(IMAGE_TITLE), 'Cancel'), { close: 1 }],
+      ['Clear', () => controlOf(dialogOf(IMAGE_TITLE), 'Clear'), {}],
+      ['Save', () => controlOf(dialogOf(IMAGE_TITLE), 'Save'), { close: 1, setImage: 1 }],
+    ])('with focus on %s runs only what that control does', async (_name, target, expected) => {
+      await mountUploader({ image: URL_A, withUpdate: false });
+      await act(async () => {});
+      focusAndCheck(target());
+
+      enter();
+
+      expect(counts()).toEqual({ ...NOTHING, ...expected });
+    });
+
+    it('sets the loaded image when Enter is pressed with focus off its buttons', async () => {
+      await mountUploader({ image: URL_A, withUpdate: false });
+      await act(async () => {});
+      focusAndCheck(dialogOf(IMAGE_TITLE));
+
+      enter();
+
+      expect(calls.setImage).toHaveBeenCalledWith(URL_A);
+    });
+  });
+
+  describe('alone, with no image loaded', () => {
+    it('sets an image that loaded after the dialog opened when Enter is pressed off its buttons', async () => {
+      await mountUploader({ image: undefined, withUpdate: false });
+      typeInto(dialogOf(IMAGE_TITLE).querySelector('input') as HTMLInputElement, URL_A);
+      await act(async () => {});
+      await act(async () => {});
+      focusAndCheck(dialogOf(IMAGE_TITLE));
+
+      enter();
+
+      expect(calls.setImage).toHaveBeenCalledWith(URL_A);
+      expect(counts()).toEqual({ ...NOTHING, close: 1, setImage: 1 });
+    });
+
+    it.each([
+      ['its dialog element', () => dialogOf(IMAGE_TITLE), {}],
+      ['its URL field', () => dialogOf(IMAGE_TITLE).querySelector('input') as HTMLElement, {}],
+      ['its close button', () => controlOf(dialogOf(IMAGE_TITLE), 'close modal'), { close: 1 }],
+      ['Cancel', () => controlOf(dialogOf(IMAGE_TITLE), 'Cancel'), { close: 1 }],
+    ])('with focus on %s runs only what that control does', async (_name, target, expected) => {
+      await mountUploader({ image: undefined, withUpdate: false });
+      focusAndCheck(target());
+
+      enter();
+
+      expect(counts()).toEqual({ ...NOTHING, ...expected });
+    });
+  });
+
+  describe('while its panel is still leaving after it is closed', () => {
+    it('answers nothing, with focus still inside the visible panel', async () => {
+      mountDom(<ClosableUploader />);
+      await act(async () => {});
+      await act(async () => {});
+      focusAndCheck(dialogOf(IMAGE_TITLE));
+      act(() => { setOpen(false); });
+      expect(dialogOf(IMAGE_TITLE).contains(document.activeElement)).toBe(true);
+
+      enter();
+
+      expect(counts()).toEqual(NOTHING);
+    });
+  });
+
+  describe('beside the editor\'s update prompt, with an image loaded', () => {
+    it.each([
+      ['its dialog element', () => dialogOf(UPDATE)],
+      ['its message text', () => messageTextOf(UPDATE)],
+    ])('answers only the update prompt with focus on %s', async (_name, target) => {
+      await mountUploader({ image: URL_A, withUpdate: true });
+      await act(async () => {});
+      focusAndCheck(target());
+
+      enter();
+
+      expect(counts()).toEqual({ ...NOTHING, updateConfirm: 1 });
+      expect(dialogs(IMAGE_TITLE)).toHaveLength(1);
+    });
+
+    it('answers only the image dialog with focus on its dialog element', async () => {
+      await mountUploader({ image: URL_A, withUpdate: true });
+      await act(async () => {});
+      focusAndCheck(dialogOf(IMAGE_TITLE));
+
+      enter();
