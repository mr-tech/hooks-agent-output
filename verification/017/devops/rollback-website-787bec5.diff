diff --git a/src/app/_components/__tests__/NavMenu.navigation-guard.test.tsx b/src/app/_components/__tests__/NavMenu.navigation-guard.test.tsx
new file mode 100644
index 0000000..7d8b703
--- /dev/null
+++ b/src/app/_components/__tests__/NavMenu.navigation-guard.test.tsx
@@ -0,0 +1,102 @@
+import { useEffect } from 'react';
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import NavMenu from '../NavMenu';
+
+import click from '~/components/__tests__/helpers/click';
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+import { createLinkRouter, WithLinkRouter } from '~/components/__tests__/helpers/linkNavigation';
+import press from '~/components/__tests__/helpers/press';
+import NavigationGuardProvider, { useNavigationGuard } from '~/providers/NavigationGuardProvider';
+
+const hoisted = vi.hoisted(() => ({ push: vi.fn(), assign: vi.fn() }));
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+vi.mock('next/navigation', () => ({ useRouter: () => ({ push: hoisted.push, replace: () => undefined }) }));
+vi.mock('next-auth/react', () => ({
+  useSession: () => ({ data: { user: { name: 'someone' } } }),
+  signIn: () => undefined,
+  signOut: () => undefined,
+}));
+vi.mock('next/image', () => ({ default: () => null }));
+
+const TITLE = 'You have unsaved changes!';
+let linkRouter: ReturnType<typeof createLinkRouter>;
+
+const Holds: FC = () => {
+  const { register } = useNavigationGuard();
+  useEffect(() => register(() => true), [register]);
+  return null;
+};
+
+function open() {
+  mountDom(
+    <WithLinkRouter router={linkRouter}>
+      <NavigationGuardProvider>
+        <Holds />
+        <NavMenu />
+      </NavigationGuardProvider>
+    </WithLinkRouter>,
+  );
+  press(document.body.querySelector('button[aria-label="user menu"]') as HTMLElement);
+}
+
+function item(text: string) {
+  const found = Array.from(document.body.querySelectorAll('a')).find((a) => a.textContent?.includes(text));
+  expect(found, `no menu link "${text}"`).toBeTruthy();
+  return found as HTMLAnchorElement;
+}
+
+const prompted = () => document.body.textContent?.includes(TITLE) ?? false;
+
+beforeEach(() => {
+  linkRouter = createLinkRouter();
+  hoisted.push.mockClear();
+  hoisted.assign.mockClear();
+  vi.stubGlobal('location', {
+    protocol: 'http:',
+    hostname: 'localhost',
+    port: '3000',
+    origin: 'http://localhost:3000',
+    href: 'http://localhost:3000/message/m/1/edit',
+    assign: hoisted.assign,
+  });
+});
+afterEach(() => {
+  vi.unstubAllGlobals();
+  unmountDom();
+});
+
+describe('NavMenu, its links away from an editor with unsaved changes', () => {
+  it.each([
+    ['Create Message', '/message/m/new'],
+    ['Servers', '/message'],
+  ])('asks before %s leaves the page', (text, href) => {
+    open();
+    expect(item(text).getAttribute('href')).toBe(href);
+
+    click(item(text));
+
+    expect(prompted()).toBe(true);
+    expect(linkRouter.push).not.toHaveBeenCalled();
+  });
+
+  it('asks before Invite Bot, a link to another site, leaves the page', () => {
+    open();
+
+    click(item('Invite Bot'));
+
+    expect(prompted()).toBe(true);
+    expect(hoisted.assign).not.toHaveBeenCalled();
+  });
+
+  it('does not ask for Support, which opens a new tab', () => {
+    open();
+
+    click(item('Support'));
+
+    expect(prompted()).toBe(false);
+  });
+});
diff --git a/src/app/_components/__tests__/NavMenu.sign-in-and-out.test.tsx b/src/app/_components/__tests__/NavMenu.sign-in-and-out.test.tsx
new file mode 100644
index 0000000..59f67c9
--- /dev/null
+++ b/src/app/_components/__tests__/NavMenu.sign-in-and-out.test.tsx
@@ -0,0 +1,84 @@
+import { act } from 'react';
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import NavMenu from '../NavMenu';
+
+import type { ReactNode } from 'react';
+
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+import { isLeavingWithoutAlert } from '~/utils/leaveWithoutAlert';
+
+type Item = { key?: string, onPress?: unknown } | null;
+
+const hoisted = vi.hoisted(() => ({
+  signedIn: false,
+  signIn: vi.fn(),
+  signOut: vi.fn(),
+  leavingDuring: undefined as boolean | undefined,
+}));
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+vi.mock('next-auth/react', () => ({
+  useSession: () => ({ data: hoisted.signedIn ? { user: { name: 'someone' } } : null }),
+  signIn: hoisted.signIn,
+  signOut: hoisted.signOut,
+}));
+vi.mock('next/image', () => ({ default: () => null }));
+vi.mock('~/components/Dropdown', () => ({
+  default: ({ items }: { items: Item[] }): ReactNode => (
+    <div>
+      {items.map((item) => (item && typeof item.onPress === 'function'
+        ? <button type="button" key={item.key} data-key={item.key} onClick={item.onPress as () => void}>{item.key}</button>
+        : null))}
+    </div>
+  ),
+}));
+
+let finish: () => void = () => undefined;
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  hoisted.signedIn = false;
+  hoisted.leavingDuring = undefined;
+  const pending = (): Promise<void> => new Promise((resolve) => {
+    hoisted.leavingDuring = isLeavingWithoutAlert();
+    finish = resolve;
+  });
+  hoisted.signIn.mockReset().mockImplementation(pending);
+  hoisted.signOut.mockReset().mockImplementation(pending);
+});
+
+afterEach(() => {
+  unmountDom();
+  act(() => { vi.runAllTimers(); });
+  vi.useRealTimers();
+});
+
+const pressLog = async () => {
+  const container = mountDom(<NavMenu />);
+  await act(async () => {
+    (container.querySelector('[data-key="log"]') as HTMLButtonElement).click();
+  });
+};
+
+describe('NavMenu, the log in and log out item', () => {
+  it('signs in without the unsaved-changes prompt when signed out', async () => {
+    await pressLog();
+
+    expect(hoisted.signIn).toHaveBeenCalledTimes(1);
+    expect(hoisted.leavingDuring).toBe(true);
+    await act(async () => { finish(); });
+  });
+
+  it('signs out with the unsaved-changes prompt when signed in', async () => {
+    hoisted.signedIn = true;
+
+    await pressLog();
+
+    expect(hoisted.signOut).toHaveBeenCalledTimes(1);
+    expect(hoisted.leavingDuring).toBe(false);
+    await act(async () => { finish(); });
+  });
+});
