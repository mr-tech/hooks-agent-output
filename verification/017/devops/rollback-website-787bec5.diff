index 0000000..ffc45cb
--- /dev/null
+++ b/src/server/api/utils/previewImage.ts
@@ -0,0 +1,126 @@
+import { randomBytes } from 'crypto';
+import { DeleteObjectsCommand, ListObjectsCommand } from '@aws-sdk/client-s3';
+import { sql } from 'kysely';
+import { getPostgres } from 'project-utils';
+
+import { getS3, previewKey, previewPrefix } from './previewBucket';
+
+import type { Kysely } from 'kysely';
+import type { DatabaseSchema } from 'project-utils';
+
+import { env } from '~/env.mjs';
+
+export const PREVIEW_ANSWER_TIMEOUT_MS = 40_000;
+export const SWEEP_AGE_MS = 120_000;
+export const PREVIEW_FAILURE_PREFIX = 'preview-image-failure';
+
+export const mintNonce = (clockMicros: string) => `v${clockMicros.padStart(16, '0')}${randomBytes(8).toString('hex')}`;
+
+export const buildCommitPreviewNonceQuery = (
+  database: Kysely<DatabaseSchema>,
+  id: string,
+  nonce: string,
+) => database
+  .with('replaced', (qb) => qb
+    .selectFrom('Messages')
+    .select('previewImageNonce as prev')
+    .where('id', '=', id)
+    .forUpdate())
+  .updateTable('Messages')
+  .from('replaced')
+  .set({ previewImageNonce: nonce })
+  .where('Messages.id', '=', id)
+  .where((eb) => eb.or([
+    eb('Messages.previewImageNonce', 'is', null),
+    sql<boolean>`"Messages"."previewImageNonce" collate "C" < ${nonce}`,
+  ]))
+  .returning('replaced.prev');
+
+type FailureClass = 'status-500' | 'status-404' | 'status-other' | 'network-error' | 'no-answer-within-T';
+
+const logFailure = (id: string, failureClass: FailureClass, elapsedMs: number) => {
+  console.error(`${PREVIEW_FAILURE_PREFIX} id=${id} class=${failureClass} elapsedMs=${elapsedMs}`);
+};
+
+function failureClassOf(status: number): FailureClass {
+  if (status === 500) return 'status-500';
+  if (status === 404) return 'status-404';
+  return 'status-other';
+}
+
+async function requestPreview(
+  id: string,
+  nonce: string,
+  message: MessageData,
+): Promise<null | FailureClass> {
+  const controller = new AbortController();
+  let timedOut = false;
+  const timer = setTimeout(() => { timedOut = true; controller.abort(); }, PREVIEW_ANSWER_TIMEOUT_MS);
+
+  try {
+    const response = await fetch(env.PREVIEW_IMAGE_URL, {
+      method: 'POST',
+      body: JSON.stringify({ id, nonce, message }),
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: `Bearer ${env.PREVIEW_IMAGE_API_KEY}`,
+      },
+      signal: controller.signal,
+    });
+    return response.status === 204 ? null : failureClassOf(response.status);
+  } catch (_) {
+    return timedOut ? 'no-answer-within-T' : 'network-error';
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+async function deleteObjects(keys: string[]) {
+  if (!keys.length) return;
+  await getS3().send(new DeleteObjectsCommand({
+    Bucket: env.CDN_BUCKET,
+    Delete: { Objects: keys.map((Key) => ({ Key })) },
+  }));
+}
+
+async function sweepOlderObjects(id: string, committedKey: string) {
+  const { Contents } = await getS3().send(new ListObjectsCommand({
+    Bucket: env.CDN_BUCKET,
+    Prefix: previewPrefix(id),
+  }));
+  const committedAt = Contents?.find(({ Key }) => Key === committedKey)?.LastModified;
+  if (!committedAt) return;
+
+  await deleteObjects((Contents ?? [])
+    .filter(({ Key, LastModified }) => Key !== committedKey
+      && !!LastModified
+      && committedAt.getTime() - LastModified.getTime() >= SWEEP_AGE_MS)
+    .map(({ Key }) => Key as string));
+}
+
+export async function runPreviewContinuation({ id, nonce, message }: {
+  id: string;
+  nonce: string;
+  message: MessageData;
+}) {
+  const start = Date.now();
+  try {
+    const failure = await requestPreview(id, nonce, message);
+    if (failure) {
+      logFailure(id, failure, Date.now() - start);
+      return;
+    }
+
+    const committed = await buildCommitPreviewNonceQuery(getPostgres(), id, nonce).execute();
+    if (!committed.length) {
+      await deleteObjects([previewKey(id, nonce)]);
+      return;
+    }
+
+    const [{ prev }] = committed;
+    if (prev) await deleteObjects([previewKey(id, prev)]);
+    await sweepOlderObjects(id, previewKey(id, nonce));
+  } catch (err) {
+    console.error(err);
+  }
+}
