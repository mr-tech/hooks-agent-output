+import { act } from 'react';
+
+export default function click(el: Element, init: MouseEventInit = {}) {
+  act(() => {
+    el.dispatchEvent(new MouseEvent('click', {
+      bubbles: true, cancelable: true, button: 0, detail: 1, ...init,
+    }));
+  });
+}
