@@ -0,0 +1,111 @@
+import Pusher from 'pusher';
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import createCapturingDatabase from './helpers/capturingDatabase';
+
+import type { IncomingMessage } from '~/server/api/utils/shapes';
+
+import { upsertMessage } from '~/server/api/utils/shared';
+
+const hoisted = vi.hoisted(() => ({ db: undefined as unknown }));
+
+vi.mock('~/env.mjs', () => ({
+  env: new Proxy({}, { get: (_, key) => (String(key) === 'PUSHER_APP_ID' ? '1' : `test-${String(key)}`) }),
+}));
+vi.mock('project-utils', () => ({ getPostgres: () => hoisted.db }));
+vi.mock('@vercel/functions', () => ({ waitUntil: () => undefined }));
+
+interface PostedEvent { path: string, body: { name: string, channels: string[], data: unknown } }
+
+const posted: PostedEvent[] = [];
+
+const userSelect = { dbUserId: 'u1' };
+
+const messageWith = (content: string) => ({
+  id: '42',
+  name: 'n',
+  data: {
+    content, username: 'U', embeds: [], components: [],
+  },
+}) as unknown as IncomingMessage;
+
+beforeEach(() => {
+  posted.length = 0;
+  vi.spyOn(Pusher.prototype, 'post').mockImplementation(((options: PostedEvent) => {
+    posted.push(options);
+    return Promise.resolve({ status: 200 });
+  }) as never);
+  vi.stubGlobal('fetch', vi.fn(() => new Promise<never>(() => { void 0; })));
+  hoisted.db = createCapturingDatabase(({ sql }) => {
+    if (sql.startsWith('insert into "Guilds"')) return [{ id: 'guild-row' }];
+    if (sql.startsWith('select count(*)')) return [{ count: '0' }];
+    if (sql.startsWith('insert into "Messages"')) return [{ id: '42', savedAtMicros: '1763509200000000' }];
+    return [{
+      id: '42', createdAt: new Date(0), updatedAt: new Date(0), name: 'n', data: {}, previewImageNonce: null,
+    }];
+  }).db;
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+interface SubscriberEvent { event: string, channel: string, data: unknown }
+interface SubscriberProtocol { decodeMessage: (event: MessageEvent) => SubscriberEvent }
+
+const PROTOCOL_MODULE = 'pusher-js/src/core/connection/protocol/protocol';
+
+async function receivedBySubscriber(content: string) {
+  const { default: Protocol } = await import(PROTOCOL_MODULE) as { default: SubscriberProtocol };
+  posted.length = 0;
+  await upsertMessage(messageWith(content), userSelect);
+  expect(posted).toHaveLength(1);
+  const { body } = posted[0];
+  const frame = JSON.stringify({ event: body.name, channel: body.channels[0], data: body.data });
+  return Protocol.decodeMessage({ data: frame } as MessageEvent);
+}
+
+describe('the update broadcast of a saved message, as a subscriber decodes it', () => {
+  it('arrives once, on the message\'s channel, as a message-update event', async () => {
+    const event = await receivedBySubscriber('p0');
+
+    expect(event.event).toBe('message-update');
+    expect(event.channel).toBe('message-update-42');
+  });
+
+  it.each([
+    ['letters and digits', 'p0', '2cf29ca1'],
+    ['digits only', 'p29', '10942554'],
+    ['a minus sign and digits only', 'p44', '-47974433'],
+    ['digits, an e and 00', 'p855292', '51354e00'],
+    ['a minus sign, digits, an e and 02', 'p1129796', '-107e02'],
+    ['an exponent past what a double holds', 'p388', '7181e724'],
+    ['a minus sign and an exponent past what a double holds', 'p197', '-16e61940'],
+  ])('carries the exact hash string of the saved message when the hash has %s', async (_shape, content, hash) => {
+    const { data } = await receivedBySubscriber(content);
+
+    expect(typeof data).toBe('string');
+    expect(data).toBe(hash);
+  });
+
+  it.each([
+    ['one finite value', 'p855292', '51354e00', 'p1846206', '51354e0'],
+    ['Infinity', 'p388', '7181e724', 'p567', '47e81727'],
+    ['-Infinity', 'p197', '-16e61940', 'p226', '-6748e499'],
+  ])('keeps two saves apart whose hashes would both read as %s', async (_value, contentA, hashA, contentB, hashB) => {
+    const a = (await receivedBySubscriber(contentA)).data;
+    const b = (await receivedBySubscriber(contentB)).data;
+
+    expect(a).toBe(hashA);
+    expect(b).toBe(hashB);
+    expect(a).not.toBe(b);
+  });
+
+  it('is not sent for a message without an id', async () => {
+    await upsertMessage({ ...messageWith('p0'), id: undefined } as unknown as IncomingMessage, userSelect);
+
+    expect(posted).toHaveLength(0);
+  });
+});
