+
+      enter();
+
+      expect(counts()).toEqual({ ...NOTHING, updateConfirm: 1 });
+    });
+  });
+
+  describe('with two instances mounted, as the edit page mounts them', () => {
+    async function mountTwo({ firstOpen }: { firstOpen: boolean }) {
+      mountDom(
+        <>
+          <ImageUploader
+            isOpen={firstOpen}
+            image={URL_A}
+            onClose={calls.close}
+            setImage={calls.setImage}
+          />
+          <ImageUploader
+            isOpen={!firstOpen}
+            image={URL_A}
+            onClose={calls.otherClose}
+            setImage={calls.otherSetImage}
+          />
+        </>,
+      );
+      await act(async () => {});
+      await act(async () => {});
+    }
+
+    it('answers nothing from a closed instance, even with focus resting in its hidden dialog', async () => {
+      await mountTwo({ firstOpen: false });
+      const closed = Array.from(document.body.querySelectorAll<HTMLElement>('[role="dialog"]'))
+        .find((d) => d.hidden);
