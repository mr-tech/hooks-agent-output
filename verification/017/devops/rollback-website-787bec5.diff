+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import {
+  fakeFetch, settle, world,
+} from './helpers/previewWorld';
+
+import type { IncomingMessage } from '~/server/api/utils/shapes';
+
+import { upsertMessage } from '~/server/api/utils/shared';
+
+const hoisted = vi.hoisted(() => ({ waited: [] as Promise<unknown>[] }));
+
+vi.mock('~/env.mjs', async () => (await import('./helpers/previewWorld')).ENV_MODULE);
+vi.mock('@aws-sdk/client-s3', async () => (await import('./helpers/previewWorld')).S3_MODULE);
+vi.mock('project-utils', async () => {
+  const { world: w } = await import('./helpers/previewWorld');
+  return { getPostgres: () => w.db };
+});
+vi.mock('pusher', () => ({ default: class { trigger = vi.fn(async () => {}); } }));
+vi.mock('@vercel/functions', () => ({ waitUntil: (promise: Promise<unknown>) => { hoisted.waited.push(promise); } }));
+
+const data = {
+  content: 'Hi', username: 'U', embeds: [], components: [],
+};
+const PREVIOUS = 'a'.repeat(32);
+const CLOCK = '1763509200123456';
+const newMessage = { name: 'n', data } as unknown as IncomingMessage;
+const existingMessage = { ...newMessage, id: '42' } as IncomingMessage;
+const userSelect = { dbUserId: 'u1' };
+
+let order: string[];
+
+let insertParameters: readonly unknown[] = [];
+
+function useDatabase() {
+  world.other = ({ sql, parameters }) => {
+    if (sql.startsWith('insert into "Messages"')) insertParameters = parameters;
+    order.push(sql.split(' ').slice(0, 3).join(' '));
+    if (sql.startsWith('insert into "Guilds"')) return [{ id: 'guild-row' }];
+    if (sql.startsWith('select count(*)')) return [{ count: '0' }];
+    if (sql.startsWith('insert into "Messages"')) return [{ id: '42', savedAtMicros: CLOCK }];
+    return [{
+      id: '42', createdAt: new Date(0), updatedAt: new Date(0), name: 'n', data, previewImageNonce: PREVIOUS,
+    }];
+  };
+}
+
+beforeEach(() => {
+  hoisted.waited = [];
+  order = [];
+  world.reset({ nonce: PREVIOUS });
+  useDatabase();
+  vi.stubGlobal('fetch', (url: string, init: { body: string, headers: Record<string, string>, signal?: AbortSignal }) => {
+    order.push('fetch');
+    return fakeFetch(url, init);
+  });
+  vi.spyOn(console, 'error').mockImplementation(() => undefined);
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe('a save of an existing message', () => {
+  it('replies while the generator has not answered, with the nonce already committed', async () => {
+    const saved = await upsertMessage(existingMessage, userSelect);
+
+    expect(world.requests).toHaveLength(1);
+    expect(saved.previewImageNonce).toBe(PREVIOUS);
+    world.requests[0].answer.resolve({ status: 204 });
+    await Promise.all(hoisted.waited);
+  });
+
+  it('asks the generator only after its row is saved', async () => {
+    await upsertMessage(existingMessage, userSelect);
+
+    expect(order.indexOf('fetch')).toBeGreaterThan(order.indexOf('insert into "Messages"'));
+    world.requests[0].answer.resolve({ status: 204 });
+    await Promise.all(hoisted.waited);
+  });
+
+  it('hands the platform one promise that outlives the reply', async () => {
+    await upsertMessage(existingMessage, userSelect);
+
+    expect(hoisted.waited).toHaveLength(1);
+    world.requests[0].answer.resolve({ status: 204 });
+    await expect(hoisted.waited[0]).resolves.toBeUndefined();
+    expect(world.row.nonce).toMatch(/^v1763509200123456[0-9a-f]{16}$/);
+  });
+
+  it('sends the saved id and a nonce minted from the database clock the statement returned', async () => {
+    await upsertMessage(existingMessage, userSelect);
+
+    expect(world.requests[0].body.id).toBe('42');
+    expect(world.requests[0].body.nonce).toMatch(/^v1763509200123456[0-9a-f]{16}$/);
+    expect(world.requests[0].body.message).toEqual(data);
+    world.requests[0].answer.resolve({ status: 500 });
+    await Promise.all(hoisted.waited);
+  });
+
+  it('still saves when the generator fails, and keeps the stored nonce', async () => {
+    const saved = await upsertMessage(existingMessage, userSelect);
+    await settle();
+    world.requests[0].answer.resolve({ status: 500 });
+    await Promise.all(hoisted.waited);
+
+    expect(saved.id).toBe('42');
+    expect(world.row.nonce).toBe(PREVIOUS);
+  });
+
+  it('settles its promise without rejecting when the storage fails after a 204', async () => {
+    await upsertMessage(existingMessage, userSelect);
+    world.db = undefined;
+    world.requests[0].answer.resolve({ status: 204 });
+
+    await expect(hoisted.waited[0]).resolves.toBeUndefined();
+  });
+});
+
+describe('the saved row\'s id', () => {
+  it('is the id the client sent for an existing message', async () => {
+    await upsertMessage(existingMessage, userSelect);
+
+    expect(insertParameters).toContain('42');
+    world.requests[0].answer.resolve({ status: 204 });
+    await Promise.all(hoisted.waited);
+  });
+
+  it('is left to the database for a new message', async () => {
+    await upsertMessage(newMessage, userSelect);
+
+    expect(insertParameters).not.toContain('42');
+    world.requests[0].answer.resolve({ status: 204 });
+    await Promise.all(hoisted.waited);
+  });
+});
+
+describe('a save of a new message', () => {
+  it('asks the generator once, after the insert, for the id the insert returned', async () => {
+    await upsertMessage(newMessage, userSelect);
+
+    expect(world.requests).toHaveLength(1);
+    expect(order.indexOf('fetch')).toBeGreaterThan(order.indexOf('insert into "Messages"'));
+    expect(world.requests[0].body.id).toBe('42');
+    world.requests[0].answer.resolve({ status: 204 });
+    await Promise.all(hoisted.waited);
+  });
+});
