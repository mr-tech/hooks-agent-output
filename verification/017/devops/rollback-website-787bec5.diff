+
+const Guarded: FC<{ block: boolean }> = ({ block }) => {
+  useUnloadAlert(block);
+  return null;
+};
+
+const unloadIsPrompted = () => {
+  const event = new Event('beforeunload', { cancelable: true });
+  window.dispatchEvent(event);
+  return event.defaultPrevented;
+};
+
+beforeEach(() => { vi.useFakeTimers(); });
+afterEach(() => {
+  unmountDom();
+  vi.useRealTimers();
+});
+
+describe('useUnloadAlert and route changes', () => {
+  it('raises no confirmation on a route-change event while there are unsaved changes', () => {
+    const confirm = vi.spyOn(window, 'confirm').mockReturnValue(false);
+    mountDom(<Guarded block />);
+
+    expect(() => Router.events.emit('beforeHistoryChange', '/message/f/0')).not.toThrow();
+
+    expect(confirm).not.toHaveBeenCalled();
+    confirm.mockRestore();
+  });
+});
+
+describe('useUnloadAlert and the exits that lose nothing', () => {
+  it('prompts on unload while there are unsaved changes', () => {
+    mountDom(<Guarded block />);
+
+    expect(unloadIsPrompted()).toBe(true);
+  });
+
+  it('does not prompt when there are none', () => {
+    mountDom(<Guarded block={false} />);
+
+    expect(unloadIsPrompted()).toBe(false);
+  });
+
+  it('does not prompt while an exit that loses nothing is leaving the page', async () => {
+    mountDom(<Guarded block />);
+    let finish: () => void = () => undefined;
+    const leaving = leaveWithoutAlert(() => new Promise<void>((resolve) => { finish = resolve; }));
+
+    expect(unloadIsPrompted()).toBe(false);
+    finish();
+    await leaving;
+
+    expect(unloadIsPrompted()).toBe(false);
+  });
+
+  it('prompts again once the exit has had time to leave and the page is still here', async () => {
+    mountDom(<Guarded block />);
+
+    await leaveWithoutAlert(() => Promise.resolve());
+    act(() => { vi.advanceTimersByTime(5000); });
+
+    expect(unloadIsPrompted()).toBe(true);
+  });
+
+  it('prompts again at once when the exit fails', async () => {
+    mountDom(<Guarded block />);
+
+    await expect(leaveWithoutAlert(() => Promise.reject(new Error('blocked')))).rejects.toThrow('blocked');
+
+    expect(unloadIsPrompted()).toBe(true);
+  });
+
+  it('hands back what the exit returned', async () => {
+    await expect(leaveWithoutAlert(() => Promise.resolve('left'))).resolves.toBe('left');
+  });
+});
