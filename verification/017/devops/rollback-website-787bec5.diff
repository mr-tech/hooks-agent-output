+import {
+  DummyDriver, Kysely, PostgresAdapter, PostgresIntrospector, PostgresQueryCompiler,
+} from 'kysely';
+import {
+  describe, expect, it, vi,
+} from 'vitest';
+
+import type { DatabaseSchema } from 'project-utils';
+
+import { buildCommitPreviewNonceQuery, mintNonce } from '~/server/api/utils/previewImage';
+import { buildMessageValues, buildUpsertMessageQuery } from '~/server/api/utils/shared';
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+
+const database = new Kysely<DatabaseSchema>({
+  dialect: {
+    createAdapter: () => new PostgresAdapter(),
+    createDriver: () => new DummyDriver(),
+    createIntrospector: (db) => new PostgresIntrospector(db),
+    createQueryCompiler: () => new PostgresQueryCompiler(),
+  },
+});
+
+const data = {
+  content: 'Hi', username: 'U', embeds: [], components: [],
+};
+
+describe('the upsert statement no longer writes the preview nonce', () => {
+  const values = buildMessageValues({ name: 'n', data } as never, { dbUserId: 'u1' } as never);
+  const compiled = buildUpsertMessageQuery(database, values as never).compile();
+
+  it('names no nonce column in its insert or its conflict update', () => {
+    expect(compiled.sql).not.toMatch(/previewImageNonce/);
+  });
+
+  it('returns the message id and the database clock, read in the same statement', () => {
+    expect(compiled.sql).toMatch(/returning "id", \(extract\(epoch from clock_timestamp\(\)\) \* 1000000\)::bigint::text as "savedAtMicros"$/);
+  });
+});
+
+describe('the commit statement', () => {
+  const compiled = buildCommitPreviewNonceQuery(database, '42', 'vNEW').compile();
+
+  it('reads the nonce it replaces under the row lock', () => {
+    expect(compiled.sql).toMatch(/^with "replaced" as \(select "previewImageNonce" as "prev" from "Messages" where "id" = \$1 for update\) /);
+  });
+
+  it('moves the nonce only where the row has none or one that orders below, under collation C', () => {
+    expect(compiled.sql).toMatch(/"previewImageNonce" is null or "Messages"\."previewImageNonce" collate "C" < \$/);
+  });
+
+  it('updates the existing row and never inserts', () => {
+    expect(compiled.sql).toMatch(/update "Messages" set "previewImageNonce" = \$2 from "replaced" where "Messages"\."id" = \$3/);
+    expect(compiled.sql).not.toMatch(/insert/);
+  });
+
+  it('writes no other column', () => {
+    const setClause = compiled.sql.slice(compiled.sql.indexOf(' set '), compiled.sql.indexOf(' from "replaced"'));
+    expect(setClause).toBe(' set "previewImageNonce" = $2');
+  });
+
+  it('hands back the replaced nonce', () => {
+    expect(compiled.sql).toMatch(/returning "replaced"\."prev"$/);
+  });
+
+  it('carries the message id and the new nonce as parameters', () => {
+    expect(compiled.parameters).toEqual(['42', 'vNEW', '42', 'vNEW']);
+  });
+});
+
+describe('the ordered nonce', () => {
+  it('is v, the clock in microseconds to 16 digits, then 16 hex characters', () => {
+    expect(mintNonce('1763509200000000')).toMatch(/^v1763509200000000[0-9a-f]{16}$/);
+  });
+
+  it('pads a short clock to 16 digits', () => {
+    expect(mintNonce('7')).toMatch(/^v0000000000000007[0-9a-f]{16}$/);
+  });
+
+  it('draws the random part afresh on each call', () => {
+    expect(mintNonce('1763509200000000')).not.toBe(mintNonce('1763509200000000'));
+  });
+
+  it('sorts a later clock above an earlier one whatever the random parts are', () => {
+    const earlier = `v1763509200000000${'f'.repeat(16)}`;
+    const later = `v1763509200000001${'0'.repeat(16)}`;
+    expect(mintNonce('1763509200000001') > earlier).toBe(true);
+    expect(later > mintNonce('1763509200000000')).toBe(true);
+  });
+
+  it('sorts above every 32-character hex nonce an existing row may hold', () => {
+    expect(mintNonce('0') > 'f'.repeat(32)).toBe(true);
+  });
+});
diff --git a/src/server/api/utils/__tests__/previewImage.continuation-outcomes.test.ts b/src/server/api/utils/__tests__/previewImage.continuation-outcomes.test.ts
