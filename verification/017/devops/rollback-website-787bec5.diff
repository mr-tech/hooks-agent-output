+import {
+  afterEach, describe, expect, it, vi,
+} from 'vitest';
+
+import withLocalStorage from '../withLocalStorage';
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  window.localStorage.clear();
+});
+
+const refuseWrites = () => vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => {
+  throw new DOMException('The quota has been exceeded.', 'QuotaExceededError');
+});
+
+describe('withLocalStorage, the keys stored as before', () => {
+  it('reads a stored theme string unchanged, without a JSON parse', () => {
+    window.localStorage.setItem('theme', 'light');
+
+    expect(withLocalStorage('theme', 'dark').get()).toBe('light');
+  });
+
+  it('writes a theme as the bare string', () => {
+    withLocalStorage('theme', 'dark').set('light');
+
+    expect(window.localStorage.getItem('theme')).toBe('light');
+  });
+
+  it('reads a stored emoji list and writes it back as the same JSON string', () => {
+    const stored = '[{"id":"1","name":"a"}]';
+    window.localStorage.setItem('frequentlyUsedEmojis', stored);
+    const store = withLocalStorage('frequentlyUsedEmojis', []);
+
+    store.set(store.get());
+
+    expect(window.localStorage.getItem('frequentlyUsedEmojis')).toBe(stored);
+  });
+
+  it('reads stored client preferences and writes the same JSON string for the same value', () => {
+    const stored = '{"message_servers_order":"desc","message_servers_view":"list","message_f_order":"asc","message_f_sort":"name","message_f_view":"grid"}';
+    window.localStorage.setItem('client_preferences', stored);
+    const store = withLocalStorage('client_preferences', {} as ClientPreferences);
+
+    expect(store.get().message_f_sort).toBe('name');
+    store.set(store.get());
+
+    expect(window.localStorage.getItem('client_preferences')).toBe(stored);
+  });
+
+  it('tells the other tabs of the page with a storage event after a write that landed', () => {
+    const heard = vi.fn();
+    window.addEventListener('storage', heard);
+
+    withLocalStorage('theme', 'dark').set('light');
+    window.removeEventListener('storage', heard);
+
+    expect(heard).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe('withLocalStorage, a write the browser refuses', () => {
+  it('does not throw', () => {
+    refuseWrites();
+
+    expect(() => withLocalStorage('theme', 'dark').set('light')).not.toThrow();
+  });
+
+  it('reports that the write did not land', () => {
+    refuseWrites();
+
+    expect(withLocalStorage('theme', 'dark').set('light')).toBe(false);
+  });
+
+  it('dispatches no storage event for it', () => {
+    refuseWrites();
+    const heard = vi.fn();
+    window.addEventListener('storage', heard);
+
+    withLocalStorage('theme', 'dark').set('light');
+    window.removeEventListener('storage', heard);
+
+    expect(heard).not.toHaveBeenCalled();
+  });
+
+  it('reports that a write which landed did', () => {
+    expect(withLocalStorage('theme', 'dark').set('light')).toBe(true);
+  });
+});
