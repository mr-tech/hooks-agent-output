--- /dev/null
+++ b/src/server/api/utils/__tests__/previewImage.deletion-forms.test.ts
@@ -0,0 +1,202 @@
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import {
+  envValues, fakeFetch, settle, world,
+} from './helpers/previewWorld';
+
+import { runPreviewContinuation } from '~/server/api/utils/previewImage';
+
+vi.mock('~/env.mjs', async () => (await import('./helpers/previewWorld')).ENV_MODULE);
+vi.mock('@aws-sdk/client-s3', async () => (await import('./helpers/previewWorld')).S3_MODULE);
+vi.mock('project-utils', async () => {
+  const { world: w } = await import('./helpers/previewWorld');
+  return { getPostgres: () => w.db };
+});
+
+const N0 = 'a'.repeat(32);
+const N1 = 'v1763509200000001aaaaaaaaaaaaaaaa';
+const N2 = 'v1763509200000002bbbbbbbbbbbbbbbb';
+const message = {
+  content: 'Hi', username: 'U', embeds: [], components: [],
+} as unknown as MessageData;
+
+const key = (nonce: string, id = '42', dev = '') => `${dev}previews/${id}/${nonce}.jpeg`;
+const keys = () => [...world.objects.keys()].sort();
+const MINUTE = 60_000;
+
+async function save(nonce: string, id = '42') {
+  const done = runPreviewContinuation({ id, nonce, message });
+  await settle();
+  world.requests[world.requests.length - 1].answer.resolve({ status: 204 });
+  await done;
+}
+
+beforeEach(() => {
+  world.reset({ nonce: N0 });
+  vi.stubGlobal('fetch', fakeFetch);
+  envValues.NODE_ENV = 'production';
+});
+afterEach(() => {
+  vi.unstubAllGlobals();
+  envValues.NODE_ENV = 'production';
+});
+
+describe('an accepted commit', () => {
+  it('deletes the object of the nonce it replaced', async () => {
+    world.put(key(N0), 10 * MINUTE);
+    world.put(key(N1));
+
+    await save(N1);
+
+    expect(keys()).toEqual([key(N1)]);
+    expect(world.s3Calls.filter(({ kind }) => kind === 'DeleteObjectsCommand').map(({ input }) => input.Delete)).toContainEqual({ Objects: [{ Key: key(N0) }] });
+  });
+
+  it('deletes nothing for a replaced nonce of none, and keeps its own object', async () => {
+    world.reset({ nonce: null });
+    world.put(key(N1));
+
+    await save(N1);
+
+    expect(keys()).toEqual([key(N1)]);
+    expect(world.s3Calls.filter(({ kind }) => kind === 'DeleteObjectsCommand')).toEqual([]);
+  });
+
+  it('never deletes the object it committed', async () => {
+    world.put(key(N0), 10 * MINUTE);
+    world.put(key(N1));
+
+    await save(N1);
+
+    expect(world.objects.has(key(N1))).toBe(true);
+  });
+});
+
+describe('a refused commit', () => {
+  it('deletes its own object and nothing else when a later save has committed', async () => {
+    world.reset({ nonce: N2 });
+    world.put(key(N2));
+    world.put(key(N1));
+    world.put(key('c'.repeat(32)), 10 * MINUTE);
+
+    await save(N1);
+
+    expect(keys()).toEqual([key(N2), key('c'.repeat(32))].sort());
+    expect(world.row.nonce).toBe(N2);
+  });
+
+  it('deletes its own object when the row is gone, and recreates no row', async () => {
+    world.reset({ nonce: null, exists: false });
+    world.put(key(N1));
+
+    await save(N1);
+
+    expect(keys()).toEqual([]);
+    expect(world.row.exists).toBe(false);
+    expect(world.queries.some(({ sql }) => /insert/i.test(sql))).toBe(false);
+  });
+});
+
+describe('the sweep after an accepted commit', () => {
+  it('lists the message\'s prefix with its trailing slash', async () => {
+    world.put(key(N1));
+
+    await save(N1);
+
+    const listing = world.s3Calls.find(({ kind }) => kind === 'ListObjectsCommand');
+    expect(listing?.input.Prefix).toBe('previews/42/');
+  });
+
+  it('leaves another message whose id starts with this one alone', async () => {
+    world.put(key(N0), 10 * MINUTE);
+    world.put(key(N1));
+    world.put(key('d'.repeat(32), '421'), 10 * MINUTE);
+
+    await save(N1);
+
+    expect(keys()).toEqual([key('d'.repeat(32), '421'), key(N1)].sort());
+  });
+
+  it.each([
+    [120_000, true],
+    [119_999, false],
+  ])('an object %i ms older than the committed one is deleted: %s', async (age, deleted) => {
+    world.put(key(N0), 10 * MINUTE);
+    world.put(key('e'.repeat(32)), age);
+    world.put(key(N1));
+
+    await save(N1);
+
+    expect(world.objects.has(key('e'.repeat(32)))).toBe(!deleted);
+    expect(world.objects.has(key(N1))).toBe(true);
+  });
+
+  it('measures age by the bucket\'s times, not the function\'s clock', async () => {
+    world.put(key(N0), 10 * MINUTE);
+    world.put(key('f'.repeat(32)), 100_000);
+    world.put(key(N1));
+
+    await save(N1);
+
+    expect(world.objects.has(key('f'.repeat(32)))).toBe(true);
+  });
+
+  it('keeps an object written after the committed one', async () => {
+    world.put(key(N0), 10 * MINUTE);
+    world.put(key(N1));
+    world.tick(30_000);
+    world.put(key(N2));
+
+    await save(N1);
+
+    expect(world.objects.has(key(N2))).toBe(true);
+  });
+
+  it('deletes nothing in the sweep when the committed object is not in the listing, and reports no error', async () => {
+    const errors = vi.spyOn(console, 'error').mockImplementation(() => undefined);
+    world.put(key(N0), 10 * MINUTE);
+    world.put(key('e'.repeat(32)), 10 * MINUTE);
+
+    await save(N1);
+
+    expect(keys()).toEqual([key('e'.repeat(32))]);
+    expect(errors).not.toHaveBeenCalled();
+    errors.mockRestore();
+  });
+
+  it('talks to the configured endpoint, without forcing path-style addressing', async () => {
+    world.put(key(N1));
+
+    await save(N1);
+
+    expect(world.s3Configs.length).toBeGreaterThan(0);
+    world.s3Configs.forEach((config) => {
+      expect(config.endpoint).toBe('https://cdn.invalid');
+      expect(config.forcePathStyle).toBe(false);
+    });
+  });
+});
+
+describe('the development prefix', () => {
+  it('lists and deletes under dev/ when the website runs as development', async () => {
+    envValues.NODE_ENV = 'development';
+    world.put(key(N0, '42', 'dev/'), 10 * MINUTE);
+    world.put(key(N1, '42', 'dev/'));
+
+    await save(N1);
+
+    expect(world.s3Calls.find(({ kind }) => kind === 'ListObjectsCommand')?.input.Prefix).toBe('dev/previews/42/');
+    expect(keys()).toEqual([key(N1, '42', 'dev/')]);
+  });
+
+  it('does not use dev/ in production', async () => {
+    world.put(key(N0), 10 * MINUTE);
+    world.put(key(N1));
+
+    await save(N1);
+
+    expect(world.s3Calls.every(({ input }) => !JSON.stringify(input).includes('dev/'))).toBe(true);
+  });
+});
diff --git a/src/server/api/utils/__tests__/previewImage.interleavings.test.ts b/src/server/api/utils/__tests__/previewImage.interleavings.test.ts
new file mode 100644
index 0000000..6de5ed7
--- /dev/null
+++ b/src/server/api/utils/__tests__/previewImage.interleavings.test.ts
@@ -0,0 +1,166 @@
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import {
+  deferred, fakeFetch, settle, world,
+} from './helpers/previewWorld';
+
+import { runPreviewContinuation } from '~/server/api/utils/previewImage';
+
+vi.mock('~/env.mjs', async () => (await import('./helpers/previewWorld')).ENV_MODULE);
+vi.mock('@aws-sdk/client-s3', async () => (await import('./helpers/previewWorld')).S3_MODULE);
+vi.mock('project-utils', async () => {
+  const { world: w } = await import('./helpers/previewWorld');
+  return { getPostgres: () => w.db };
+});
+
+const NONCES = { 0: 'a'.repeat(32), 1: 'v1763509200000001aaaaaaaaaaaaaaaa', 2: 'v1763509200000002bbbbbbbbbbbbbbbb' } as const;
+const ORPHAN = 'z'.repeat(32);
+const OLD = 1_000_000;
+const key = (nonce: string) => `previews/42/${nonce}.jpeg`;
+const message = {
+  content: 'Hi', username: 'U', embeds: [], components: [],
+} as unknown as MessageData;
+
+type Cls = 'ok' | 'fail' | 'late';
+
+function chain(i: 1 | 2, cls: Cls): { ev: string, optional?: boolean }[] {
+  if (cls === 'ok') return [{ ev: `W${i}` }, { ev: `C${i}` }, { ev: `D${i}` }];
+  if (cls === 'fail') return [{ ev: `F${i}` }];
+  return [{ ev: `F${i}` }, { ev: `W${i}`, optional: true }];
+}
+
+function interleave(chains: { ev: string, optional?: boolean }[][]): string[][] {
+  const out = new Set<string>();
+  const rec = (cs: typeof chains, acc: string[]) => {
+    if (cs.every((c) => !c.length)) { out.add(acc.join(' ')); return; }
+    cs.forEach((c, k) => {
+      if (!c.length) return;
+      rec(cs.map((x, j) => (j === k ? x.slice(1) : x)), [...acc, c[0].ev]);
+      if (c[0].optional && c.length === 1) rec(cs.map((x, j) => (j === k ? [] : x)), acc);
+    });
+  };
+  rec(chains, []);
+  return [...out].map((s) => (s ? s.split(' ') : []));
+}
+
+async function play(seq: string[], withOrphan: boolean) {
+  world.reset({ nonce: NONCES[0] });
+  world.put(key(NONCES[0]), OLD);
+  if (withOrphan) world.put(key(ORPHAN), OLD);
+  const done = ([1, 2] as const).map((i) => runPreviewContinuation({ id: '42', nonce: NONCES[i], message }));
+  await settle();
+  const answerOf = (i: 1 | 2) => (world.requests.find(({ body }) => body.nonce === NONCES[i]) as { answer: ReturnType<typeof deferred<{ status: number } | Error>> }).answer;
+  const gates: Record<number, ReturnType<typeof deferred<void>>> = {};
+  const failures: string[] = [];
+  const processed: number[] = [];
+  const committedBeforeDelete: number[] = [];
+  const check = (ev: string) => {
+    const { row } = world;
+    if (row.exists && row.nonce && !world.objects.has(key(row.nonce))) failures.push(`B@${ev}`);
+  };
+
+  for (const ev of seq) {
+    const i = Number(ev.slice(1)) as 1 | 2;
+    switch (ev[0]) {
+      case 'W':
+        world.tick(5000);
+        world.put(key(NONCES[i]));
+        break;
+      case 'C':
+        gates[i] = deferred();
+        world.gate = gates[i];
+        processed.push(i);
+        if (world.row.exists) committedBeforeDelete.push(i);
+        answerOf(i).resolve({ status: 204 });
+        // eslint-disable-next-line no-await-in-loop
+        await settle();
+        break;
+      case 'D': {
+        gates[i].resolve();
+        // eslint-disable-next-line no-await-in-loop
+        await done[i - 1];
+        const accepted = world.commits.some(({ nonce, accepted: ok }) => nonce === NONCES[i] && ok);
+        if (accepted && world.row.exists && world.objects.has(key(NONCES[i]))) {
+          if (world.objects.has(key(NONCES[0])) && world.row.nonce !== NONCES[0]) failures.push(`E3@${ev}:n0`);
+          if (world.objects.has(key(ORPHAN))) failures.push(`E3@${ev}:z`);
+        }
+        break;
+      }
+      case 'F':
+        answerOf(i).resolve(seq.includes(`W${i}`) && !seq.includes(`C${i}`) ? new TypeError('fetch failed') : { status: 500 });
+        // eslint-disable-next-line no-await-in-loop
+        await done[i - 1];
+        break;
+      case 'X': world.row.exists = false; break;
+      case 'P': world.objects.clear(); break;
+      default: break;
+    }
+    check(ev);
+  }
+  await Promise.all(done);
+
+  const survivors = committedBeforeDelete.filter(() => !seq.includes('X') || seq.indexOf('X') > 0);
+  const acceptedNonces = survivors.map((i) => NONCES[i as 1 | 2]);
+  const wantNonce = [NONCES[0], ...acceptedNonces].sort().pop() as string;
+  if (seq.includes('X')) {
+    if (world.row.exists) failures.push('E1:row');
+  } else if (world.row.nonce !== wantNonce) failures.push(`E1:${String(world.row.nonce)} want ${wantNonce}`);
+  processed.forEach((i) => {
+    const nonce = NONCES[i as 1 | 2];
+    const committed = world.row.exists && world.row.nonce === nonce;
+    if (world.objects.has(key(nonce)) && !committed) failures.push(`E2:n${i}`);
+  });
+  return { failures, objects: [...world.objects.keys()].sort(), row: { ...world.row } };
+}
+
+beforeEach(() => { vi.stubGlobal('fetch', fakeFetch); });
+afterEach(() => { vi.unstubAllGlobals(); });
+
+const CLASSES: Cls[] = ['ok', 'fail', 'late'];
+const FLAGS = [false, true];
+
+const tableRows = CLASSES.flatMap((c1) => CLASSES.flatMap((c2) => FLAGS.flatMap((del) => FLAGS.map(
+  (orphan) => ({
+    c1, c2, del, orphan,
+  }),
+))));
+
+const sequencesOf = ({ c1, c2, del }: { c1: Cls, c2: Cls, del: boolean }) => {
+  const chains = [chain(1, c1), chain(2, c2)];
+  if (del) chains.push([{ ev: 'X' }, { ev: 'P' }]);
+  return interleave(chains);
+};
+
+describe('two saves of one message, interleaved, with and without a message delete and an old orphan', () => {
+  it.each(tableRows)('s1 $c1, s2 $c2, delete $del, orphan $orphan: every interleaving holds the invariants', async (row) => {
+    const bad: string[] = [];
+    const sequences = sequencesOf(row);
+    for (const seq of sequences) {
+      // eslint-disable-next-line no-await-in-loop
+      const result = await play(seq, row.orphan);
+      if (result.failures.length) bad.push(`[${seq.join(' ')}] ${result.failures.join(',')}`);
+    }
+
+    expect(sequences.length).toBeGreaterThan(0);
+    expect(bad.slice(0, 5)).toEqual([]);
+  }, 120_000);
+});
+
+describe('the enumeration', () => {
+  it('covers the 3120 interleavings of the 36 class rows that the decision table lists', () => {
+    expect(tableRows).toHaveLength(36);
+    expect(tableRows.reduce((total, row) => total + sequencesOf(row).length, 0)).toBe(3120);
+  });
+});
+
+describe('the sequence in which a later save deletes the earlier save\'s object first', () => {
+  it('leaves the later save\'s image committed and present', async () => {
+    const result = await play(['W1', 'C1', 'W2', 'C2', 'D2', 'D1'], false);
+
+    expect(result.failures).toEqual([]);
+    expect(result.row.nonce).toBe(NONCES[2]);
+    expect(result.objects).toEqual([key(NONCES[2])]);
+  });
+});
diff --git a/src/server/api/utils/__tests__/shared.message-cap.test.ts b/src/server/api/utils/__tests__/shared.message-cap.test.ts
