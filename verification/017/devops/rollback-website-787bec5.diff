new file mode 100644
index 0000000..09978e8
--- /dev/null
+++ b/src/utils/leaveWithoutAlert.ts
@@ -0,0 +1,17 @@
+const REARM_MS = 2000;
+
+let leaving = false;
+
+export const isLeavingWithoutAlert = () => leaving;
+
+export async function leaveWithoutAlert<T>(exit: () => Promise<T>) {
+  leaving = true;
+  try {
+    const result = await exit();
+    setTimeout(() => { leaving = false; }, REARM_MS);
+    return result;
+  } catch (error) {
+    leaving = false;
+    throw error;
+  }
+}
diff --git a/src/utils/messageDrafts.ts b/src/utils/messageDrafts.ts
new file mode 100644
index 0000000..8d89e52
--- /dev/null
+++ b/src/utils/messageDrafts.ts
@@ -0,0 +1,94 @@
+import withLocalStorage from './withLocalStorage';
+
+import { typedDeepEqual } from '~/utils';
+
+export const MAX_DRAFTS = 20;
+export const MAX_DRAFT_CHARS = 1024 * 1024;
+
+const TAB_KEY = 'messageDraftTab';
+
+const store = () => withLocalStorage('messageDrafts', {});
+const legacyStore = () => withLocalStorage('message', undefined as unknown as ActiveMessage);
+
+export const routeZeroKey = (tab: string) => `0:${tab}`;
+
+export function tabId() {
+  try {
+    const existing = window.sessionStorage.getItem(TAB_KEY);
+    if (existing) return existing;
+    const made = Math.random().toString(36).slice(2, 12);
+    window.sessionStorage.setItem(TAB_KEY, made);
+    return made;
+  } catch {
+    return 'no-session-storage';
+  }
+}
+
+export function readDrafts(): MessageDrafts {
+  if (window.localStorage.getItem('messageDrafts') !== null) return store().get();
+  if (window.localStorage.getItem('message') === null) return {};
+  const legacy = legacyStore().get();
+  return {
+    [legacy.id ?? routeZeroKey(tabId())]: {
+      data: legacy.data, name: legacy.name, editedAt: legacy.updatedAt,
+    },
+  };
+}
+
+const oldestOtherThan = (drafts: MessageDrafts, key: string) => Object.keys(drafts)
+  .filter((k) => k !== key)
+  .sort((a, b) => drafts[a].editedAt - drafts[b].editedAt)[0];
+
+export function writeDraft(key: string, draft: MessageDraft) {
+  const drafts = { ...readDrafts(), [key]: draft };
+  const tooBig = () => Object.keys(drafts).length > MAX_DRAFTS
+    || JSON.stringify(drafts).length > MAX_DRAFT_CHARS;
+  while (tooBig() && Object.keys(drafts).length > 1) delete drafts[oldestOtherThan(drafts, key)];
+
+  while (!store().set(drafts)) {
+    const oldest = oldestOtherThan(drafts, key);
+    if (oldest === undefined) return false;
+    delete drafts[oldest];
+  }
+  return true;
+}
+
+export function removeDraft(key: string, only?: (draft: MessageDraft) => boolean) {
+  const drafts = readDrafts();
+  if (!(key in drafts) || (only && !only(drafts[key]))) return;
+  delete drafts[key];
+  store().set(drafts);
+}
+
+export function routeZeroDraftFor(tab: string): MessageDraft | undefined {
+  const drafts = readDrafts();
+  const own = drafts[routeZeroKey(tab)];
+  if (own) return own;
+  const newest = Object.keys(drafts)
+    .filter((k) => k.startsWith('0:'))
+    .sort((a, b) => drafts[b].editedAt - drafts[a].editedAt)[0];
+  if (newest === undefined) return undefined;
+  writeDraft(routeZeroKey(tab), drafts[newest]);
+  return drafts[newest];
+}
+
+export function writeRouteZeroDraft(message: ActiveMessage) {
+  writeDraft(routeZeroKey(tabId()), {
+    data: message.data, name: message.name, editedAt: Date.now(),
+  });
+  legacyStore().set(message);
+}
+
+export const sameJson = (a: unknown, b: unknown) => typedDeepEqual(
+  JSON.parse(JSON.stringify(a ?? null)) as unknown,
+  JSON.parse(JSON.stringify(b ?? null)) as unknown,
+);
+
+export function removeRouteZeroDraft(savedData: ActiveMessage['data']) {
+  removeDraft(routeZeroKey(tabId()));
+  const holdsIt = window.localStorage.getItem('message') !== null
+    && sameJson(legacyStore().get().data, savedData);
+  if (holdsIt) {
+    legacyStore().remove();
+  }
+}
