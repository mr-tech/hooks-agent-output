index 0000000..0b01cd3
--- /dev/null
+++ b/src/server/api/utils/__tests__/previewImage.continuation-outcomes.test.ts
@@ -0,0 +1,150 @@
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import { settle, world } from './helpers/previewWorld';
+
+import { runPreviewContinuation } from '~/server/api/utils/previewImage';
+
+vi.mock('~/env.mjs', async () => (await import('./helpers/previewWorld')).ENV_MODULE);
+vi.mock('@aws-sdk/client-s3', async () => (await import('./helpers/previewWorld')).S3_MODULE);
+vi.mock('project-utils', async () => {
+  const { world: w } = await import('./helpers/previewWorld');
+  return { getPostgres: () => w.db };
+});
+
+const OLD_NONCE = 'a'.repeat(32);
+const NEW_NONCE = 'v1763509200000001PLANTEDNONCEHEX';
+const CONTENT = 'PLANTED-MESSAGE-CONTENT';
+const message = {
+  content: CONTENT, username: 'U', embeds: [], components: [],
+} as unknown as MessageData;
+
+let lines: string[];
+const failureLines = () => lines.filter((line) => line.startsWith('preview-image-failure'));
+
+beforeEach(async () => {
+  const { fakeFetch } = await import('./helpers/previewWorld');
+  world.reset({ nonce: OLD_NONCE });
+  world.put(`previews/42/${OLD_NONCE}.jpeg`, 1_000_000_000);
+  world.put(`previews/42/${NEW_NONCE}.jpeg`);
+  vi.stubGlobal('fetch', fakeFetch);
+  lines = [];
+  vi.spyOn(console, 'error').mockImplementation((...args: unknown[]) => { lines.push(args.map(String).join(' ')); });
+});
+afterEach(() => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+const start = () => runPreviewContinuation({ id: '42', nonce: NEW_NONCE, message });
+
+describe('the request to the generator', () => {
+  it('posts the id, the nonce and the message, with a bearer credential', async () => {
+    const done = start();
+    await settle();
+
+    expect(world.requests).toHaveLength(1);
+    expect(world.requests[0].body).toEqual({ id: '42', nonce: NEW_NONCE, message });
+    expect(world.requests[0].headers.Authorization.startsWith('Bearer ')).toBe(true);
+    world.requests[0].answer.resolve({ status: 204 });
+    await done;
+  });
+});
+
+describe('a generator answer of 204', () => {
+  it('commits the nonce and writes no failure line', async () => {
+    const done = start();
+    await settle();
+    world.requests[0].answer.resolve({ status: 204 });
+    await done;
+
+    expect(world.row.nonce).toBe(NEW_NONCE);
+    expect(failureLines()).toEqual([]);
+  });
+});
+
+describe('one failure line per failed generation', () => {
+  it.each([
+    ['500', { status: 500 }, 'status-500'],
+    ['404', { status: 404 }, 'status-404'],
+    ['200', { status: 200 }, 'status-other'],
+    ['302', { status: 302 }, 'status-other'],
+    ['503', { status: 503 }, 'status-other'],
+    ['a refused connection', new TypeError('fetch failed'), 'network-error'],
+  ])('answer %s writes one line and leaves the stored nonce alone', async (_name, answer, cls) => {
+    const done = start();
+    await settle();
+    world.requests[0].answer.resolve(answer);
+    await done;
+
+    expect(failureLines()).toHaveLength(1);
+    expect(failureLines()[0]).toMatch(new RegExp(`^preview-image-failure id=42 class=${cls} elapsedMs=\\d+$`));
+    expect(world.row.nonce).toBe(OLD_NONCE);
+    expect(world.commits).toEqual([]);
+  });
+
+  it('names no nonce, no message content, no object key and no credential', async () => {
+    const done = start();
+    await settle();
+    world.requests[0].answer.resolve({ status: 500 });
+    await done;
+
+    const line = failureLines()[0];
+    expect(line.includes(NEW_NONCE)).toBe(false);
+    expect(line.includes(CONTENT)).toBe(false);
+    expect(line.includes('previews/')).toBe(false);
+    expect(line.includes('planted-api-key')).toBe(false);
+  });
+
+  it('deletes nothing from the bucket', async () => {
+    const done = start();
+    await settle();
+    world.requests[0].answer.resolve({ status: 500 });
+    await done;
+
+    expect(world.s3Calls).toEqual([]);
+  });
+});
+
+describe('a generator that does not answer within 40 seconds', () => {
+  beforeEach(() => { vi.useFakeTimers(); });
+
+  it('writes exactly one line of class no-answer-within-T at 40 seconds, and no commit', async () => {
+    const done = start();
+    await vi.advanceTimersByTimeAsync(39_999);
+    expect(failureLines()).toEqual([]);
+
+    await vi.advanceTimersByTimeAsync(1);
+    await done;
+
+    expect(failureLines()).toHaveLength(1);
+    expect(failureLines()[0]).toBe('preview-image-failure id=42 class=no-answer-within-T elapsedMs=40000');
+    expect(world.commits).toEqual([]);
+  });
+
+  it('stops waiting once the generator has answered 204: no later line', async () => {
+    const done = start();
+    await vi.advanceTimersByTimeAsync(10_000);
+    world.requests[0].answer.resolve({ status: 204 });
+    await done;
+
+    await vi.advanceTimersByTimeAsync(120_000);
+
+    expect(failureLines()).toEqual([]);
+    expect(world.requests[0].signal?.aborted).toBe(false);
+  });
+
+  it('stops waiting once the generator has answered 500: one line, not two', async () => {
+    const done = start();
+    await vi.advanceTimersByTimeAsync(10_000);
+    world.requests[0].answer.resolve({ status: 500 });
+    await done;
+
+    await vi.advanceTimersByTimeAsync(120_000);
+
+    expect(failureLines()).toHaveLength(1);
+    expect(failureLines()[0]).toMatch(/class=status-500 elapsedMs=10000$/);
+  });
+});
diff --git a/src/server/api/utils/__tests__/previewImage.deletion-forms.test.ts b/src/server/api/utils/__tests__/previewImage.deletion-forms.test.ts
