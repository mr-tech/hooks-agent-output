new file mode 100644
index 0000000..72feb97
--- /dev/null
+++ b/src/providers/NavigationGuardProvider.tsx
@@ -0,0 +1,79 @@
+'use client';
+
+import { useRouter } from 'next/navigation';
+import {
+  createContext, memo, use, useMemo, useRef,
+} from 'react';
+import { useLatest } from 'react-use';
+
+import type { PropsWithChildren } from 'react';
+
+import ConfirmationDialog from '~/components/ConfirmationDialog';
+import ConfirmationProvider, { useConfirmation } from '~/providers/ConfirmationProvider';
+import { leaveWithoutAlert } from '~/utils/leaveWithoutAlert';
+
+export type NavigationGuard = (destination: string) => boolean;
+
+export interface GuardedLink {
+  href: string;
+  external?: boolean;
+  replace?: boolean;
+  scroll?: boolean;
+}
+
+interface State {
+  register: (guard: NavigationGuard) => VoidFunction;
+  intercept: (link: GuardedLink) => boolean;
+}
+
+const NO_GUARD: State = { register: () => () => {}, intercept: () => false };
+
+const Context = createContext<State>(NO_GUARD);
+export const useNavigationGuard = () => use(Context);
+
+const Guard = ({ children }: PropsWithChildren) => {
+  const { showConfirmation } = useConfirmation();
+  const routerRef = useLatest(useRouter());
+  const guardRef = useRef<NavigationGuard | null>(null);
+
+  const value = useMemo<State>(() => ({
+    register(guard) {
+      guardRef.current = guard;
+      return () => {
+        if (guardRef.current === guard) guardRef.current = null;
+      };
+    },
+    intercept({
+      href, external, replace, scroll,
+    }) {
+      if (!guardRef.current?.(href)) return false;
+
+      showConfirmation({
+        enabled: true,
+        title: 'You have unsaved changes!',
+        message: 'Are you sure you want to leave this page? Changes you made may not be saved.',
+        confirmText: 'Leave Page',
+        onConfirm: () => {
+          if (external) void leaveWithoutAlert(async () => window.location[replace ? 'replace' : 'assign'](href));
+          else routerRef.current[replace ? 'replace' : 'push'](href, { scroll });
+        },
+      });
+      return true;
+    },
+  }), [showConfirmation]);
+
+  return (
+    <Context.Provider value={value}>
+      {children}
+      <ConfirmationDialog />
+    </Context.Provider>
+  );
+};
+
+const Provider = memo(({ children }: PropsWithChildren) => (
+  <ConfirmationProvider>
+    <Guard>{children}</Guard>
+  </ConfirmationProvider>
+));
+Provider.displayName = 'NavigationGuardProvider';
+export default Provider;
