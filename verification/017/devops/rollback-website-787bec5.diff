+function saveRecords(message: Partial<ActiveMessage>) {
+  const records: string[] = [];
+  const Harness: FC = () => {
+    const { saveMessage } = useApiMethods(
+      { current: message as ActiveMessage },
+      { current: false },
+      () => undefined,
+      async () => undefined,
+      () => undefined,
+      () => undefined,
+      { current: records },
+    );
+    return <button type="button" onClick={() => saveMessage()}>save</button>;
+  };
+  const container = mountDom(<Harness />);
+  act(() => { container.querySelector('button')?.click(); });
+  return records;
+}
+
+describe('useApiMethods saveMessage, the record of the tab\'s own save', () => {
+  it('records one hash for a message that has an id', () => {
