+++ b/src/server/api/utils/__tests__/helpers/previewWorld.ts
@@ -0,0 +1,151 @@
+import createCapturingDatabase from './capturingDatabase';
+
+type Deferred<T> = { promise: Promise<T>, resolve: (value: T) => void, reject: (reason: unknown) => void };
+
+export function deferred<T = void>(): Deferred<T> {
+  let resolve!: (value: T) => void;
+  let reject!: (reason: unknown) => void;
+  const promise = new Promise<T>((res, rej) => { resolve = res; reject = rej; });
+  return { promise, resolve, reject };
+}
+
+type GeneratorAnswer = { status: number } | Error;
+type PendingRequest = {
+  body: { id: string, nonce: string, message: unknown };
+  headers: Record<string, string>;
+  answer: Deferred<GeneratorAnswer>;
+  signal?: AbortSignal;
+};
+
+export const BASE_TIME = Date.UTC(2020, 0, 1, 12, 0, 0);
+export const OLD_AGE_MS = 1_000_000_000;
+
+export const world = {
+  objects: new Map<string, Date>(),
+  row: { exists: true, nonce: null as string | null },
+  requests: [] as PendingRequest[],
+  s3Calls: [] as { kind: string, input: Record<string, unknown> }[],
+  s3Configs: [] as Record<string, unknown>[],
+  commits: [] as { nonce: string, accepted: boolean }[],
+  gate: null as Deferred<void> | null,
+  db: undefined as unknown,
+  queries: [] as { sql: string, parameters: readonly unknown[] }[],
+  clock: BASE_TIME,
+  other: ((_query: { sql: string, parameters: readonly unknown[] }) => []) as (query: { sql: string, parameters: readonly unknown[] }) => unknown[],
+
+  reset({ nonce = null, exists = true }: { nonce?: string | null, exists?: boolean } = {}) {
+    world.objects = new Map();
+    world.row = { exists, nonce };
+    world.requests = [];
+    world.s3Calls = [];
+    world.s3Configs = [];
+    world.commits = [];
+    world.gate = null;
+    world.clock = BASE_TIME;
+    world.other = () => [];
+    const captured = createCapturingDatabase((query) => {
+      world.queries.push({ sql: query.sql, parameters: query.parameters });
+      if (query.sql.startsWith('with "replaced"')) {
+        const next = query.parameters[1] as string;
+        const accepted = world.row.exists && (world.row.nonce === null || world.row.nonce < next);
+        world.commits.push({ nonce: next, accepted });
+        if (!accepted) return [];
+        const prev = world.row.nonce;
+        world.row.nonce = next;
+        return [{ prev }];
+      }
+      return world.other(query);
+    });
+    world.db = captured.db;
+    world.queries = [];
+  },
+
+  put(key: string, ageMs = 0) {
+    world.objects.set(key, new Date(world.clock - ageMs));
+  },
+
+  tick(ms = 5000) {
+    world.clock += ms;
+  },
+};
+
+type FetchInit = { body: string, headers: Record<string, string>, signal?: AbortSignal };
+
+export const fakeFetch = (_url: string, init: FetchInit) => {
+  const request: PendingRequest = {
+    body: JSON.parse(init.body) as PendingRequest['body'],
+    headers: init.headers,
+    answer: deferred<GeneratorAnswer>(),
+    signal: init.signal,
+  };
+  world.requests.push(request);
+  return new Promise((resolve, reject) => {
+    init.signal?.addEventListener('abort', () => reject(Object.assign(new Error('The operation was aborted.'), { name: 'AbortError' })));
+    void request.answer.promise.then((answer) => {
+      if (answer instanceof Error) reject(answer);
+      else resolve(answer);
+    });
+  });
+};
+
+type Input = Record<string, unknown>;
+type Command = { input: Input };
+
+function ListObjectsCommand(this: Command, input: Input) { this.input = input; }
+function DeleteObjectsCommand(this: Command, input: Input) { this.input = input; }
+function PutObjectCommand(this: Command, input: Input) { this.input = input; }
+
+type Sender = { send: (command: Command) => Promise<unknown> };
+
+function S3(this: Sender, config: Record<string, unknown>) {
+  world.s3Configs.push(config);
+  this.send = async (command: Command) => {
+    let kind = 'PutObjectCommand';
+    if (command instanceof (ListObjectsCommand as never)) kind = 'ListObjectsCommand';
+    if (command instanceof (DeleteObjectsCommand as never)) kind = 'DeleteObjectsCommand';
+    world.s3Calls.push({ kind, input: command.input });
+    if (world.gate) {
+      const { gate } = world;
+      world.gate = null;
+      await gate.promise;
+    }
+    if (kind === 'ListObjectsCommand') {
+      const prefix = command.input.Prefix as string;
+      return {
+        Contents: [...world.objects]
+          .filter(([key]) => key.startsWith(prefix))
+          .map(([Key, LastModified]) => ({ Key, LastModified })),
+      };
+    }
+    if (kind === 'DeleteObjectsCommand') {
+      (command.input.Delete as { Objects: { Key: string }[] }).Objects
+        .forEach(({ Key }) => world.objects.delete(Key));
+    }
+    return {};
+  };
+}
+
+export const S3_MODULE = {
+  S3, ListObjectsCommand, DeleteObjectsCommand, PutObjectCommand,
+};
+
+export const envValues: Record<string, string> = {
+  NODE_ENV: 'production',
+  CDN_BUCKET: 'bucket',
+  CDN_ENDPOINT: 'https://cdn.invalid',
+  CDN_KEY: 'k',
+  CDN_SECRET: 's',
+  PREVIEW_IMAGE_URL: 'https://generator.invalid/generate',
+  PREVIEW_IMAGE_API_KEY: 'planted-api-key',
+};
+
+export const ENV_MODULE = {
+  env: new Proxy(envValues, { get: (target, key) => target[String(key)] ?? `test-${String(key)}` }),
+};
+
+export const settle = async () => {
+  for (let i = 0; i < 6; i += 1) {
+    // eslint-disable-next-line no-await-in-loop
+    await new Promise((resolve) => { setImmediate(resolve); });
+  }
+};
