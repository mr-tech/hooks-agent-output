+
+export default (answer: (() => void) | undefined, enabled = true) => {
+  const ref = useRef<HTMLDivElement>(null);
+
+  useHotkeys(['enter'], () => {
+    if (ref.current?.closest('[role="dialog"]')?.contains(document.activeElement)) answer?.();
+  }, { enabled }, [enabled, answer]);
+
+  return ref;
+};
