+vi.mock('~/utils/api', async () => {
+  const { buildApiMock } = await import('./helpers/messageProviderDeps');
+  return buildApiMock({
+    queryData: { 'message.getOne': () => hoisted.stored },
+    onMutation: {
+      'message.upsert': (opts, input) => { hoisted.mutOpts.push(opts); hoisted.inputs.push(input); },
+    },
