--- /dev/null
+++ b/src/utils/__tests__/messageDrafts.bound-and-recency.test.tsx
@@ -0,0 +1,241 @@
+import {
+  afterEach, describe, expect, it, vi,
+} from 'vitest';
+
+import {
+  readDrafts, removeDraft, removeRouteZeroDraft, routeZeroDraftFor, tabId,
+  writeDraft, writeRouteZeroDraft,
+} from '../messageDrafts';
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  window.localStorage.clear();
+  window.sessionStorage.clear();
+});
+
+const entry = (editedAt: number, content = 'x') => ({ data: { content }, name: 'n', editedAt });
+const stored = () => JSON.parse(
+  window.localStorage.getItem('messageDrafts') ?? '{}',
+) as Record<string, { editedAt: number }>;
+const MEGABYTE = 1024 * 1024;
+
+describe('messageDrafts, the bound', () => {
+  it('holds at most 20 entries, dropping the least recently edited first, whatever order they were written in', () => {
+    const writeOrder = [...Array.from({ length: 13 }, (_, i) => i + 13), ...Array.from({ length: 12 }, (_, i) => i + 1)];
+    writeOrder.forEach((i) => writeDraft(`k${i}`, entry(i)));
+
+    const keys = Object.keys(stored()).sort((a, b) => Number(a.slice(1)) - Number(b.slice(1)));
+
+    expect(keys).toEqual(Array.from({ length: 20 }, (_, i) => `k${i + 6}`));
+  });
+
+  it('never drops the entry being written, even when it is the least recently edited', () => {
+    for (let i = 2; i <= 21; i += 1) writeDraft(`k${i}`, entry(i));
+
+    writeDraft('k1', entry(1));
+
+    expect(Object.keys(stored())).toContain('k1');
+    expect(Object.keys(stored())).not.toContain('k2');
+    expect(Object.keys(stored())).toHaveLength(20);
+  });
+
+  it('holds at most one megabyte serialised, dropping the least recently edited first', () => {
+    const big = 'y'.repeat(400_000);
+    writeDraft('a', entry(1, big));
+    writeDraft('b', entry(2, big));
+    writeDraft('c', entry(3, big));
+
+    expect(Object.keys(stored()).sort()).toEqual(['b', 'c']);
+    expect((window.localStorage.getItem('messageDrafts') as string).length).toBeLessThanOrEqual(MEGABYTE);
+  });
+
+  it('keeps every entry when the serialised map is exactly one megabyte, and drops the oldest one character over', () => {
+    const exact = (extra: number) => {
+      const filler = MEGABYTE - JSON.stringify({ a: entry(1, 'y'.repeat(300_000)), b: entry(2, '') }).length + extra;
+      return entry(2, 'y'.repeat(filler));
+    };
+
+    writeDraft('a', entry(1, 'y'.repeat(300_000)));
+    writeDraft('b', exact(0));
+    expect(Object.keys(stored()).sort()).toEqual(['a', 'b']);
+    expect((window.localStorage.getItem('messageDrafts') as string).length).toBe(MEGABYTE);
+
+    window.localStorage.clear();
+    writeDraft('a', entry(1, 'y'.repeat(300_000)));
+    writeDraft('b', exact(1));
+    expect(Object.keys(stored())).toEqual(['b']);
+  });
+
+  it('still writes one entry that alone passes a megabyte', () => {
+    writeDraft('old', entry(1));
+
+    writeDraft('huge', entry(2, 'z'.repeat(MEGABYTE + 10)));
+
+    expect(Object.keys(stored())).toEqual(['huge']);
+  });
+});
+
+describe('messageDrafts, a write the browser refuses', () => {
+  it('drops the least recently edited other entry and retries until the write lands', () => {
+    writeDraft('a', entry(1));
+    writeDraft('b', entry(2));
+    const real = window.localStorage.setItem.bind(window.localStorage);
+    vi.spyOn(Storage.prototype, 'setItem').mockImplementation((k: string, v: string) => {
+      if (k === 'messageDrafts' && Object.keys(JSON.parse(v) as object).length > 2) {
+        throw new DOMException('full', 'QuotaExceededError');
+      }
+      real(k, v);
+    });
+
+    const landed = writeDraft('c', entry(3));
+
+    expect(landed).toBe(true);
+    expect(Object.keys(stored()).sort()).toEqual(['b', 'c']);
+  });
+
+  it('drops the write, without throwing, once no other entry remains to drop', () => {
+    writeDraft('a', entry(1));
+    vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => {
+      throw new DOMException('full', 'QuotaExceededError');
+    });
+
+    let landed: boolean | undefined;
+    expect(() => { landed = writeDraft('b', entry(2)); }).not.toThrow();
+
+    expect(landed).toBe(false);
+  });
+});
+
+describe('messageDrafts, reads at write time', () => {
+  it('keeps an entry another tab stored since this tab last wrote', () => {
+    writeDraft('a', entry(1));
+    window.localStorage.setItem('messageDrafts', JSON.stringify({ ...stored(), b: entry(2) }));
+
+    writeDraft('c', entry(3));
+
+    expect(Object.keys(stored()).sort()).toEqual(['a', 'b', 'c']);
+  });
+
+  it('removes one entry and leaves the others', () => {
+    writeDraft('a', entry(1));
+    writeDraft('b', entry(2));
+
+    removeDraft('a');
+
+    expect(Object.keys(stored())).toEqual(['b']);
+  });
+
+  it('removes an entry only when its data satisfies the condition given', () => {
+    writeDraft('a', entry(1, 'mine'));
+
+    removeDraft('a', (e) => e.data.content === 'other');
+    expect(Object.keys(stored())).toEqual(['a']);
+
+    removeDraft('a', (e) => e.data.content === 'mine');
+    expect(Object.keys(stored())).toEqual([]);
+  });
+});
+
+describe('messageDrafts, the tab', () => {
+  it('has one id for the life of the tab', () => {
+    expect(tabId()).toBe(tabId());
+  });
+
+  it('has a different id in a tab that starts with no session storage', () => {
+    const first = tabId();
+    window.sessionStorage.clear();
+
+    expect(tabId()).not.toBe(first);
+  });
+});
+
+describe('messageDrafts, a tab at route 0', () => {
+  const draft = (content: string, updatedAt: number) => ({ name: 'New Message', updatedAt, data: { content } }) as ActiveMessage;
+
+  it('shows its own draft', () => {
+    writeRouteZeroDraft(draft('mine', 5));
+    writeDraft('0:other-tab', entry(9, 'theirs'));
+
+    expect(routeZeroDraftFor(tabId())?.data).toEqual({ content: 'mine' });
+  });
+
+  it('with none of its own, copies the route-0 entry edited most recently under its own key', () => {
+    writeDraft('0:B', entry(2, 'from B'));
+    writeDraft('0:A', entry(1, 'from A'));
+    writeDraft('77', entry(3, 'a saved message'));
+
+    const shown = routeZeroDraftFor('C');
+
+    expect(shown?.data).toEqual({ content: 'from B' });
+    expect(stored()['0:C'].editedAt).toBe(2);
+  });
+
+  it('with no route-0 entry anywhere, shows nothing and writes nothing', () => {
+    writeDraft('77', entry(3, 'a saved message'));
+
+    expect(routeZeroDraftFor('C')).toBeUndefined();
+    expect(Object.keys(stored())).toEqual(['77']);
+  });
+
+  it('writes the draft under its own key and also under the legacy message key', () => {
+    writeRouteZeroDraft(draft('legacy too', 5));
+
+    expect(Object.keys(stored())).toEqual([`0:${tabId()}`]);
+    expect(JSON.parse(window.localStorage.getItem('message') as string)).toMatchObject({ data: { content: 'legacy too' } });
+  });
+
+  it('removes its own entry, and the legacy key when it holds that draft', () => {
+    writeRouteZeroDraft(draft('gone', 5));
+
+    removeRouteZeroDraft({ content: 'gone' });
+
+    expect(Object.keys(stored())).toEqual([]);
+    expect(window.localStorage.getItem('message')).toBeNull();
+  });
+
+  it('leaves the legacy key when it holds a different draft', () => {
+    writeRouteZeroDraft(draft('kept', 5));
+
+    removeRouteZeroDraft({ content: 'something else' });
+
+    expect(window.localStorage.getItem('message')).not.toBeNull();
+  });
+});
+
+describe('messageDrafts, the store a browser holds from before', () => {
+  const tabKey = () => `0:${tabId()}`;
+
+  it('turns a stored message with no id into this tab\'s route-0 entry, dated by its own timestamp', () => {
+    window.localStorage.setItem('message', '{"name":"Draft","updatedAt":5,"data":{"content":"old draft"}}');
+
+    expect(readDrafts()[tabKey()]).toEqual({ data: { content: 'old draft' }, name: 'Draft', editedAt: 5 });
+  });
+
+  it('turns a stored copy of saved message 42 into the entry for 42', () => {
+    window.localStorage.setItem('message', '{"id":"42","name":"Saved","updatedAt":9,"data":{"content":"edited"}}');
+
+    expect(readDrafts()['42']).toEqual({ data: { content: 'edited' }, name: 'Saved', editedAt: 9 });
+  });
+
+  it('keeps the legacy key in place', () => {
+    const legacy = '{"name":"Draft","updatedAt":5,"data":{"content":"old draft"}}';
+    window.localStorage.setItem('message', legacy);
+
+    readDrafts();
+
+    expect(window.localStorage.getItem('message')).toBe(legacy);
+  });
+
+  it('does not migrate once the drafts map exists', () => {
+    window.localStorage.setItem('message', '{"name":"Draft","updatedAt":5,"data":{"content":"old draft"}}');
+    window.localStorage.setItem('messageDrafts', '{}');
+
+    expect(readDrafts()).toEqual({});
+  });
+
+  it('migrates nothing when no message was ever stored', () => {
+    expect(readDrafts()).toEqual({});
+  });
+});
