+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import type { Session } from 'next-auth';
+
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+import SessionWrapper from '~/providers/SessionProvider';
+import { isLeavingWithoutAlert } from '~/utils/leaveWithoutAlert';
+
+const hoisted = vi.hoisted(() => ({
+  cookie: undefined as string | undefined,
+  signOut: vi.fn(),
+  leavingDuringSignOut: undefined as boolean | undefined,
+}));
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+vi.mock('next-auth/react', () => ({
+  SessionProvider: () => null,
+  signOut: hoisted.signOut,
+}));
+vi.mock('~/utils/getClientSessionCookie', () => ({ default: () => hoisted.cookie }));
+
+beforeEach(() => {
+  hoisted.cookie = undefined;
+  hoisted.leavingDuringSignOut = undefined;
+  hoisted.signOut.mockReset();
+  hoisted.signOut.mockImplementation(() => {
+    hoisted.leavingDuringSignOut = isLeavingWithoutAlert();
+    return Promise.resolve();
+  });
+});
+
+afterEach(() => { unmountDom(); });
+
+const session = { user: { name: 'someone' }, expires: '2999-01-01' } as unknown as Session;
+
+describe('SessionProvider, a page loaded with a session cookie the server did not accept', () => {
+  it('signs out, leaving without the unsaved-changes prompt', () => {
+    hoisted.cookie = 'stale';
+
+    mountDom(<SessionWrapper session={null}>{null}</SessionWrapper>);
+
+    expect(hoisted.signOut).toHaveBeenCalledTimes(1);
+    expect(hoisted.leavingDuringSignOut).toBe(true);
+  });
+
+  it('does not sign out when the server gave a session', () => {
+    hoisted.cookie = 'good';
+
+    mountDom(<SessionWrapper session={session}>{null}</SessionWrapper>);
+
+    expect(hoisted.signOut).not.toHaveBeenCalled();
+  });
+
+  it('does not sign out when there is no cookie', () => {
+    mountDom(<SessionWrapper session={null}>{null}</SessionWrapper>);
+
+    expect(hoisted.signOut).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/server/api/utils/__tests__/helpers/previewWorld.ts b/src/server/api/utils/__tests__/helpers/previewWorld.ts
