@@ -0,0 +1,275 @@
+import { createServer } from 'node:http';
+import {
+  afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import EditPage from '../../edit/page';
+import SendPage from '../../send/page';
+
+import type { AddressInfo } from 'node:net';
+import type { NextApiRequest, NextApiResponse } from 'next';
+import type { ComponentType } from 'react';
+
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+import MessageProvider, { retryUnlessRefused, useMessage } from '~/providers/MessageProvider';
+import TrpcProvider from '~/providers/TrpcProvider';
+import createCapturingDatabase from '~/server/api/utils/__tests__/helpers/capturingDatabase';
+import { proxy } from '~/utils/api';
+
+const mocks = vi.hoisted(() => ({
+  db: undefined as unknown,
+  pathname: '/message/m/0/edit',
+}));
+
+vi.mock('~/env.mjs', () => ({
+  env: new Proxy({}, { get: (_, key) => `test-${String(key)}` }),
+}));
+vi.mock('~/server/auth', () => {
+  const session = async () => ({ user: { id: '100000000000000001', guilds: [] }, expires: 'never' });
+  return { getServerAuthSession: session, getHydratedServerAuthSession: session };
+});
+vi.mock('project-utils', () => ({ getPostgres: () => mocks.db }));
+vi.mock('pusher', () => ({ default: class { trigger = vi.fn(); } }));
+vi.mock('pusher-js', () => ({
+  default: function Pusher() {
+    return {
+      subscribe: () => ({ bind: () => undefined, unbind: () => undefined }),
+      unsubscribe: () => undefined,
+      disconnect: () => undefined,
+    };
+  },
+}));
+vi.mock('@vercel/functions', () => ({ waitUntil: () => undefined }));
+vi.mock('~/utils/redis', () => ({ default: {} }));
+vi.mock('~/utils/redis/messageStore', () => ({ default: {} }));
+vi.mock('~/utils/discord', () => ({ getApi: vi.fn() }));
+
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({
+    push: vi.fn(), replace: vi.fn(), refresh: vi.fn(), back: vi.fn(),
+  }),
+  usePathname: () => mocks.pathname,
+  useSearchParams: () => new URLSearchParams(),
+}));
+vi.mock('next-auth/react', () => ({
+  useSession: () => ({ status: 'authenticated', data: { user: { guilds: [] } } }),
+  signIn: vi.fn(),
+}));
+vi.mock('next/image', () => ({ default: () => null }));
+vi.mock('~/providers/GuildProvider', () => ({
+  useGuild: () => ({
+    webhooks: [],
+    setGuildId: vi.fn(),
+    guild: null,
+    isLoading: false,
+    isLoadingChannels: false,
+    hasLoaded: true,
+    refetchAll: vi.fn(),
+  }),
+}));
+vi.mock('~/providers/WebhookProvider', () => ({
+  useWebhook: () => ({
+    setThreadId: vi.fn(),
+    setSelectedWebhook: vi.fn(),
+    oldMessage: null,
+    threadId: '',
+    threadName: '',
+    selectedWebhook: null,
+    setMessageIdOrUrl: vi.fn(),
+  }),
+}));
+vi.mock('~/providers/ConfirmationProvider', async () => (
+  await import('~/providers/MessageProvider/__tests__/helpers/messageProviderDeps')
+).CONFIRMATION_PROVIDER_MOCK);
+vi.mock('~/providers/IsMobileProvider', () => ({ useIsMobile: () => false }));
+vi.mock('react-hotkeys-hook', () => ({ useHotkeys: () => undefined }));
+vi.mock('~/providers/MarkdownProvider', () => ({ default: ({ children }: { children: unknown }) => children }));
+vi.mock('~/components/BottomPortal', () => ({
+  BottomPortalContainer: () => null,
+  BottomPortalProvider: ({ children }: { children: unknown }) => children,
+}));
+vi.mock('~/components/ConfirmationDialog', () => ({ default: () => null }));
+vi.mock('~/components/PresetDialog', () => ({ default: () => null }));
+vi.mock('~/components/dynamics/DiscordMessageEditor', () => ({ default: () => <div data-editor /> }));
+vi.mock('~/components/DiscordMessageEditor', () => ({ default: () => null }));
+vi.mock('~/components/SlateEditor', () => ({ default: () => null }));
+vi.mock('~/components/Markdown', () => ({ default: () => null }));
+vi.mock('~/components/Tooltip', () => ({ default: () => null }));
+vi.mock('~/components/EmojiPicker/Picker', () => ({ default: () => null }));
+vi.mock('~/components/DiscordMessageEditor/components/EmbedEditor/ColorPicker/Picker', () => ({ default: () => null }));
+vi.mock('~/components/Calendar', () => ({ default: () => null }));
+vi.mock('~/components/ImageUploader', () => ({ default: () => null }));
+vi.mock('~/components/Drawer', () => ({ default: () => null }));
+vi.mock('~/components/MessagePreview', () => ({ default: () => null }));
+vi.mock('../../send/_components/WebhookMenu', () => ({ default: () => null }));
+vi.mock('../../send/_components/EditMessageMenu', () => ({ default: () => null }));
+
+const ABSENT_ID = '900000000000500';
+const OWN_ID = '900000000000101';
+const OWNER_DB_ID = '900000000000001';
+const NOT_FOUND_TEXT = 'This message doesn\'t exist, or you don\'t have access to it.';
+
+const world = { messageLoadFails: false };
+
+function ownMessageRow(id: string) {
+  return {
+    id,
+    createdAt: new Date(0),
+    updatedAt: new Date(0),
+    name: 'own-message',
+    data: { content: 'own-content' },
+    previewImageNonce: null,
+    recentWebhookId: null,
+    recentThreadId: null,
+    recentMessageId: null,
+    guildId: null,
+    scheduledMessageId: null,
+    scheduledMessageCron: null,
+    scheduledMessageError: null,
+    scheduledMessageSendAt: null,
+    scheduledMessageSent: null,
+  };
+}
+const getOneRequests: number[] = [];
+
+let origin = '';
+const server = createServer((req, res) => {
+  const requestUrl = new URL(req.url ?? '/', 'http://localhost');
+  const query = Object.fromEntries(requestUrl.searchParams);
+  const trpc = decodeURIComponent(requestUrl.pathname.replace(/^\/api\/trpc\//, ''));
+  Object.assign(req, { query: { ...query, trpc } });
+  res.on('finish', () => { if (trpc === 'message.getOne') getOneRequests.push(res.statusCode); });
+  import('~/pages/api/trpc/[trpc]').then(({ default: handler }) => handler(
+    req as NextApiRequest,
+    res as NextApiResponse,
+  )).catch(() => { res.statusCode = 599; res.end(); });
+});
+
+const nodeFetch = globalThis.fetch;
+
+beforeAll(async () => {
+  await import('~/pages/api/trpc/[trpc]');
+  await new Promise<void>((resolve) => { server.listen(0, resolve); });
+  const { port } = server.address() as AddressInfo;
+  origin = `http://localhost:${port}`;
+});
+
+afterAll(async () => {
+  await new Promise((resolve) => { server.close(resolve); });
+});
+
+beforeEach(() => {
+  getOneRequests.length = 0;
+  world.messageLoadFails = false;
+  mocks.db = createCapturingDatabase(({ sql, parameters }) => {
+    if (sql.startsWith('select "userId" from "Accounts"')) return [{ userId: OWNER_DB_ID }];
+    if (world.messageLoadFails && sql.includes('left join "ScheduledMessages"')) throw new Error('connection reset');
+    if (sql.includes('left join "ScheduledMessages"') && String(parameters[0]) === OWN_ID) return [ownMessageRow(OWN_ID)];
+    if (sql.startsWith('select "fk_users_id" from "Messages"') && parameters.map(String).includes(OWN_ID)) {
+      return [{ fk_users_id: OWNER_DB_ID }];
+    }
+    return [];
+  }).db;
+  vi.stubGlobal('fetch', (input: string | URL, init?: RequestInit) => nodeFetch(new URL(input, origin), init));
+});
+
+afterEach(() => {
+  unmountDom();
+  vi.unstubAllGlobals();
+});
+
+const LoadErrorCode = () => {
+  const { messageError } = useMessage();
+  return <span data-load-error={messageError?.data?.code ?? ''} />;
+};
+
+function mountPage(Page: ComponentType, route: 'edit' | 'send', id: string) {
+  mocks.pathname = `/message/m/${id}/${route}`;
+  return mountDom(
+    <TrpcProvider>
+      <MessageProvider>
+        <LoadErrorCode />
+        <Page />
+      </MessageProvider>
+    </TrpcProvider>,
+  );
+}
+
+const pages = [['edit', EditPage], ['send', SendPage]] as const;
+const pageMarkers = { edit: '[data-editor]', send: null } as const;
+
+describe.each(pages)('the %s page for a message the signed-in user can load', (route, Page) => {
+  it('opens the message, with no not-found notice', async () => {
+    const container = mountPage(Page, route, OWN_ID);
+
+    await vi.waitFor(() => {
+      const marker = pageMarkers[route];
+      if (marker) expect(container.querySelector(marker)).not.toBeNull();
+      else expect(container.textContent).toContain('Review Message');
+    });
+
+    expect(getOneRequests).toEqual([200]);
+    expect(container.textContent).not.toContain(NOT_FOUND_TEXT);
+  });
+});
+
+describe.each(pages)('the %s page for a load refused other than as not found', (route, Page) => {
+  it('shows no not-found notice', async () => {
+    const container = mountPage(Page, route, 'not-a-number');
+
+    await vi.waitFor(() => {
+      expect(container.querySelector('[data-load-error="BAD_REQUEST"]')).not.toBeNull();
+    });
+
+    expect(container.textContent).not.toContain(NOT_FOUND_TEXT);
+  });
+});
+
+describe.each(pages)('the %s page for a message number the signed-in user cannot load', (route, Page) => {
+  it('shows the not-found notice, in place of the page, with a link back to his messages', async () => {
+    const container = mountPage(Page, route, ABSENT_ID);
+
+    await vi.waitFor(() => { expect(container.textContent).toContain(NOT_FOUND_TEXT); });
+
+    const back = Array.from(container.querySelectorAll('a')).find((a) => a.getAttribute('href') === '/message');
+    expect(back).toBeTruthy();
+    expect(container.querySelector('[data-editor]')).toBeNull();
+    expect(container.textContent).not.toContain('Review Message');
+  });
+
+  it('asks for the message once, without retrying the refusal', async () => {
+    const container = mountPage(Page, route, ABSENT_ID);
+
+    await vi.waitFor(() => { expect(container.textContent).toContain(NOT_FOUND_TEXT); });
+
+    expect(getOneRequests).toEqual([404]);
+  });
+});
+
+async function errorFromTheWire(id: string) {
+  return proxy.message.getOne.query(id).then(
+    () => { throw new Error('the load succeeded'); },
+    (error: Parameters<typeof retryUnlessRefused>[1]) => error,
+  );
+}
+
+describe('the message load\'s retry rule, on errors as the tRPC client reports them', () => {
+  it('does not retry a not-found answer', async () => {
+    const error = await errorFromTheWire(ABSENT_ID);
+
+    expect(retryUnlessRefused(0, error)).toBe(false);
+  });
+
+  it('retries a server error up to three times', async () => {
+    world.messageLoadFails = true;
+    const error = await errorFromTheWire(ABSENT_ID);
+
+    expect([0, 1, 2, 3].map((count) => retryUnlessRefused(count, error))).toEqual([true, true, true, false]);
+  });
+
+  it('does not retry a refused number that is not a message number', async () => {
+    const error = await errorFromTheWire('not-a-number');
+
+    expect(retryUnlessRefused(0, error)).toBe(false);
+  });
+});
