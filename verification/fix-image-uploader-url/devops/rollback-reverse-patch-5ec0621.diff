diff --git a/src/components/__tests__/ImageUploader.saved-address.test.tsx b/src/components/__tests__/ImageUploader.saved-address.test.tsx
new file mode 100644
index 0000000..a138fda
--- /dev/null
+++ b/src/components/__tests__/ImageUploader.saved-address.test.tsx
@@ -0,0 +1,394 @@
+import { act, useCallback, useState } from 'react';
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import ImageUploader from '../ImageUploader';
+
+import click from './helpers/click';
+import enter from './helpers/enter';
+import { mountDom, unmountDom } from './helpers/dom';
+
+vi.mock('~/env.mjs', () => ({ env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' } }));
+
+const TITLE = 'Enter Image URL';
+const URL_A = 'https://example.com/a.png';
+const URL_B = 'https://example.com/b.png';
+const URL_X = 'https://example.com/x.png';
+const URL_Y = 'https://example.com/y.png';
+const URL_Z = 'https://example.com/z.png';
+
+const pending: FakeImage[] = [];
+
+class FakeImage {
+  width = 0;
+
+  url = '';
+
+  onload: (() => void) | null = null;
+
+  onerror: (() => void) | null = null;
+
+  set src(url: string) {
+    this.url = url;
+    pending.push(this);
+  }
+}
+
+async function settle(url: string, loads: boolean) {
+  const matching = pending.filter((i) => i.url === url);
+  expect(matching.length, `no pending load of ${url}`).toBeGreaterThan(0);
+  matching.forEach((i) => pending.splice(pending.indexOf(i), 1));
+  await act(async () => {
+    matching.forEach((i) => {
+      if (loads) {
+        Reflect.set(i, 'width', 1);
+        i.onload?.();
+      } else {
+        i.onerror?.();
+      }
+    });
+  });
+  await act(async () => {});
+}
+
+const saved: string[] = [];
+
+const Host = ({ initial }: { initial?: string }) => {
+  const [isOpen, setOpen] = useState(true);
+  const [image, setImage] = useState(initial);
+  const close = useCallback(() => setOpen(false), []);
+  const commit = useCallback((url: string) => { saved.push(url); setImage(url); }, []);
+  return (
+    <>
+      <button type="button" data-reopen onClick={() => setOpen(true)}>reopen</button>
+      <button type="button" data-replace onClick={() => setImage(URL_Z)}>replace</button>
+      <ImageUploader
+        isOpen={isOpen}
+        image={image}
+        onClose={close}
+        setImage={commit}
+      />
+    </>
+  );
+};
+
+function dialog() {
+  const found = Array.from(document.body.querySelectorAll<HTMLElement>('[role="dialog"]'))
+    .find((d) => d.textContent?.includes(TITLE) && !d.hidden);
+  expect(found, 'no open image dialog').toBeTruthy();
+  return found as HTMLElement;
+}
+
+function button(text: string) {
+  const found = Array.from(dialog().querySelectorAll<HTMLButtonElement>('button'))
+    .find((b) => b.textContent?.includes(text));
+  expect(found, `no "${text}" button`).toBeTruthy();
+  return found as HTMLButtonElement;
+}
+
+const box = () => dialog().querySelector('input') as HTMLInputElement;
+const preview = () => dialog().querySelector<HTMLImageElement>('img[alt="upload preview"]')?.getAttribute('src') ?? null;
+
+async function type(value: string) {
+  act(() => {
+    Reflect.set(HTMLInputElement.prototype, 'value', value, box());
+    box().dispatchEvent(new Event('input', { bubbles: true }));
+  });
+  await act(async () => {});
+}
+
+const save = () => click(button('Save'), { detail: 0 });
+
+function enterOnDialog() {
+  act(() => { dialog().focus(); });
+  enter();
+}
+
+function enterInBox() {
+  act(() => { box().focus(); });
+  expect(document.activeElement).toBe(box());
+  enter();
+}
+
+async function open(initial?: string) {
+  mountDom(<Host initial={initial} />);
+  await act(async () => {});
+}
+
+async function reopen() {
+  click(document.body.querySelector('[data-reopen]') as HTMLElement);
+  await act(async () => {});
+}
+
+beforeEach(() => {
+  pending.length = 0;
+  saved.length = 0;
+  vi.stubGlobal('Image', FakeImage);
+});
+afterEach(() => {
+  unmountDom();
+  vi.unstubAllGlobals();
+});
+
+describe('ImageUploader, the address it saves', () => {
+  it('saves the address the box shows when an earlier address finishes loading after it', async () => {
+    await open();
+    await type(URL_A);
+    await type(URL_B);
+    await settle(URL_B, true);
+    await settle(URL_A, true);
+
+    expect(preview()).toBe(URL_B);
+    save();
+
+    expect(saved).toEqual([URL_B]);
+  });
+
+  it('saves the loaded address on Enter with focus in the box', async () => {
+    await open();
+    await type(URL_A);
+    await settle(URL_A, true);
+    enterInBox();
+
+    expect(saved).toEqual([URL_A]);
+  });
+
+  it.each([
+    ['is still loading', null],
+    ['has failed to load', false],
+  ] as const)('saves nothing on Enter in the box while its address %s', async (_name, loads) => {
+    await open();
+    await type(URL_A);
+    await settle(URL_A, true);
+    await type(URL_B);
+    if (loads !== null) await settle(URL_B, loads);
+    enterInBox();
+
+    expect(saved).toEqual([]);
+  });
+
+  it('keeps Save and Enter off while the address in the box is still loading, then saves it once loaded', async () => {
+    await open();
+    await type(URL_A);
+    await settle(URL_A, true);
+    await type(URL_B);
+
+    expect(button('Save').disabled).toBe(true);
+    enterOnDialog();
+    expect(saved).toEqual([]);
+
+    await settle(URL_B, true);
+    save();
+
+    expect(saved).toEqual([URL_B]);
+  });
+
+  it.each([
+    ['an address that is not an image address', 'not an image', null, 'Invalid url.'],
+    ['an image address that fails to load', URL_B, false, 'Image not found.'],
+  ] as const)('refuses Save and Enter for %s typed after a loaded one', async (_name, typed, loads, error) => {
+    await open();
+    await type(URL_A);
+    await settle(URL_A, true);
+    await type(typed);
+    if (loads !== null) await settle(typed, loads);
+
+    expect(dialog().textContent).toContain(error);
+    expect(preview()).toBeNull();
+    expect(button('Save').disabled).toBe(true);
+    enterOnDialog();
+
+    expect(saved).toEqual([]);
+  });
+
+  it('saves no image when the saved address is deleted from the box', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    await type('');
+    save();
+
+    expect(saved).toEqual(['']);
+  });
+
+  it('leaves nothing to clear on reopening after an emptied box is saved', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    await type('');
+    save();
+    await reopen();
+
+    expect(box().value).toBe('');
+    expect(button('Clear').disabled).toBe(true);
+  });
+
+  it('refuses Save for a saved address that fails to load when the dialog opens', async () => {
+    await open(URL_X);
+    await settle(URL_X, false);
+
+    expect(dialog().textContent).toContain('Image not found.');
+    expect(button('Save').disabled).toBe(true);
+  });
+  it('shows no preview and saves nothing on Enter once a failed address is deleted from the box', async () => {
+    await open();
+    await type(URL_A);
+    await settle(URL_A, false);
+    await type('');
+
+    expect(preview()).toBeNull();
+    enterOnDialog();
+
+    expect(saved).toEqual([]);
+  });
+
+  it('saves an address that loads on a later try after failing', async () => {
+    await open();
+    await type(URL_A);
+    await settle(URL_A, false);
+    await type(URL_B);
+    expect(dialog().textContent).not.toContain('Image not found.');
+    await type(URL_A);
+    await settle(URL_A, true);
+    save();
+
+    expect(saved).toEqual([URL_A]);
+  });
+});
+
+describe('ImageUploader, Clear', () => {
+  it('stays available for a saved address that fails to load when the dialog opens', async () => {
+    await open(URL_X);
+    await settle(URL_X, false);
+
+    expect(button('Clear').disabled).toBe(false);
+  });
+
+  it('stays cleared when the address it cleared finishes loading afterwards', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    await type(URL_A);
+    click(button('Clear'), { detail: 0 });
+    await settle(URL_A, true);
+
+    expect(box().value).toBe('');
+    expect(preview()).toBeNull();
+    save();
+
+    expect(saved).toEqual(['']);
+  });
+});
+
+describe('ImageUploader, an image saved by another path while the dialog is closed', () => {
+  it('shows that image on reopening, and saves it', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    click(button('Cancel'), { detail: 0 });
+    click(document.body.querySelector('[data-replace]') as HTMLElement);
+    await reopen();
+
+    expect(box().value).toBe(URL_Z);
+    expect(preview()).toBe(URL_Z);
+    save();
+
+    expect(saved).toEqual([URL_Z]);
+  });
+});
+
+describe('ImageUploader, an image saved by another path while the dialog is open', () => {
+  it('follows that image in the box and the preview, and saves it', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    await type(URL_A);
+    click(document.body.querySelector('[data-replace]') as HTMLElement);
+    await act(async () => {});
+
+    expect(box().value).toBe(URL_Z);
+    expect(preview()).toBe(URL_Z);
+    save();
+
+    expect(saved).toEqual([URL_Z]);
+  });
+});
+
+describe('ImageUploader, Cancel', () => {
+  it('puts the box and the preview back to the saved image, and reopening saves that image', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    await type(URL_Y);
+    await settle(URL_Y, true);
+    click(button('Cancel'), { detail: 0 });
+    await reopen();
+
+    expect(box().value).toBe(URL_X);
+    expect(preview()).toBe(URL_X);
+    save();
+
+    expect(saved).toEqual([URL_X]);
+  });
+
+  it('empties the box and the preview when no image was saved', async () => {
+    await open();
+    await type(URL_Y);
+    await settle(URL_Y, true);
+    click(button('Cancel'), { detail: 0 });
+    await reopen();
+
+    expect(box().value).toBe('');
+    expect(preview()).toBeNull();
+    expect(dialog().textContent).not.toContain('Invalid url.');
+    expect(button('Save').disabled).toBe(true);
+  });
+
+  it('drops the error of the cancelled address when the dialog reopens', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    await type('not an image');
+    expect(dialog().textContent).toContain('Invalid url.');
+    click(button('Cancel'), { detail: 0 });
+    await reopen();
+
+    expect(dialog().textContent).not.toContain('Invalid url.');
+  });
+
+  it('keeps the error of a saved address that fails to load when the dialog is cancelled unedited and reopened', async () => {
+    await open(URL_X);
+    await settle(URL_X, false);
+    click(button('Cancel'), { detail: 0 });
+    await reopen();
+
+    expect(dialog().textContent).toContain('Image not found.');
+    expect(button('Save').disabled).toBe(true);
+  });
+
+  it('puts the box back to the image saved in this dialog, not the one it opened with', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    await type(URL_A);
+    await settle(URL_A, true);
+    save();
+    await reopen();
+    await type(URL_B);
+    click(button('Cancel'), { detail: 0 });
+    await reopen();
+
+    expect(box().value).toBe(URL_A);
+    save();
+
+    expect(saved).toEqual([URL_A, URL_A]);
+  });
+
+  it('keeps the saved image when the cancelled address finishes loading afterwards', async () => {
+    await open(URL_X);
+    await settle(URL_X, true);
+    await type(URL_Y);
+    click(button('Cancel'), { detail: 0 });
+    await reopen();
+    await settle(URL_Y, true);
+
+    expect(box().value).toBe(URL_X);
+    expect(preview()).toBe(URL_X);
+    save();
+
+    expect(saved).toEqual([URL_X]);
+  });
+});
