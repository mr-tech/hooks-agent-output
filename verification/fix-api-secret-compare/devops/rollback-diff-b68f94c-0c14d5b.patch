@@ -0,0 +1,66 @@
+import {
+  beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import { makeRes } from './helpers/apiResponse';
+
+type JsonRes = { status: (n: number) => { json: (b: unknown) => unknown } };
+
+const { env, getMessage } = vi.hoisted(() => ({
+  env: { HOOKS_API_TOKEN: undefined as string | undefined },
+  getMessage: vi.fn((_req: unknown, res: JsonRes) => res.status(200).json({ forwarded: true })),
+}));
+
+vi.mock('~/env.mjs', () => ({ env }));
+vi.mock('bot/serverCommands', () => ({ default: { get_message: getMessage } }));
+
+const TOKEN = 'test-hooks-token';
+const body = { data: { name: 'get_message' } };
+
+type Handler = (req: never, res: never) => Promise<unknown>;
+
+async function call(headers: Record<string, unknown>) {
+  const { default: handler } = await import('~/pages/api/interactions-server') as { default: Handler };
+  const res = makeRes();
+  await handler({ method: 'POST', headers, body } as never, res as never);
+  return res;
+}
+
+describe('/api/interactions-server requires the hooks API token', () => {
+  beforeEach(() => {
+    getMessage.mockClear();
+    env.HOOKS_API_TOKEN = TOKEN;
+  });
+
+  it.each([
+    ['no token header', {}],
+    ['a wrong token of the same length', { 'x-hooks-api-token': 'test-hooks-tokex' }],
+    ['the token with trailing characters', { 'x-hooks-api-token': `${TOKEN}x` }],
+    ['an empty token header', { 'x-hooks-api-token': '' }],
+    ['a repeated token header', { 'x-hooks-api-token': [TOKEN] }],
+  ])('refuses %s with 401 and runs no command', async (_case, headers) => {
+    const res = await call(headers);
+    expect(res.statusCode).toBe(401);
+    expect(res.ended).toBe(true);
+    expect(getMessage).not.toHaveBeenCalled();
+  });
+
+  it('runs the command for exactly the configured token', async () => {
+    const res = await call({ 'x-hooks-api-token': TOKEN });
+    expect(res.statusCode).toBe(200);
+    expect(getMessage).toHaveBeenCalledTimes(1);
+  });
+
+  it.each([
+    ['empty, with an empty header', '', { 'x-hooks-api-token': '' }],
+    ['empty, with no header', '', {}],
+    ['unset, with no header', undefined, {}],
+    ['unset, with the header "undefined"', undefined, { 'x-hooks-api-token': 'undefined' }],
+  ])('fails closed when the configured token is %s', async (_case, configured, headers) => {
+    env.HOOKS_API_TOKEN = configured;
+    const res = await call(headers);
+    expect(res.statusCode).toBe(401);
+    expect(res.ended).toBe(true);
+    expect(getMessage).not.toHaveBeenCalled();
+  });
+});
