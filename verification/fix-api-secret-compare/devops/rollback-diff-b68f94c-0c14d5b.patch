+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest';
+
+import { makeRes } from '../../__tests__/helpers/apiResponse';
+
+import type * as SecretEqualsModule from '~/server/api/utils/secretEquals';
+
+const { env, getPostgres, runCommand } = vi.hoisted(() => {
+  const query: Record<string, unknown> = {};
+  Object.assign(query, {
+    selectFrom: () => query,
+    leftJoin: () => query,
+    select: () => query,
+    where: () => query,
+    execute: async () => [],
+    executeTakeFirst: async () => undefined,
+  });
+  return {
+    env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test', HOOKS_API_TOKEN: 'test-hooks-token' },
+    getPostgres: vi.fn(() => query),
+    runCommand: vi.fn(),
+  };
+});
+
+vi.mock('~/env.mjs', () => ({ env }));
+vi.mock('project-utils', () => ({ getPostgres }));
+vi.mock('bot/serverCommands', () => ({ default: { get_message: runCommand } }));
+vi.mock('~/server/api/utils/secretEquals', async (importOriginal) => {
+  const actual = await importOriginal<typeof SecretEqualsModule>();
+  return { default: vi.fn(actual.default) };
+});
+
+const KEY = 'test-statbot-key';
+const GUILD = '123456789012345678';
+
+type Handler = (req: never, res: never) => Promise<unknown>;
+
+const sites = [
+  ['/api/v1 guild messages (list)', '~/pages/api/v1/guilds/[guildId]/messages', 'GET',
+    { authorization: 'Bearer sent-value' }, { guildId: GUILD }, ['Bearer sent-value', `Bearer ${KEY}`],
+    { authorization: `Bearer ${KEY}` }],
+  ['/api/v1 guild messages (single)', '~/pages/api/v1/guilds/[guildId]/messages/[id]', 'GET',
+    { authorization: 'Bearer sent-value' }, { guildId: GUILD, id: '1' }, ['Bearer sent-value', `Bearer ${KEY}`],
+    { authorization: `Bearer ${KEY}` }],
+  ['/api/interactions-server', '~/pages/api/interactions-server', 'POST',
+    { 'x-hooks-api-token': 'sent-value' }, {}, ['sent-value', 'test-hooks-token'],
+    { 'x-hooks-api-token': 'test-hooks-token' }],
+] as const;
+
+describe.each(sites)('%s compares the sent credential through secretEquals', (_label, path, method, headers, query, expected, matching) => {
+  beforeEach(() => {
+    vi.stubEnv('STATBOT_API_KEY', KEY);
+    getPostgres.mockClear();
+    runCommand.mockClear();
+  });
+  afterEach(() => {
+    vi.unstubAllEnvs();
+  });
+
+  it('passes the header as sent and the configured credential', async () => {
+    const { default: secretEquals } = await import('~/server/api/utils/secretEquals');
+    vi.mocked(secretEquals).mockClear();
+    const { default: handler } = await import(path) as { default: Handler };
+    const res = makeRes();
+    await handler({
+      method, headers, query, body: { data: { name: 'get_message' } },
+    } as never, res as never);
+
+    expect(res.statusCode).toBe(401);
+    expect(secretEquals).toHaveBeenCalledTimes(1);
+    expect(secretEquals).toHaveBeenCalledWith(...expected);
+  });
+
+  it('refuses the exact configured credential when secretEquals refuses it', async () => {
+    const { default: secretEquals } = await import('~/server/api/utils/secretEquals');
+    vi.mocked(secretEquals).mockClear().mockReturnValueOnce(false);
+    const { default: handler } = await import(path) as { default: Handler };
+    const res = makeRes();
+    await handler({
+      method, headers: matching, query, body: { data: { name: 'get_message' } },
+    } as never, res as never);
+
+    expect(res.statusCode).toBe(401);
+    expect(res.ended).toBe(true);
+    expect(getPostgres).not.toHaveBeenCalled();
+    expect(runCommand).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/server/api/utils/__tests__/secretEquals.equality.test.ts b/src/server/api/utils/__tests__/secretEquals.equality.test.ts
