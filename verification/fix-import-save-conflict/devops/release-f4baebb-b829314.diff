+    press(findButton(el, 'Save as Components V2'));
+
+    await continueAndName(el);
+    press(findButton(el, 'Save'));
+
+    const data = writtenData();
+    expect(data.content ?? '').toBe('');
+    expect(hasComponentType(data, 17)).toBe(true);
