+import {
+  describe, expect, it, vi,
+} from 'vitest';
+import { z } from 'zod';
+
+import { cappedInput, discordMessageShape, messageIdShape } from '../shapes';
+
+vi.mock('~/env.mjs', () => ({
+  env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' },
+}));
+vi.mock('~/assets/svg/TextIcon', () => ({ default: {} }));
+vi.mock('~/assets/svg/VoiceIcon', () => ({ default: {} }));
+
+const TEXT = { type: 10, content: 'x' };
+const repeat = (length: number, element: () => unknown) => Array.from({ length }, element);
+const invalidAccessory = () => ({ type: 9, components: [{ ...TEXT }], accessory: { type: 99 } });
+
+async function issuesOf(promise: Promise<unknown>) {
+  try {
+    await promise;
+  } catch (error) {
+    expect(error).toBeInstanceOf(z.ZodError);
+    return (error as z.ZodError).issues;
+  }
+  return null;
+}
+
+describe('cappedInput', () => {
+  const schema = z.object({
+    ids: z.array(messageIdShape),
+    names: z.array(z.string()),
+    name: z.string(),
+  });
+  const capped = cappedInput(schema);
+
+  it('returns the parsed output of an input with no issue', async () => {
+    await expect(capped.parseAsync({ ids: ['0012', '7'], names: ['a'], name: 'n' })).resolves.toEqual({ ids: ['12', '7'], names: ['a'], name: 'n' });
+  });
+
+  it('refuses with a ZodError of the issues, each reduced to code, path and message', async () => {
+    const issues = await issuesOf(capped.parseAsync({ ids: ['7'], names: [1], name: 5 }));
+
+    expect(issues).toEqual([
+      { code: 'invalid_type', path: ['names', 0], message: 'Expected string, received number' },
+      { code: 'invalid_type', path: ['name'], message: 'Expected string, received number' },
+    ]);
+  });
+
+  it('keeps 20 issues and adds one summary issue at the 21st', async () => {
+    const issues = await issuesOf(capped.parseAsync({ ids: [], names: repeat(30, () => 1), name: 'n' }));
+
+    expect(issues).toHaveLength(21);
+    expect(issues?.[19]).toEqual({ code: 'invalid_type', path: ['names', 19], message: 'Expected string, received number' });
+    expect(issues?.[20]).toEqual({ code: 'custom', path: [], message: 'Stopped checking after 20 errors' });
+  });
+
+  it('keeps the message an issue was created with, at a kept position that is neither first nor last', async () => {
+    const flagged = cappedInput(z.object({
+      head: z.array(z.string()),
+      flag: z.string().superRefine((_value, ctx) => {
+        ctx.addIssue({ code: z.ZodIssueCode.custom, message: 'The flag is not allowed' });
+      }),
+      tail: z.array(z.string()),
+    }));
+
+    const issues = await issuesOf(flagged.parseAsync({ head: repeat(10, () => 1), flag: 'x', tail: repeat(30, () => 1) }));
+
+    expect(issues).toHaveLength(21);
+    expect(issues?.[10]).toEqual({ code: 'custom', path: ['flag'], message: 'The flag is not allowed' });
+    expect(issues?.[9]).toEqual({ code: 'invalid_type', path: ['head', 9], message: 'Expected string, received number' });
+    expect(issues?.[11]).toEqual({ code: 'invalid_type', path: ['tail', 0], message: 'Expected string, received number' });
+  });
+
+  it('lets an error thrown by the schema itself reach the caller', async () => {
+    const throwing = cappedInput(z.string().superRefine(() => { throw new TypeError('schema failure'); }));
+
+    await expect(throwing.parseAsync('a')).rejects.toThrow(new TypeError('schema failure'));
+  });
+
+  it('carries no count from one refusal to the next', async () => {
+    await issuesOf(capped.parseAsync({ ids: [], names: repeat(30, () => 1), name: 'n' }));
+
+    const issues = await issuesOf(capped.parseAsync({ ids: [], names: [1, 2, 3], name: 'n' }));
+
+    expect(issues).toHaveLength(3);
+  });
+});
+
+describe('the plain unions of the message shape', () => {
+  const calls = (data: unknown) => {
+    const seen: z.ZodIssueOptionalMessage[] = [];
+    const errorMap: z.ZodErrorMap = (issue, ctx) => {
+      seen.push(issue);
+      return { message: ctx.defaultError };
+    };
+    const result = discordMessageShape.safeParse(data, { errorMap });
+    return { created: seen.length, returned: result.success ? 0 : result.error.issues.length };
+  };
+
+  it('create one issue for each failing accessory they return', () => {
+    expect(calls({ components: repeat(6, invalidAccessory) })).toEqual({ created: 6, returned: 6 });
+  });
+
+  it('create one issue for a failing separator spacing', () => {
+    const separator = { type: 14, divider: true, spacing: 3 };
+
+    expect(calls({ components: [separator] })).toEqual({ created: 1, returned: 1 });
+  });
+
+  it('create one issue for an allowed-mention kind that is not admitted', () => {
+    expect(calls({ allowed_mentions: { parse: ['nope'] } })).toEqual({ created: 1, returned: 1 });
+  });
+
+  it('create the issue of the branch that matched, and no other', () => {
+    const accessory = { type: 11, media: { url: 'nope' } };
+
+    const section = { type: 9, components: [TEXT], accessory };
+
+    expect(calls({ components: [section] })).toEqual({ created: 1, returned: 1 });
+  });
+});
