new file mode 100644
index 0000000..85e6a92
--- /dev/null
+++ b/src/providers/MessageProvider/__tests__/usePreferences.recent-list-bound.test.tsx
@@ -0,0 +1,95 @@
+import {
+  afterEach, describe, expect, it, vi,
+} from 'vitest';
+
+import usePreferences from '../usePreferences';
+
+import { mountDom, unmountDom } from '~/components/__tests__/helpers/dom';
+
+const hoisted = vi.hoisted(() => ({
+  stored: undefined as undefined | string[],
+  sent: [] as { recentMessageIds?: string[] }[],
+}));
+
+vi.mock('~/env.mjs', async () => (await import('./helpers/messageProviderDeps')).ENV_MOCK);
+vi.mock('next-auth/react', () => ({
+  useSession: () => ({
+    data: { user: { preferences: { recentMessageIds: hoisted.stored } } },
+  }),
+}));
+vi.mock('~/utils/hooks/useUpdatePreferences', () => ({
+  default: (preferences: { recentMessageIds?: string[] }) => { hoisted.sent.push(preferences); },
+}));
+
+const OPEN = '900000000000999';
+const SERVER_BOUND = 11;
+
+const range = (from: number, to: number) => Array.from(
+  { length: to - from + 1 },
+  (_, i) => String(900000000000000 + from + i),
+);
+
+const Probe: FC<{ message: null | ActiveMessage }> = ({ message }) => {
+  usePreferences(message);
+  return null;
+};
+
+function sentFor(stored: string[], message: null | ActiveMessage) {
+  hoisted.stored = stored;
+  mountDom(<Probe message={message} />);
+  return hoisted.sent.at(-1)?.recentMessageIds;
+}
+
+const open = { id: OPEN, name: 'n', updatedAt: 1 } as ActiveMessage;
+
+afterEach(() => {
+  unmountDom();
+  hoisted.sent.length = 0;
+  hoisted.stored = undefined;
+});
+
+describe('usePreferences recent message ids', () => {
+  it.each([
+    [0, [], [OPEN]],
+    [10, range(1, 10), [OPEN, ...range(1, 10)]],
+    [11, range(1, 11), [OPEN, ...range(1, 10)]],
+    [50, range(1, 50), [OPEN, ...range(1, 10)]],
+  ])('sends the open message and at most ten stored ids for a stored list of %i', (_length, stored, expected) => {
+    const sent = sentFor(stored, open);
+
+    expect(sent).toEqual(expected);
+    expect((sent ?? []).length).toBeLessThanOrEqual(SERVER_BOUND);
+  });
+
+  it.each([
+    [0, [], []],
+    [10, range(1, 10), range(1, 10)],
+    [11, range(1, 11), range(1, 10)],
+    [50, range(1, 50), range(1, 10)],
+  ])('sends at most ten stored ids, in order, with no message open, for a stored list of %i', (_length, stored, expected) => {
+    const sent = sentFor(stored, null);
+
+    expect(sent).toEqual(expected);
+  });
+
+  it('moves the open message to the front of a stored list that holds it past the eleventh place', () => {
+    const stored = [...range(1, 12), OPEN, ...range(13, 40)];
+
+    const sent = sentFor(stored, open);
+
+    expect(sent).toEqual([OPEN, ...range(1, 10)]);
+  });
+
+  it('puts the open message first and drops its stored copy', () => {
+    const stored = [...range(1, 3), OPEN, ...range(4, 9)];
+
+    expect(sentFor(stored, open)).toEqual([OPEN, ...range(1, 3), ...range(4, 9)]);
+  });
+
+  it('sends nothing for a user with no stored list and no message open', () => {
+    hoisted.stored = undefined;
+    mountDom(<Probe message={null} />);
+
+    expect(hoisted.sent.at(-1)?.recentMessageIds).toBeUndefined();
+  });
+});
