@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  filled, MESSAGE_LIST_SITES, procedureInput,
+} from '../../../utils/__tests__/helpers/listBoundSites';
+
+export interface SaveProcedure {
+  call: (input: unknown) => Promise<unknown>;
+  databaseQueries: () => number;
+}
+
+interface RefusedIssue {
+  code: string;
+  path: (string | number)[];
+  message: string;
+}
+
+export async function refusalOf(call: SaveProcedure['call'], input: unknown) {
+  try {
+    await call(input);
+  } catch (error) {
+    const { code, message } = error as { code?: string, message: string };
+    try {
+      return { code, issues: JSON.parse(message) as RefusedIssue[] };
+    } catch {
+      return { code, issues: [] as RefusedIssue[] };
+    }
+  }
+  return { code: undefined, issues: [] as RefusedIssue[] };
+}
+
+export async function reachesDatabase(procedure: SaveProcedure, input: unknown) {
+  const before = procedure.databaseQueries();
+  const outcome = await refusalOf(procedure.call, input);
+  return { passed: procedure.databaseQueries() > before, code: outcome.code };
+}
+
+export function registerMessageListBoundSpecs(procedure: SaveProcedure) {
+  describe.each(MESSAGE_LIST_SITES)('$id', (site) => {
+    const overLimit = site.kinds.flatMap((kind) => [site.bound + 1, site.bound + 50]
+      .map((length) => [kind, length] as const));
+
+    it.each(overLimit)('refuses a list of %s elements, length %i, with one issue for the list and no database access', async (kind, length) => {
+      const before = procedure.databaseQueries();
+
+      const input = procedureInput(site, filled(site, kind, length));
+      const { code, issues } = await refusalOf(procedure.call, input);
+
+      expect(code).toBe('BAD_REQUEST');
+      expect(issues).toEqual([{ code: 'too_big', path: site.listPath, message: site.maximumMessage }]);
+      expect(procedure.databaseQueries()).toBe(before);
+    });
+
+    it.each([site.bound, site.bound - 1])('accepts a list of %i valid elements', async (length) => {
+      const outcome = await reachesDatabase(procedure, procedureInput(site, filled(site, 'valid', length)));
+
+      expect(outcome.passed).toBe(true);
+      expect(outcome.code).not.toBe('BAD_REQUEST');
+    });
+
+    it.each([site.bound, site.bound - 1])('keeps the one issue per invalid element for a list of %i with the first element invalid', async (length) => {
+      const list = [site.element('invalid'), ...filled(site, 'valid', length - 1)];
+
+      const { code, issues } = await refusalOf(procedure.call, procedureInput(site, list));
+
+      expect(code).toBe('BAD_REQUEST');
+      expect(issues).toEqual([{
+        code: site.invalidIssue.code,
+        path: [...site.listPath, 0, ...site.invalidIssue.path],
+        message: site.invalidIssue.message,
+      }]);
+    });
+  });
+}
