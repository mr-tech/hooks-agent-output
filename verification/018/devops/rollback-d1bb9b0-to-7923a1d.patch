+import {
+  describe, expect, it, vi,
+} from 'vitest';
+import { z } from 'zod';
+
+import { boundedArray, discordMessageImportShape, discordMessageShape } from '../shapes';
+
+vi.mock('~/env.mjs', () => ({
+  env: { NEXT_PUBLIC_DISCORD_CLIENT_ID: 'test' },
+}));
+vi.mock('~/assets/svg/TextIcon', () => ({ default: {} }));
+vi.mock('~/assets/svg/VoiceIcon', () => ({ default: {} }));
+
+const reduced = (result: z.SafeParseReturnType<unknown, unknown>) => (
+  result.success
+    ? null
+    : result.error.issues.map(({ code, path, message }) => ({ code, path, message }))
+);
+
+const TEXT = { type: 10, content: 'x' };
+const BUTTON = { type: 2, style: 5, url: 'https://example.com' };
+const ID = '100000000000000001';
+const repeat = (length: number, element: unknown) => Array.from({ length }, () => element);
+
+describe('boundedArray', () => {
+  const shape = boundedArray(z.string(), 3);
+
+  it('returns a list at the bound unchanged', () => {
+    expect(shape.safeParse(['a', 'b', 'c'])).toEqual({ success: true, data: ['a', 'b', 'c'] });
+  });
+
+  it('refuses a list one over the bound with one issue at the list', () => {
+    const result = shape.safeParse(['a', 'b', 'c', 'd']);
+
+    expect(reduced(result)).toEqual([{ code: 'too_big', path: [], message: 'Array must contain at most 3 element(s)' }]);
+  });
+
+  it('validates no element of an over-limit list', () => {
+    const result = shape.safeParse([1, null, {}, 'a']);
+
+    expect(reduced(result)).toEqual([{ code: 'too_big', path: [], message: 'Array must contain at most 3 element(s)' }]);
+  });
+
+  it('reports a value that is not a list as the array schema does', () => {
+    expect(reduced(shape.safeParse('abc'))).toEqual([{ code: 'invalid_type', path: [], message: 'Expected array, received string' }]);
+  });
+
+  it('reports each invalid element of a list within the bound at its own path', () => {
+    expect(reduced(shape.safeParse(['a', 2, 'c']))).toEqual([{ code: 'invalid_type', path: [1], message: 'Expected string, received number' }]);
+  });
+
+  it('runs no refinement of the enclosing object over an over-limit list', () => {
+    const refinement = vi.fn();
+    const enclosing = z.object({ list: boundedArray(z.string(), 1) }).superRefine(refinement);
+
+    enclosing.safeParse({ list: ['a', 'b'] });
+
+    expect(refinement).not.toHaveBeenCalled();
+  });
+});
+
+describe('discordMessageShape over-limit lists', () => {
+  it('refuses 41 top-level components holding a null with one issue and no throw', () => {
+    const components = [...repeat(40, TEXT), null];
+
+    const result = discordMessageShape.safeParse({ components });
+
+    expect(reduced(result)).toEqual([{ code: 'too_big', path: ['components'], message: 'Array must contain at most 40 element(s)' }]);
+  });
+
+  it('refuses 41 container children holding a null with one issue and no throw', () => {
+    const container = { type: 17, components: [...repeat(40, TEXT), null] };
+    const result = discordMessageShape.safeParse({ components: [container] });
+
+    expect(reduced(result)).toEqual([{ code: 'too_big', path: ['components', 0, 'components'], message: 'Array must contain at most 40 element(s)' }]);
+  });
+
+  it('adds no displayable-text issue to a refused list of over-long text displays', () => {
+    const long = { type: 10, content: 'x'.repeat(4000) };
+
+    const result = discordMessageShape.safeParse({ components: repeat(41, long) });
+
+    expect(reduced(result)).toEqual([{ code: 'too_big', path: ['components'], message: 'Array must contain at most 40 element(s)' }]);
+  });
+
+  it('still adds the displayable-text issue for a list within its bound', () => {
+    const long = { type: 10, content: 'x'.repeat(4000) };
+
+    const result = discordMessageShape.safeParse({ components: repeat(2, long) });
+
+    expect(reduced(result)).toEqual([{
+      code: 'too_big', path: ['components'], message: 'Components displayable text size exceeds maximum size of 4000',
+    }]);
+  });
+});
+
+describe('discordMessageShape allowed mentions', () => {
+  it.each(['user', 'here', 'everyone'])('accepts %s as a parse kind and refuses one that is not admitted', (kind) => {
+    const admitted = discordMessageShape.safeParse({ allowed_mentions: { parse: [kind] } });
+
+    expect(admitted.success).toBe(true);
+    expect(discordMessageShape.safeParse({ allowed_mentions: { parse: [`${kind}s`] } }).success).toBe(false);
+  });
+});
+
+describe('discordMessageImportShape (the browser paste)', () => {
+  it('refuses 150 malformed mention ids with one issue for the list', () => {
+    const result = discordMessageImportShape.safeParse({ allowed_mentions: { users: repeat(150, 'nope') } });
+
+    expect(reduced(result)).toEqual([{ code: 'too_big', path: ['allowed_mentions', 'users'], message: 'Array must contain at most 100 element(s)' }]);
+  });
+
+  it('refuses 101 well-formed user ids and accepts 100', () => {
+    const users = (length: number) => ({ allowed_mentions: { users: repeat(length, ID) } });
+    const over = discordMessageImportShape.safeParse(users(101));
+    const atBound = discordMessageImportShape.safeParse(users(100));
+
+    expect(reduced(over)).toEqual([
+      { code: 'too_big', path: ['allowed_mentions', 'users'], message: 'Array must contain at most 100 element(s)' },
+    ]);
+    expect(atBound.success).toBe(true);
+  });
+
+  it('refuses 41 valid top-level components with one issue for the list', () => {
+    const result = discordMessageImportShape.safeParse({ components: repeat(41, TEXT) });
+
+    expect(reduced(result)).toEqual([{ code: 'too_big', path: ['components'], message: 'Array must contain at most 40 element(s)' }]);
+  });
+
+  it('refuses 41 container children and four allowed-mention kinds', () => {
+    const container = { type: 17, components: repeat(41, TEXT) };
+    const tooMany = discordMessageImportShape.safeParse({ components: [container] });
+
+    expect(reduced(tooMany)).toEqual([
+      { code: 'too_big', path: ['components', 0, 'components'], message: 'Array must contain at most 40 element(s)' },
+    ]);
+    expect(reduced(discordMessageImportShape.safeParse({ allowed_mentions: { parse: ['user', 'here', 'everyone', 'user'] } }))).toEqual([
+      { code: 'too_big', path: ['allowed_mentions', 'parse'], message: 'Array must contain at most 3 element(s)' },
+    ]);
+  });
+
+  it('refuses 41 invalid top-level components with one issue and no displayable-text issue', () => {
+    const invalid = { type: 10, content: 5 };
+    const long = { type: 10, content: 'x'.repeat(4000) };
+
+    const invalidList = discordMessageImportShape.safeParse({ components: repeat(41, invalid) });
+
+    expect(reduced(invalidList)).toEqual([
+      { code: 'too_big', path: ['components'], message: 'Array must contain at most 40 element(s)' },
+    ]);
+    expect(reduced(discordMessageImportShape.safeParse({ components: repeat(41, long) }))).toEqual([
+      { code: 'too_big', path: ['components'], message: 'Array must contain at most 40 element(s)' },
+    ]);
+  });
+
+  it('keeps dropping unsupported components before it counts the list', () => {
+    const unsupported = { type: 3 };
+
+    const components = [...repeat(40, TEXT), unsupported, unsupported];
+    const result = discordMessageImportShape.safeParse({ components });
+
+    expect(result.success).toBe(true);
+  });
+
+  it('refuses an action row of six buttons with one issue', () => {
+    const row = { type: 1, components: repeat(6, BUTTON) };
+    const result = discordMessageImportShape.safeParse({ components: [row] });
+
+    expect(reduced(result)).toEqual([{ code: 'too_big', path: ['components', 0, 'components'], message: 'Array must contain at most 5 element(s)' }]);
+  });
+});
