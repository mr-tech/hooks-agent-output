diff --git a/src/server/api/routers/__tests__/helpers/saveErrorCapSpecs.ts b/src/server/api/routers/__tests__/helpers/saveErrorCapSpecs.ts
new file mode 100644
index 0000000..b78f39d
--- /dev/null
+++ b/src/server/api/routers/__tests__/helpers/saveErrorCapSpecs.ts
@@ -0,0 +1,225 @@
+import { describe, expect, it } from 'vitest';
+
+import { refusalOf } from './saveListBoundSpecs';
+
+import type { SaveProcedure } from './saveListBoundSpecs';
+
+import formatMutationError from '~/utils/formatMutationError';
+
+const SUMMARY = 'Stopped checking after 20 errors';
+const DATA = ['message', 'data'];
+const BIG = 'x'.repeat(100_000);
+const SIXTEEN_KB = 16 * 1024;
+
+const BUTTON = { type: 2, style: 5, url: 'https://example.com' };
+const TEXT = { type: 10, content: 'x' };
+
+const repeat = (length: number, element: () => unknown) => Array.from({ length }, element);
+const input = (data: unknown) => ({ message: { name: 'n', data } });
+const badName = () => ({ name: 5, value: 'b' });
+const badValue = () => ({ name: 'a', value: 5 });
+const fieldIssue = (embed: number, index: number, key: string) => ({
+  code: 'invalid_type',
+  path: [...DATA, 'embeds', embed, 'fields', index, key],
+  message: 'Expected string, received number',
+});
+
+const fatButton = () => ({
+  type: 2, style: 1, emoji: { id: 1, name: 1, animated: 1 }, url: 'x', disabled: 1,
+});
+const invalidAccessory = () => ({ type: 9, components: [{ ...TEXT }], accessory: { type: 99 } });
+
+function countingTexts(counter: { reads: number }) {
+  return () => {
+    const element: Record<string, unknown> = {};
+    Object.defineProperty(element, 'type', { enumerable: true, get() { counter.reads += 1; return 10; } });
+    Object.defineProperty(element, 'content', { enumerable: true, get() { counter.reads += 1; return 5; } });
+    return element;
+  };
+}
+
+const longValueBodies: [string, number, unknown][] = [
+  ['one allowed-mention kind', 1, { allowed_mentions: { parse: [BIG] } }],
+  ['three allowed-mention kinds', 3, { allowed_mentions: { parse: [BIG, BIG, BIG] } }],
+  ['a link button style', 1, { components: [{ type: 1, components: [{ ...BUTTON, style: BIG }] }] }],
+  ['a link button type', 1, { components: [{ type: 1, components: [{ ...BUTTON, type: BIG }] }] }],
+  ['a section accessory type', 1, { components: [{ type: 9, components: [TEXT], accessory: { type: BIG } }] }],
+  ['a separator spacing', 1, { components: [{ type: 14, divider: true, spacing: BIG }] }],
+  ['a text display type inside a section', 1, { components: [{ type: 9, accessory: BUTTON, components: [{ type: BIG, content: 'x' }] }] }],
+  ['a thumbnail accessory type', 1, { components: [{ type: 9, components: [TEXT], accessory: { type: BIG, media: { url: 'https://example.com' } } }] }],
+];
+
+export default function registerErrorCapSpecs(procedure: SaveProcedure) {
+  const refusal = (data: unknown) => refusalOf(procedure.call, input(data));
+
+  describe('the refusal of a save with many errors', () => {
+    it('lists exactly 20 issues with no summary', async () => {
+      const { code, issues } = await refusal({ embeds: [{ fields: repeat(20, badName) }] });
+
+      expect(code).toBe('BAD_REQUEST');
+      expect(issues).toEqual(Array.from({ length: 20 }, (_, i) => fieldIssue(0, i, 'name')));
+    });
+
+    it('lists the first 20 issues in order and one summary at 21 issues', async () => {
+      const { code, issues } = await refusal({ embeds: [{ fields: repeat(21, badName) }] });
+
+      expect(code).toBe('BAD_REQUEST');
+      expect(issues).toEqual([
+        ...Array.from({ length: 20 }, (_, i) => fieldIssue(0, i, 'name')),
+        { code: 'custom', path: [], message: SUMMARY },
+      ]);
+    });
+
+    it('stops at 20 issues of 100 malformed mention ids and renders 21 lines', async () => {
+      const { issues } = await refusal({ allowed_mentions: { users: repeat(100, () => 'nope') } });
+
+      expect(issues).toHaveLength(21);
+      expect(issues[20]).toEqual({ code: 'custom', path: [], message: SUMMARY });
+      expect(formatMutationError({ message: JSON.stringify(issues) })?.split('\n')).toHaveLength(21);
+    });
+
+    it('counts the one issue of an over-limit list toward the 20', async () => {
+      const exact = await refusal({ embeds: [{ fields: repeat(19, badName) }, { fields: repeat(26, () => ({ name: 'a', value: 'b' })) }] });
+      const over = await refusal({ embeds: [{ fields: repeat(20, badName) }, { fields: repeat(26, () => ({ name: 'a', value: 'b' })) }] });
+
+      expect(exact.issues).toEqual([
+        ...Array.from({ length: 19 }, (_, i) => fieldIssue(0, i, 'name')),
+        { code: 'too_big', path: [...DATA, 'embeds', 1, 'fields'], message: 'Array must contain at most 25 element(s)' },
+      ]);
+      expect(over.issues).toEqual([
+        ...Array.from({ length: 20 }, (_, i) => fieldIssue(0, i, 'name')),
+        { code: 'custom', path: [], message: SUMMARY },
+      ]);
+    });
+
+    it('counts the displayable-text issue, with its own message, toward the 20', async () => {
+      const long = { type: 10, content: 'x'.repeat(4000) };
+      const tooLong = () => ({ name: 'x'.repeat(257), value: 'b' });
+      const nameIssue = (index: number) => ({
+        code: 'too_big',
+        path: [...DATA, 'embeds', 0, 'fields', index, 'name'],
+        message: 'String must contain at most 256 character(s)',
+      });
+      const textIssue = {
+        code: 'too_big',
+        path: [...DATA, 'components'],
+        message: 'Components displayable text size exceeds maximum size of 4000',
+      };
+
+      const withNineteen = { embeds: [{ fields: repeat(19, tooLong) }], components: [long, long] };
+      const exact = await refusal(withNineteen);
+      const withTwenty = { embeds: [{ fields: repeat(20, tooLong) }], components: [long, long] };
+      const over = await refusal(withTwenty);
+
+      expect(exact.issues).toEqual([...Array.from({ length: 19 }, (_, i) => nameIssue(i)), textIssue]);
+      expect(over.issues).toEqual([
+        ...Array.from({ length: 20 }, (_, i) => nameIssue(i)),
+        { code: 'custom', path: [], message: SUMMARY },
+      ]);
+    });
+
+    it('stops reading the input after the 21st issue', async () => {
+      const counter = { reads: 0 };
+      const container = () => ({ type: 17, components: repeat(40, countingTexts(counter)) });
+
+      const { issues } = await refusal({ components: repeat(40, container) });
+
+      expect(issues).toHaveLength(21);
+      expect(counter.reads).toBeLessThan(200);
+    });
+
+    it('keeps two concurrent refusals apart', async () => {
+      const [first, second] = await Promise.all([
+        refusal({ embeds: [{ fields: repeat(15, badName) }] }),
