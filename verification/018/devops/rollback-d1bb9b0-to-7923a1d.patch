+  invalidIssue: { code: string, path: (string | number)[], message: string };
+}
+
+const BUTTON = { type: 2, style: 5, url: 'https://example.com' };
+const TEXT = { type: 10, content: 'x' };
+const ID = '100000000000000001';
+
+const buttons = (count: number) => Array.from({ length: count }, () => ({ ...BUTTON }));
+const texts = (count: number) => Array.from({ length: count }, () => ({ ...TEXT }));
+
+const maximum = (bound: number) => `Array must contain at most ${bound} element(s)`;
+
+const BASE_PATH = ['message', 'data'];
+
