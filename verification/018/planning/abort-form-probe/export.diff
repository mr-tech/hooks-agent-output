+/** A list refused on its length with one fatal issue, before any element is validated. */
+export function boundedArray<T extends z.ZodTypeAny>(element: T, max: number) {
+  return z.array(z.unknown()).superRefine((list, ctx) => {
+    if (list.length > max) {
+      ctx.addIssue({
+        code: z.ZodIssueCode.too_big,
+        maximum: max,
+        type: 'array',
+        inclusive: true,
+        exact: false,
+        message: `Array must contain at most ${max} element(s)`,
+        fatal: true,
+      });
+    }
+  }).pipe(z.array(element)) as unknown as
+    z.ZodType<z.output<z.ZodArray<T>>, z.ZodTypeDef, z.input<z.ZodArray<T>>>;
+}
