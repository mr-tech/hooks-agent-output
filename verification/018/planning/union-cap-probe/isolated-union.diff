> // PROBE: a plain union whose losing branches create no issue under the caller's error map.
> function isolatedUnion<T extends [z.ZodTypeAny, z.ZodTypeAny, ...z.ZodTypeAny[]]>(options: T): z.ZodUnion<T> {
>   const inner = z.union(options);
>   return z.any().transform((value, ctx) => {
>     const r = inner.safeParse(value);
>     if (r.success) return r.data as unknown;
>     const fatal = r.error.issues.some((i) => i.code === 'invalid_union' && i.path.length === 0);
>     for (const issue of r.error.issues) ctx.addIssue({ ...issue, fatal } as z.IssueData);
>     return z.NEVER;
>   }) as unknown as z.ZodUnion<T>;
> }
